      "names": {
        "en": "Knifelon",
        "fr": "Coutorible",
        "it": "Cloyster",
        "de": "Austos",
        "es": "Cloyster",
        "ko": "파르셀"
      },
      "descriptions": {
        "en": "Its arms made of ectoplasm allow Knifelon to propel itself headfirst at full speed towards its opponents.",
        "fr": "Ses bras faits d'ectoplasme permettent à Coutorible de se propulser la tête la première, à toute vitesse, sur ses adversaires.",
        "it": "Ha un guscio estremamente duro. Le parti danneggiate si ispessiscono fino a diventare dei grossi aculei affilati.",
        "de": "Seine Schale ist extrem hart. Schäden an der Schale schwellen zunächst an und entwickeln sich allmählich zu großen, scharfen Stacheln.",
        "es": "Su concha es increíblemente dura. Las heridas que recibe en la misma, al cicatrizar, generan enormes púas afiladas.",
        "ko": "매우 단단한 껍질을 갖고 있다. 껍질에 생긴 상처는 점점 부풀어서 크고 날카로운 가시로 자란다."
      },
      "abilities_data": [
        {
          "symbol": "moxie",
          "textId": 153,
          "names": {
            "en": "Moxie",
            "fr": "Impudence",
            "it": "Arroganza",
            "de": "Hochmut",
            "es": "Autoestima",
            "ko": "자기과신"
          },
          "descriptions": {
            "en": "The Pokémon shows moxie, and that boosts the Attack stat after knocking out any Pokémon.",
            "fr": "Quand le Pokémon met un ennemi K.O., sa confiance en lui ne connaît plus de limite et son Attaque augmente.",
            "it": "Quando manda un nemico KO, il Pokémon si fa sicuro di sé e aumenta il proprio Attacco.",
            "de": "Besiegt es ein Pokémon, steigt sein Selbstvertrauen und somit auch sein Angriff.",
            "es": "Al debilitar a un objetivo, su confianza se refuerza de tal manera que aumenta su Ataque.",
            "ko": "상대를 쓰러뜨리면 자신감이 붙어서 공격이 올라간다."
          }
        },
        {
          "symbol": "sharpness",
          "textId": 270,
          "names": {
            "en": "Sharpness",
            "fr": "Incisif",
            "it": "Sharpness",
            "de": "Sharpness",
            "es": "Sharpness",
            "ko": "Sharpness"
          },
          "descriptions": {
            "en": "Powers up slicing moves by 50%.",
            "fr": "Augmente la puissance des capacités tranchantes de 50%.",
            "it": "Powers up slicing moves.",
            "de": "Powers up slicing moves.",
            "es": "Powers up slicing moves.",
            "ko": "Powers up slicing moves."
          }
        },
        {
          "symbol": "defiant",
          "textId": 128,
          "names": {
            "en": "Defiant",
            "fr": "Acharné",
            "it": "Agonismo",
            "de": "Siegeswille",
            "es": "Competitivo",
            "ko": "오기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Attack stat sharply when its stats are lowered.",
            "fr": "Augmente beaucoup l’Attaque du Pokémon quand ses stats baissent.",
            "it": "L’Attacco aumenta di molto quando le statistiche diminuiscono a causa di un nemico.",
            "de": "Erhöht den Angriff stark, wenn ein Statuswert gesenkt wurde.",
            "es": "Sube mucho su Ataque cuando el rival le baja las características.",
            "ko": "능력이 떨어지면 공격이 크게 올라간다."
          }
        }
      ],
