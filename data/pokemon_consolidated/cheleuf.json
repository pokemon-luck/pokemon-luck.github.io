      "names": {
        "en": "Twigrub",
        "fr": "Chéleuf",
        "it": "Fearow",
        "de": "Ibitak",
        "es": "Fearow",
        "ko": "깨비드릴조"
      },
      "descriptions": {
        "en": "While picking nuts in the forest, walkers may accidentally stumble upon a Twigrub.",
        "fr": "Promenez-vous dans les bois, cueillez de petites noix. A moins que ça ne soit un Chéleuf narquois. ",
        "it": "Chi attraversa il suo territorio portando con sé del cibo corre il rischio di vederselo strappare via in men che non si dica.",
        "de": "Wer Essbares dabeihat, sollte sich nicht in Ibitaks Revier begeben, da sonst ein Überfall aus heiterem Himmel droht.",
        "es": "Es peligroso pasear con comida por su territorio, ya que supone exponerse a que en cualquier momento se abalance para robarla.",
        "ko": "깨비드릴조 영역에서 음식을 갖고 다니는 것은 위험하다. 순식간에 빼앗긴다."
      },
      "abilities_data": [
        {
          "symbol": "compound_eyes",
          "textId": 14,
          "names": {
            "en": "Compound Eyes",
            "fr": "Œil Composé",
            "it": "Insettocchi",
            "de": "Facettenauge",
            "es": "Ojo Compuesto",
            "ko": "복안"
          },
          "descriptions": {
            "en": "The Pokémon’s compound eyes boost its accuracy.",
            "fr": "Les yeux à facettes du Pokémon augmentent sa Précision.",
            "it": "La precisione del Pokémon aumenta grazie ai suoi occhi composti.",
            "de": "Erhöht die Genauigkeit von Attacken.",
            "es": "Aumenta la precisión de sus movimientos.",
            "ko": "복안을 가지고 있어 기술의 명중률이 올라간다."
          }
        },
        {
          "symbol": "shed_skin",
          "textId": 61,
          "names": {
            "en": "Shed Skin",
            "fr": "Mue",
            "it": "Muta",
            "de": "Expidermis",
            "es": "Mudar",
            "ko": "탈피"
          },
          "descriptions": {
            "en": "The Pokémon may heal its own status conditions by shedding its skin.",
            "fr": "Le Pokémon soigne parfois ses altérations de statut en muant.",
            "it": "Il Pokémon può guarire dai problemi di stato facendo la muta completa della pelle.",
            "de": "Das Pokémon befreit sich eventuell von Statusproblemen, indem es seine Haut abstreift.",
            "es": "Puede curar sus problemas de estado al mudar la piel.",
            "ko": "몸의 껍질을 벗어 던져 상태 이상을 회복할 때가 있다."
          }
        },
        {
          "symbol": "shadow_tag",
          "textId": 23,
          "names": {
            "en": "Shadow Tag",
            "fr": "Marque Ombre",
            "it": "Pedinombra",
            "de": "Wegsperre",
            "es": "Sombra Trampa",
            "ko": "그림자밟기"
          },
          "descriptions": {
            "en": "This Pokémon steps on the opposing Pokémon’s shadow to prevent it from escaping.",
            "fr": "Empêche les Pokémon ennemis de quitter le combat.",
            "it": "Il Pokémon calpesta l’ombra del nemico impedendogli la fuga o la sostituzione.",
            "de": "Hindert Gegner an der Flucht beziehungsweise am Auswechseln, indem es ihnen den Weg versperrt.",
            "es": "Impide que el enemigo huya o sea cambiado por otro.",
            "ko": "상대의 그림자를 밟아 도망치거나 교체할 수 없게 한다."
          }
        }
      ],
