      "names": {
        "en": "Celestoat",
        "fr": "Stélérmine",
        "it": "Gyarados",
        "de": "Garados",
        "es": "Gyarados",
        "ko": "갸라도스"
      },
      "descriptions": {
        "en": "Celestoat is the most popular Pokémon used as a model for creating plush toys for young children.",
        "fr": "Stélérmine est le pokémon le plus populaire en tant que modèle pour la création de peluches pour les jeunes enfants.",
        "it": "Incenerisce tutto ciò che lo circonda usando Iper Raggio. In alcune regioni ci si riferiva a lui con il nome di “dio della distruzione”.",
        "de": "Mit seinem Hyperstrahl legt es die Umgebung in Schutt und Asche. Manchmal wird es auch als „Gottheit der Zerstörung“ bezeichnet.",
        "es": "Allí donde alcanza su Hiperrayo la tierra queda carbonizada por completo. En algunas regiones lo consideran una deidad destructiva.",
        "ko": "파괴광선을 무자비하게 쏘아 주변 일대를 태워 버린다. 파괴의 신이라고 부르는 지방도 있다."
      },
      "abilities_data": [
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        },
        {
          "symbol": "pixilate",
          "textId": 182,
          "names": {
            "en": "Pixilate",
            "fr": "Peau Féérique",
            "it": "Pellefolletto",
            "de": "Feenschicht",
            "es": "Piel Feérica",
            "ko": "페어리스킨"
          },
          "descriptions": {
            "en": "Normal-type moves become Fairy-type moves. The power of those moves is boosted a little.",
            "fr": "Les capacités de type Normal deviennent de type Fée. Leur puissance augmente légèrement.",
            "it": "Le mosse di tipo Normale diventano di tipo Folletto e la loro potenza aumenta un po’.",
            "de": "Attacken vom Typ Normal nehmen den Typ Fee an und ihre Stärke erhöht sich ein wenig.",
            "es": "Convierte los movimientos de tipo Normal en tipo Hada y aumenta ligeramente su potencia.",
            "ko": "노말타입의 기술이 페어리타입이 된다. 위력이 조금 올라간다."
          }
        },
        {
          "symbol": "wonder_guard",
          "textId": 25,
          "names": {
            "en": "Wonder Guard",
            "fr": "Garde Mystik",
            "it": "Magidifesa",
            "de": "Wunderwache",
            "es": "Superguarda",
            "ko": "불가사의부적"
          },
          "descriptions": {
            "en": "Its mysterious power only lets supereffective moves hit the Pokémon.",
            "fr": "Une puissance mystérieuse protège le Pokémon contre toutes les capacités, sauf celles « super efficaces ».",
            "it": "Un potere misterioso protegge il Pokémon e lo rende vulnerabile solo alle mosse superefficaci.",
            "de": "Wundersame Kräfte bewirken, dass nur sehr effektive Treffer bei ihm Schaden anrichten.",
            "es": "Gracias a un poder misterioso, solo le hacen daño los movimientos supereficaces.",
            "ko": "효과가 굉장한 기술만 맞는 불가사의한 힘."
          }
        }
      ],
