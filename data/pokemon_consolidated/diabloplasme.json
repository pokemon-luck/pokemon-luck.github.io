      "names": {
        "en": "Crypterror",
        "fr": "Diabloplasme",
        "it": "Dratini",
        "de": "Dratini",
        "es": "Dratini",
        "ko": "미뇽"
      },
      "descriptions": {
        "en": "Crypterror is the personification of Impoly's dark thoughts.",
        "fr": "Diabloplasme est la personnification des idées noires de Lutinstable.",
        "it": "Poiché è ancora debole, vive nascosto sui fondali. Si ciba di tutto quello che cade in acqua.",
        "de": "Dratini ist noch schwach und lebt daher ruhig und verborgen in tiefen Gewässern. Es ernährt sich von allem, was über ihm versinkt.",
        "es": "Mientras todavía es débil, lleva una vida discreta oculto en el lecho marino y se alimenta de lo que cae al agua.",
        "ko": "아직 약해서 물밑으로 몸을 숨기고 가라앉는 것을 먹으면서 얌전히 지낸다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "intimidate",
          "textId": 22,
          "names": {
            "en": "Intimidate",
            "fr": "Intimidation",
            "it": "Prepotenza",
            "de": "Bedroher",
            "es": "Intimidación",
            "ko": "위협"
          },
          "descriptions": {
            "en": "The Pokémon intimidates opposing Pokémon upon entering battle, lowering their Attack stat.",
            "fr": "Le Pokémon rugit lorsqu’il arrive au combat, ce qui intimide l’ennemi et baisse son Attaque.",
            "it": "Quando il Pokémon entra in campo, la sua prepotenza intimidisce i nemici, riducendone l’Attacco.",
            "de": "Senkt den Angriff der Gegner, indem es sie gleich zu Kampfantritt bedroht und einschüchtert.",
            "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
            "ko": "등장했을 때 위협해서 상대를 위축시켜 상대의 공격을 떨어뜨린다."
          }
        },
        {
          "symbol": "shadow_shield",
          "textId": 231,
          "names": {
            "en": "Shadow Shield",
            "fr": "Spectro-Bouclier",
            "it": "Spettroguardia",
            "de": "Phantomschutz",
            "es": "Guardia Espectro",
            "ko": "스펙터가드"
          },
          "descriptions": {
            "en": "Reduces the amount of damage the Pokémon takes while its HP is full.",
            "fr": "Le Pokémon reçoit moins de dégâts quand ses PV sont au maximum.",
            "it": "Se i PS sono al massimo, riduce il danno subito.",
            "de": "Verringert den erlittenen Schaden bei vollen KP.",
            "es": "Reduce el daño que sufre si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 받는 데미지가 줄어든다."
          }
        }
      ],
