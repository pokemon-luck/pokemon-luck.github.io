      "names": {
        "en": "Seedache",
        "fr": "Mimigraine",
        "it": "Ledyba",
        "de": "Ledyba",
        "es": "Ledyba",
        "ko": "레디바"
      },
      "descriptions": {
        "en": "Consuming a Seedache causes severe hallucinations to its predators.",
        "fr": "Consommer un Mimigraine cause de graves hallucinations à ses prédateurs.",
        "it": "Nel clima temperato di Alola, questo Pokémon estremamente sensibile al freddo è arzillo e pieno di vita.",
        "de": "Dieses Pokémon reagiert sehr empfindlich auf Kälte. Im warmen Klima Alolas strotzt es nur so vor Lebensfreude.",
        "es": "Este Pokémon no soporta el frío. En Alola, sin embargo, se encuentra en su elemento y se lo puede ver revoloteando vivaracho por doquier.",
        "ko": "추위에 매우 약한 포켓몬. 온난한 알로라에서는 매우 생기가 넘치는 모습을 볼 수 있다."
      },
      "abilities_data": [
        {
          "symbol": "regenerator",
          "textId": 144,
          "names": {
            "en": "Regenerator",
            "fr": "Régé-Force",
            "it": "Rigenergia",
            "de": "Belebekraft",
            "es": "Regeneración",
            "ko": "재생력"
          },
          "descriptions": {
            "en": "Restores a little HP when withdrawn from battle.",
            "fr": "Restaure un peu de PV si le Pokémon est retiré du combat.",
            "it": "Il Pokémon recupera un po’ di PS quando lascia il campo.",
            "de": "Wird das Pokémon ausgewechselt, regeneriert es eine kleine Menge an KP.",
            "es": "Recupera unos pocos PS al ser cambiado por otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 HP를 조금 회복한다."
          }
        },
        {
          "symbol": "natural_cure",
          "textId": 30,
          "names": {
            "en": "Natural Cure",
            "fr": "Médic Nature",
            "it": "Alternacura",
            "de": "Innere Kraft",
            "es": "Cura Natural",
            "ko": "자연회복"
          },
          "descriptions": {
            "en": "All status conditions heal when the Pokémon switches out.",
            "fr": "Le Pokémon soigne ses altérations de statut en quittant le combat.",
            "it": "Quando il Pokémon viene sostituito, guarisce dai problemi di stato.",
            "de": "Wird das Pokémon ausgewechselt, werden seine Statusprobleme geheilt.",
            "es": "Cura sus problemas de estado al cambiarse con otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 상태 이상이 회복된다."
          }
        },
        {
          "symbol": "magic_guard",
          "textId": 98,
          "names": {
            "en": "Magic Guard",
            "fr": "Garde Magik",
            "it": "Magicscudo",
            "de": "Magieschild",
            "es": "Muro Mágico",
            "ko": "매직가드"
          },
          "descriptions": {
            "en": "The Pokémon only takes damage from attacks.",
            "fr": "Seules les attaques peuvent blesser le Pokémon.",
            "it": "Il Pokémon subisce danni solo dagli attacchi.",
            "de": "Das Pokémon nimmt nur durch Offensiv-Attacken Schaden.",
            "es": "Solo recibe daño de ataques.",
            "ko": "공격 이외에는 데미지를 입지 않는다."
          }
        }
      ],
