      "names": {
        "en": "Intreedible",
        "fr": "Incroyarbre",
        "it": "Spinarak",
        "de": "Webarak",
        "es": "Spinarak",
        "ko": "페이검"
      },
      "descriptions": {
        "en": "Rumors claim that soaking leaves from Intreedible in herbal tea would create a love potion.",
        "fr": "Des rumeurs affirment que tremper des feuilles d'Incroyarbre dans une tisane créerait un philtre d'amour. ",
        "it": "Con il filo che secerne dalla bocca tesse una tela talmente resistente da sostenere il peso di una roccia di 10 kg.",
        "de": "Es spinnt ein äußerst robustes Netz aus seinen Fäden, das selbst unter dem Gewicht eines 10 kg schweren Steines nicht reißt.",
        "es": "Segrega un hilo de increíble resistencia con el que teje su tela, capaz de soportar el peso de una roca de 10 kg sin romperse.",
        "ko": "실을 내뿜어 만든 둥지는 제법 튼튼하다. 10kg의 바위를 올려도 끄떡없다."
      },
      "abilities_data": [
        {
          "symbol": "regenerator",
          "textId": 144,
          "names": {
            "en": "Regenerator",
            "fr": "Régé-Force",
            "it": "Rigenergia",
            "de": "Belebekraft",
            "es": "Regeneración",
            "ko": "재생력"
          },
          "descriptions": {
            "en": "Restores a little HP when withdrawn from battle.",
            "fr": "Restaure un peu de PV si le Pokémon est retiré du combat.",
            "it": "Il Pokémon recupera un po’ di PS quando lascia il campo.",
            "de": "Wird das Pokémon ausgewechselt, regeneriert es eine kleine Menge an KP.",
            "es": "Recupera unos pocos PS al ser cambiado por otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 HP를 조금 회복한다."
          }
        },
        {
          "symbol": "natural_cure",
          "textId": 30,
          "names": {
            "en": "Natural Cure",
            "fr": "Médic Nature",
            "it": "Alternacura",
            "de": "Innere Kraft",
            "es": "Cura Natural",
            "ko": "자연회복"
          },
          "descriptions": {
            "en": "All status conditions heal when the Pokémon switches out.",
            "fr": "Le Pokémon soigne ses altérations de statut en quittant le combat.",
            "it": "Quando il Pokémon viene sostituito, guarisce dai problemi di stato.",
            "de": "Wird das Pokémon ausgewechselt, werden seine Statusprobleme geheilt.",
            "es": "Cura sus problemas de estado al cambiarse con otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 상태 이상이 회복된다."
          }
        },
        {
          "symbol": "magic_guard",
          "textId": 98,
          "names": {
            "en": "Magic Guard",
            "fr": "Garde Magik",
            "it": "Magicscudo",
            "de": "Magieschild",
            "es": "Muro Mágico",
            "ko": "매직가드"
          },
          "descriptions": {
            "en": "The Pokémon only takes damage from attacks.",
            "fr": "Seules les attaques peuvent blesser le Pokémon.",
            "it": "Il Pokémon subisce danni solo dagli attacchi.",
            "de": "Das Pokémon nimmt nur durch Offensiv-Attacken Schaden.",
            "es": "Solo recibe daño de ataques.",
            "ko": "공격 이외에는 데미지를 입지 않는다."
          }
        }
      ],
