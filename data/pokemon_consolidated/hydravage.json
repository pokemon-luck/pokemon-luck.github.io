      "names": {
        "en": "Hydrench",
        "fr": "Hydravage",
        "it": "Granbull",
        "de": "Granbull",
        "es": "Granbull",
        "ko": "그랑블루"
      },
      "descriptions": {
        "en": "Hydrench primarily attacks ships used by trainers who dare to mistreat Stupeels.",
        "fr": "Hydravage attaque en priorité les navires utilisés par des dresseurs osant maltraiter les Angouilles.",
        "it": "Ha una mascella molto potente, ma non ama battersi, perciò non ha molte occasioni di dare prova della sua forza.",
        "de": "Sein Unterkiefer ist sehr stark. Da es jedoch den Kampf scheut, kommt es nur selten dazu, dies zu demonstrieren.",
        "es": "Su mandíbula posee una fuerza abrumadora, pero, como no le gusta pelear, rara vez tiene ocasión de demostrarlo.",
        "ko": "턱의 힘은 강력하지만 다툼을 좋아하지 않아 그다지 싸우는 걸 볼 기회가 많지 않다."
      },
      "abilities_data": [
        {
          "symbol": "torrent",
          "textId": 67,
          "names": {
            "en": "Torrent",
            "fr": "Torrent",
            "it": "Acquaiuto",
            "de": "Sturzbach",
            "es": "Torrente",
            "ko": "급류"
          },
          "descriptions": {
            "en": "Powers up Water-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Eau du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Acqua aumenta.",
            "de": "Erhöht die Stärke von Wasser-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Agua cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 물타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "abyssal_call",
          "textId": 302,
          "names": {
            "en": "Abyssal Call",
            "fr": "Appel Abyssal",
            "it": "Appel Abyssal",
            "de": "Appel Abyssal",
            "es": "Appel Abyssal",
            "ko": "Appel Abyssal"
          },
          "descriptions": {
            "en": "Special Attack increases by one stage after knocking out an opponent.",
            "fr": "L'attaque spéciale augmente d'un niveau après avoir mis KO un adversaire.",
            "it": "L'attaque spéciale augmente d'un niveau après avoir mis KO un adversaire.",
            "de": "L'attaque spéciale augmente d'un niveau après avoir mis KO un adversaire.",
            "es": "L'attaque spéciale augmente d'un niveau après avoir mis KO un adversaire.",
            "ko": "L'attaque spéciale augmente d'un niveau après avoir mis KO un adversaire."
          }
        }
      ],
