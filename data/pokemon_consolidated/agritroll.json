      "names": {
        "en": "Folkrops",
        "fr": "Agritroll",
        "it": "Omastar",
        "de": "Amoroso",
        "es": "Omastar",
        "ko": "암스타"
      },
      "descriptions": {
        "en": "Those who wander in the meadows may sometimes find paths of seeds scattered by joyful Folkrops.",
        "fr": "Qui se promène dans les prairies trouvera parfois des chemins de graines semées par des Agritroll gambadant joyeusement.",
        "it": "Si ritiene che questo antico Pokémon si sia estinto a causa della conchiglia troppo pesante. Sembra sia un lontano antenato di Octillery.",
        "de": "Diesem prähistorischen Pokémon wurde wohl das Gewicht seines Gehäuses zum Verhängnis. Es ist ein ferner Vorfahre von Octillery.",
        "es": "Un posible antepasado remoto de Octillery cuya extinción se cree debida a que su concha se hizo demasiado pesada.",
        "ko": "무거운 껍질 때문에 멸종했다고 추정되는 고대 포켓몬. 대포무노의 먼 선조인 듯하다."
      },
      "abilities_data": [
        {
          "symbol": "grassy_surge",
          "textId": 229,
          "names": {
            "en": "Grassy Surge",
            "fr": "Créa-Herbe",
            "it": "Erbogenesi",
            "de": "Gras-Erzeuger",
            "es": "Herbogénesis",
            "ko": "그래스메이커"
          },
          "descriptions": {
            "en": "Turns the ground into Grassy Terrain when the Pokémon enters a battle.",
            "fr": "Le Pokémon crée un Champ Herbu au moment où il entre au combat.",
            "it": "Quando il Pokémon entra in campo, lo trasforma in un Campo Erboso.",
            "de": "Erzeugt bei Kampfantritt ein Grasfeld.",
            "es": "Crea un campo de hierba al entrar en combate.",
            "ko": "등장했을 때 그래스필드를 사용한다."
          }
        },
        {
          "symbol": "chlorophyll",
          "textId": 34,
          "names": {
            "en": "Chlorophyll",
            "fr": "Chlorophylle",
            "it": "Clorofilla",
            "de": "Chlorophyll",
            "es": "Clorofila",
            "ko": "엽록소"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in harsh sunlight.",
            "fr": "Augmente la Vitesse du Pokémon s’il y a du soleil.",
            "it": "Se la luce del sole è intensa, la Velocità aumenta.",
            "de": "Erhöht bei Sonnenschein die Initiative.",
            "es": "Sube su Velocidad cuando hace sol.",
            "ko": "날씨가 맑을 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "effect_spore",
          "textId": 27,
          "names": {
            "en": "Effect Spore",
            "fr": "Pose Spore",
            "it": "Spargispora",
            "de": "Sporenwirt",
            "es": "Efecto Espora",
            "ko": "포자"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may inflict poison, sleep, or paralysis on its attacker.",
            "fr": "Peut paralyser, empoisonner ou endormir l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare avvelenamento, paralisi o sonno a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, kann das beim Gegner Paralyse, Vergiftung oder Schlaf auslösen.",
            "es": "Puede dormir, envenenar o paralizar al Pokémon con el que entre en contacto al recibir un ataque.",
            "ko": "공격으로 자신에게 접촉한 상대를 독이나 마비, 잠듦 상태로 만들 때가 있다."
          }
        }
      ],
