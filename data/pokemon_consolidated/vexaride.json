      "names": {
        "en": "Pharanubis",
        "fr": "Pharanubis",
        "it": "Girafarig",
        "de": "Girafarig",
        "es": "Girafarig",
        "ko": "키링키"
      },
      "descriptions": {
        "en": "Pharanubis is said to guard cursed desert tombs, punishing grave robbers by ensnaring them in quicksand.",
        "fr": "Pharanubis garderait les tombes maudites du désert, punissant les pilleurs en les emprisonnant dans des sables mouvants.",
        "it": "La testa posteriore di Girafarig contiene un cervello minuto, troppo piccolo per pensare. Tuttavia, questa testolina non dorme mai, così può rimanere di sorveglianza 24 ore su 24.",
        "de": "Der Kopf an Girafarigs Hinterteil verfügt nur über ein kleines Gehirn, mit dem es nicht denken kann. Dieses Gehirn benötigt jedoch keinen Schlaf und ist somit in der Lage, die Umgebung rund um die Uhr im Auge zu behalten.",
        "es": "La cabeza trasera de Girafarig tiene un cerebro muy pequeño para pensar, pero, como no le hace falta dormir, al menos puede hacer de centinela las 24 horas del día.",
        "ko": "꼬리의 뇌는 생각을 할 수 없을 정도로 작지만 자지 않아도 괜찮아서 24시간 주변을 계속 망보고 있다."
      },
      "abilities_data": [
        {
          "symbol": "intimidate",
          "textId": 22,
          "names": {
            "en": "Intimidate",
            "fr": "Intimidation",
            "it": "Prepotenza",
            "de": "Bedroher",
            "es": "Intimidación",
            "ko": "위협"
          },
          "descriptions": {
            "en": "The Pokémon intimidates opposing Pokémon upon entering battle, lowering their Attack stat.",
            "fr": "Le Pokémon rugit lorsqu’il arrive au combat, ce qui intimide l’ennemi et baisse son Attaque.",
            "it": "Quando il Pokémon entra in campo, la sua prepotenza intimidisce i nemici, riducendone l’Attacco.",
            "de": "Senkt den Angriff der Gegner, indem es sie gleich zu Kampfantritt bedroht und einschüchtert.",
            "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
            "ko": "등장했을 때 위협해서 상대를 위축시켜 상대의 공격을 떨어뜨린다."
          }
        },
        {
          "symbol": "sand_rush",
          "textId": 146,
          "names": {
            "en": "Sand Rush",
            "fr": "Baigne Sable",
            "it": "Remasabbia",
            "de": "Sandscharrer",
            "es": "Ímpetu Arena",
            "ko": "모래헤치기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in a sandstorm.",
            "fr": "Augmente la Vitesse lors des tempêtes de sable.",
            "it": "Se c’è una tempeste di sabbia, la Velocità aumenta.",
            "de": "Erhöht in Sandstürmen die Initiative.",
            "es": "Aumenta su Velocidad durante las tormentas de arena.",
            "ko": "날씨가 모래바람일 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "moxie",
          "textId": 153,
          "names": {
            "en": "Moxie",
            "fr": "Impudence",
            "it": "Arroganza",
            "de": "Hochmut",
            "es": "Autoestima",
            "ko": "자기과신"
          },
          "descriptions": {
            "en": "The Pokémon shows moxie, and that boosts the Attack stat after knocking out any Pokémon.",
            "fr": "Quand le Pokémon met un ennemi K.O., sa confiance en lui ne connaît plus de limite et son Attaque augmente.",
            "it": "Quando manda un nemico KO, il Pokémon si fa sicuro di sé e aumenta il proprio Attacco.",
            "de": "Besiegt es ein Pokémon, steigt sein Selbstvertrauen und somit auch sein Angriff.",
            "es": "Al debilitar a un objetivo, su confianza se refuerza de tal manera que aumenta su Ataque.",
            "ko": "상대를 쓰러뜨리면 자신감이 붙어서 공격이 올라간다."
          }
        }
      ],
