      "names": {
        "en": "Pengourmet",
        "fr": "Pingoûter",
        "it": "Wobbuffet",
        "de": "Woingenau",
        "es": "Wobbuffet",
        "ko": "마자용"
      },
      "descriptions": {
        "en": "Reproducing the taste of Pengourmet's ice cream is a sign of excellence for Laemu's ice cream makers.",
        "fr": "La saveur particulière de la glace de Pingoûter est si complexe que les plus grands glaciers cherchent encore à la reproduire.",
        "it": "Wobbuffet non fa altro che subire le azioni nemiche: non agisce mai per primo. Tuttavia, non sopporta di essere attaccato alla coda. In questo caso cerca di trascinare con sé il nemico usando Destinobbligato.",
        "de": "Woingenau tut nichts anderes als Angriffe auszuhalten. Von sich aus würde es nie angreifen. Eine Attacke auf seinen Schweif würde es allerdings niemals dulden. Wenn das passiert, setzt es Abgangsbund ein.",
        "es": "Wobbuffet no hace otra cosa que aguantar los golpes que recibe: nunca usa movimientos ofensivos. Pero, si le atacan a la cola, intentará llevarse con él al enemigo usando Mismo Destino.",
        "ko": "한결같이 참는 포켓몬이지만 꼬리를 공격당하는 것만은 참지 못한다. 상대를 길동무로 만들 기회를 살핀다."
      },
      "abilities_data": [
        {
          "symbol": "ice_body",
          "textId": 115,
          "names": {
            "en": "Ice Body",
            "fr": "Corps Gel",
            "it": "Corpogelo",
            "de": "Eishaut",
            "es": "Gélido",
            "ko": "아이스바디"
          },
          "descriptions": {
            "en": "The Pokémon gradually regains HP in a hailstorm.",
            "fr": "Régénère les PV du Pokémon lors des tempêtes de grêle.",
            "it": "Se grandina, il Pokémon recupera PS.",
            "de": "Regeneriert bei Hagel nach und nach KP.",
            "es": "Recupera PS de forma gradual cuando hay tormentas de granizo.",
            "ko": "날씨가 싸라기눈일 때 HP를 조금씩 회복한다."
          }
        },
        {
          "symbol": "own_tempo",
          "textId": 20,
          "names": {
            "en": "Own Tempo",
            "fr": "Tempo Perso",
            "it": "Mente Locale",
            "de": "Tempomacher",
            "es": "Ritmo Propio",
            "ko": "마이페이스"
          },
          "descriptions": {
            "en": "This Pokémon has its own tempo, and that prevents it from becoming confused.",
            "fr": "Le Pokémon vit sa vie à son propre rythme, ce qui l’immunise contre la confusion.",
            "it": "Il Pokémon affronta la vita al proprio ritmo e per questo non può essere confuso.",
            "de": "Das Pokémon lässt sich nicht aus der Ruhe bringen und verhindert so Verwirrung.",
            "es": "Como le gusta hacer las cosas a su manera, los rivales no logran confundirlo.",
            "ko": "마이페이스라서 혼란 상태가 되지 않는다."
          }
        },
        {
          "symbol": "good_taste",
          "textId": 300,
          "names": {
            "en": "Good Taste",
            "fr": "Bon Goût",
            "it": "Sherbet Drift",
            "de": "Sherbet Drift",
            "es": "Sherbet Drift",
            "ko": "Sherbet Drift"
          },
          "descriptions": {
            "en": "When doing ice-type damage to the opposing pokémon, it has a 30% chance of becoming infatuated regardless of gender.",
            "fr": "En infligeant des dégâts de type glace au pokémon adverse, celui-ci a 30% de chances de tomber amoureux, qu'il soit mâle ou femelle.",
            "it": "When using an Ice-type move, this Pokémon has a 20% chance to boost its Speed by 1 stage.",
            "de": "When using an Ice-type move, this Pokémon has a 20% chance to boost its Speed by 1 stage.",
            "es": "When using an Ice-type move, this Pokémon has a 20% chance to boost its Speed by 1 stage.",
            "ko": "When using an Ice-type move, this Pokémon has a 20% chance to boost its Speed by 1 stage."
          }
        }
