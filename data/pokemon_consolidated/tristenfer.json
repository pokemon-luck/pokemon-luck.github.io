      "names": {
        "en": "Weepyro",
        "fr": "Chagrinfernal",
        "it": "Geodude",
        "de": "Kleinstein",
        "es": "Geodude",
        "ko": "꼬마돌"
      },
      "descriptions": {
        "en": "With an opposite character to its alter ego Hadescorch, Weepyro is often gentle and protective towards its trainer.",
        "fr": "D'un caractère opposé à son alter-égo Flambémon, Chagrinfernal est souvent doux et protecteur envers son dresseur.",
        "it": "Col passare degli anni le asperità del suo corpo vengono levigate, rendendolo perfettamente rotondo, e il suo carattere si fa più tranquillo.",
        "de": "Mit dem Alter verliert es zunehmend seine Kantigkeit, bis es vollkommen rund und auch charakterlich immer ausgeglichener wird.",
        "es": "Con la edad, su temperamento se amansa y su cuerpo se va alisando hasta adquirir una forma completamente redonda.",
        "ko": "오래 산 꼬마돌은 모가 없이 동그랗다. 성격도 매우 차분하고 온화하다."
      },
      "abilities_data": [
        {
          "symbol": "damp",
          "textId": 6,
          "names": {
            "en": "Damp",
            "fr": "Moiteur",
            "it": "Umidità",
            "de": "Feuchtigkeit",
            "es": "Humedad",
            "ko": "습기"
          },
          "descriptions": {
            "en": "Prevents the use of explosive moves, such as Self-Destruct, by dampening its surroundings.",
            "fr": "Le Pokémon augmente l’humidité de l’air, ce qui empêche tous les Pokémon d’utiliser des capacités explosives telles que Destruction.",
            "it": "Aumenta l’umidità circostante, impedendo l’uso di Autodistruzione e di altre mosse esplosive.",
            "de": "Befeuchtet die Umgebung und verhindert so den Einsatz von Attacken wie Finale, die Explosionen auslösen.",
            "es": "Aumenta la humedad del entorno y evita que se puedan utilizar movimientos explosivos, tales como Autodestrucción.",
            "ko": "주변을 습하게 함으로써 자폭 등 폭발하는 기술을 아무도 못 쓰게 한다."
          }
        },
        {
          "symbol": "drizzle",
          "textId": 2,
          "names": {
            "en": "Drizzle",
            "fr": "Crachin",
            "it": "Piovischio",
            "de": "Niesel",
            "es": "Llovizna",
            "ko": "잔비"
          },
          "descriptions": {
            "en": "The Pokémon makes it rain when it enters a battle.",
            "fr": "Le Pokémon invoque la pluie quand il entre au combat.",
            "it": "Quando il Pokémon entra in campo, attira la pioggia.",
            "de": "Ruft bei Kampfantritt Regen herbei.",
            "es": "Hace que llueva al entrar en combate.",
            "ko": "등장했을 때 날씨를 비로 만든다."
          }
        },
        {
          "symbol": "sheer_force",
          "textId": 125,
          "names": {
            "en": "Sheer Force",
            "fr": "Sans Limite",
            "it": "Forzabruta",
            "de": "Rohe Gewalt",
            "es": "Potencia Bruta",
            "ko": "우격다짐"
          },
          "descriptions": {
            "en": "Removes additional effects to increase the power of moves when attacking.",
            "fr": "Les capacités ayant un effet additionnel le perdent, mais leur puissance augmente.",
            "it": "Aumenta la potenza delle mosse, ma ne annulla gli effetti aggiuntivi.",
            "de": "Erhöht die Stärke von Attacken, aber hebt dafür ihre Zusatzeffekte auf.",
            "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
            "ko": "기술의 추가 효과가 없어지지만 그만큼 높은 위력으로 기술을 사용할 수 있다."
          }
        }
      ],
