      "names": {
        "en": "Cryptodon",
        "fr": "Diablodon",
        "it": "Articuno",
        "de": "Arktos",
        "es": "Articuno",
        "ko": "프리져"
      },
      "descriptions": {
        "en": "The thick scales that appeared during its evolution make it feel invincible.",
        "fr": "Les épaisses écailles apparues lors de son évolution le font se sentir invincible.",
        "it": "Articuno è un Pokémon uccello leggendario, perfettamente a suo agio tra i ghiacci. Quando batte le ali, l’aria circostante diventa gelida. Per questo motivo, quando nevica, si dice che sia passato di lì.",
        "de": "Arktos ist ein sagenumwobenes Vogel-Pokémon, das Eis manipulieren kann. Das Schlagen seiner Flügel bringt die Luft zum Gefrieren. Man nimmt an, dass es zu schneien beginnt, wenn dieses Pokémon fliegt.",
        "es": "Articuno es un Pokémon pájaro legendario que puede controlar el hielo. El batir de sus alas congela el aire. Dicen que consigue hacer que nieve cuando vuela.",
        "ko": "얼음을 조종하는 전설의 새포켓몬이다. 날갯짓하면 공기가 차갑게 식기 때문에 프리져가 날면 눈이 온다고 전해진다."
      },
      "abilities_data": [
        {
          "symbol": "berserk",
          "textId": 201,
          "names": {
            "en": "Berserk",
            "fr": "Dracolère",
            "it": "Furore",
            "de": "Wutausbruch",
            "es": "Cólera",
            "ko": "발끈"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Sp. Atk stat when it takes a hit that causes its HP to become half or less.",
            "fr": "Augmente l’Attaque Spéciale du Pokémon lorsqu’il tombe à la moitié de ses PV à cause d’une attaque.",
            "it": "Se i PS scendono a metà o meno a causa di un attacco, l’Attacco Speciale aumenta.",
            "de": "Fallen seine KP nach einem Angriff auf die Hälfte des Maximalwerts oder weniger, steigt sein Spezial-Angriff.",
            "es": "Aumenta su Ataque Especial si sus PS se ven reducidos a la mitad debido a algún ataque.",
            "ko": "상대의 공격으로 HP가 절반이 되면 특수공격이 올라간다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "shed_skin",
          "textId": 61,
          "names": {
            "en": "Shed Skin",
            "fr": "Mue",
            "it": "Muta",
            "de": "Expidermis",
            "es": "Mudar",
            "ko": "탈피"
          },
          "descriptions": {
            "en": "The Pokémon may heal its own status conditions by shedding its skin.",
            "fr": "Le Pokémon soigne parfois ses altérations de statut en muant.",
            "it": "Il Pokémon può guarire dai problemi di stato facendo la muta completa della pelle.",
            "de": "Das Pokémon befreit sich eventuell von Statusproblemen, indem es seine Haut abstreift.",
            "es": "Puede curar sus problemas de estado al mudar la piel.",
            "ko": "몸의 껍질을 벗어 던져 상태 이상을 회복할 때가 있다."
          }
        }
      ],
