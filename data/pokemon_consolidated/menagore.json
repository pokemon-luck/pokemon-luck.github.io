      "names": {
        "en": "Meandragora",
        "fr": "Menagore",
        "it": "Dugtrio",
        "de": "Digdri",
        "es": "Dugtrio",
        "ko": "닥트리오"
      },
      "descriptions": {
        "en": "To ensure the survival of its species, Meandragora has adopted a very aggressive behavior towards other Pokémon.",
        "fr": "Pour assurer la survie de son espèce, Menagore a adopté un comportement très agressif envers les autres Pokémon.",
        "it": "In genere le tre teste vanno d’accordo, ma a volte può capitare che scoppi una lite furiosa per decidere quale mangerà per prima.",
        "de": "Digdri sind Drillinge und normalerweise ein Herz und eine Seele. Nur ganz selten streiten sie sich, welcher Kopf zuerst ans Futter darf.",
        "es": "Este trío se lleva de maravilla, aunque muy de vez en cuando se enzarzan en acaloradas disputas para decidir cuál come primero.",
        "ko": "언제나 사이좋은 세쌍둥이지만 극히 드물게 어느 머리가 먼저 먹이를 먹을까로 큰 싸움을 한다."
      },
      "abilities_data": [
        {
          "symbol": "shadow_shield",
          "textId": 231,
          "names": {
            "en": "Shadow Shield",
            "fr": "Spectro-Bouclier",
            "it": "Spettroguardia",
            "de": "Phantomschutz",
            "es": "Guardia Espectro",
            "ko": "스펙터가드"
          },
          "descriptions": {
            "en": "Reduces the amount of damage the Pokémon takes while its HP is full.",
            "fr": "Le Pokémon reçoit moins de dégâts quand ses PV sont au maximum.",
            "it": "Se i PS sono al massimo, riduce il danno subito.",
            "de": "Verringert den erlittenen Schaden bei vollen KP.",
            "es": "Reduce el daño que sufre si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 받는 데미지가 줄어든다."
          }
        },
        {
          "symbol": "natural_cure",
          "textId": 30,
          "names": {
            "en": "Natural Cure",
            "fr": "Médic Nature",
            "it": "Alternacura",
            "de": "Innere Kraft",
            "es": "Cura Natural",
            "ko": "자연회복"
          },
          "descriptions": {
            "en": "All status conditions heal when the Pokémon switches out.",
            "fr": "Le Pokémon soigne ses altérations de statut en quittant le combat.",
            "it": "Quando il Pokémon viene sostituito, guarisce dai problemi di stato.",
            "de": "Wird das Pokémon ausgewechselt, werden seine Statusprobleme geheilt.",
            "es": "Cura sus problemas de estado al cambiarse con otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 상태 이상이 회복된다."
          }
        },
        {
          "symbol": "effect_spore",
          "textId": 27,
          "names": {
            "en": "Effect Spore",
            "fr": "Pose Spore",
            "it": "Spargispora",
            "de": "Sporenwirt",
            "es": "Efecto Espora",
            "ko": "포자"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may inflict poison, sleep, or paralysis on its attacker.",
            "fr": "Peut paralyser, empoisonner ou endormir l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare avvelenamento, paralisi o sonno a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, kann das beim Gegner Paralyse, Vergiftung oder Schlaf auslösen.",
            "es": "Puede dormir, envenenar o paralizar al Pokémon con el que entre en contacto al recibir un ataque.",
            "ko": "공격으로 자신에게 접촉한 상대를 독이나 마비, 잠듦 상태로 만들 때가 있다."
          }
        }
      ],
