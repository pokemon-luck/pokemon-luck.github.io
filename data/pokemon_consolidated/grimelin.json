      "names": {
        "en": "Gobelike",
        "fr": "Grimelin",
        "it": "Eevee",
        "de": "Evoli",
        "es": "Eevee",
        "ko": "이브이"
      },
      "descriptions": {
        "en": "If it is so deformed, it may be because its evolution is still uncertain.",
        "fr": "S'il est si difforme c'est peut-être que son évolution est encore incertaine.",
        "it": "Non si conosce ancora il motivo per cui Eevee sia l’unico Pokémon a possedere un corredo genetico così instabile.",
        "de": "Evoli ist das einzige Pokémon mit einem höchst instabilen Erbmaterial. Die Ursache dafür ist nach wie vor unklar.",
        "es": "Todavía no se ha esclarecido el motivo por el que es el único Pokémon que presenta un código genético inestable.",
        "ko": "이브이만 매우 불안정한 유전자를 갖고 있는 이유는 아직 해명되지 않았다."
      },
      "abilities_data": [
        {
          "symbol": "rattled",
          "textId": 155,
          "names": {
            "en": "Rattled",
            "fr": "Phobique",
            "it": "Paura",
            "de": "Hasenfuß",
            "es": "Cobardía",
            "ko": "주눅"
          },
          "descriptions": {
            "en": "Dark-, Ghost-, and Bug-type moves scare the Pokémon and boost its Speed stat.",
            "fr": "Si le Pokémon est touché par une capacité de type Ténèbres, Spectre ou Insecte, sa phobie se révèle et sa Vitesse augmente.",
            "it": "Le mosse di tipo Buio, Spettro e Coleottero spaventano il Pokémon aumentandone la Velocità.",
            "de": "Wird es von einer Unlicht-, Geister- oder Käfer-Attacke getroffen, bekommt es Angst und seine Initiative steigt.",
            "es": "Si le alcanza un movimiento de tipo Siniestro, Bicho o Fantasma, el miedo hace que le suba la Velocidad.",
            "ko": "악타입과 고스트타입과 벌레타입의 기술을 받으면 주눅이 들어 스피드가 올라간다."
          }
        },
        {
          "symbol": "run_away",
          "textId": 50,
          "names": {
            "en": "Run Away",
            "fr": "Fuite",
            "it": "Fugafacile",
            "de": "Angsthase",
            "es": "Fuga",
            "ko": "도주"
          },
          "descriptions": {
            "en": "Enables a sure getaway from wild Pokémon.",
            "fr": "Permet de fuir n’importe quel Pokémon sauvage.",
            "it": "Garantisce la fuga dai Pokémon selvatici.",
            "de": "Die Flucht vor wilden Pokémon gelingt immer.",
            "es": "Puede escaparse de todos los Pokémon salvajes.",
            "ko": "야생 포켓몬으로부터 반드시 도망칠 수 있다."
          }
        },
        {
          "symbol": "insomnia",
          "textId": 15,
          "names": {
            "en": "Insomnia",
            "fr": "Insomnia",
            "it": "Insonnia",
            "de": "Insomnia",
            "es": "Insomnio",
            "ko": "불면"
          },
          "descriptions": {
            "en": "The Pokémon is suffering from insomnia and cannot fall asleep.",
            "fr": "Le Pokémon est incapable de dormir.",
            "it": "Il Pokémon soffre d’insonnia e non può addormentarsi.",
            "de": "Verhindert Einschlafen.",
            "es": "Su resistencia al sueño le impide quedarse dormido.",
            "ko": "잠들지 못하는 체질이라 잠듦 상태가 되지 않는다."
          }
        }
      ],
