      "names": {
        "en": "Soilsquatch",
        "fr": "Simiastoc",
        "it": "Primeape",
        "de": "Rasaff",
        "es": "Primeape",
        "ko": "성원숭"
      },
      "descriptions": {
        "en": "Despite its intimidating physique, this solitary Pokémon prefers to spend its time napping, secluded in its cave.",
        "fr": "Malgré son physique intimidant, ce pokémon solitaire préfère passer son temps à faire la sieste, reclus dans sa caverne.",
        "it": "Insegue chi lo fa arrabbiare senza dargli tregua e non lo perdona neanche dopo averlo ridotto all’immobilità a furia di percosse.",
        "de": "Wer es nervt, wird auf ewig verfolgt. Selbst nachdem es seinen Gegner zu Boden gebracht hat, kann es ihm noch nicht verzeihen.",
        "es": "Si se enfada, perseguirá sin descanso al objeto de su enojo. Aun habiéndolo golpeado hasta la extenuación, seguirá guardándole rencor.",
        "ko": "화나게 한 상대를 용서하지 않고 계속 쫓아다닌다. 때려눕혀 움직일 수 없게 돼도 용서하지 않는다."
      },
      "abilities_data": [
        {
          "symbol": "overcoat",
          "textId": 142,
          "names": {
            "en": "Overcoat",
            "fr": "Envelocape",
            "it": "Copricapo",
            "de": "Partikelschutz",
            "es": "Funda",
            "ko": "방진"
          },
          "descriptions": {
            "en": "Protects the Pokémon from things like sand, hail, and powder.",
            "fr": "Protège des dégâts occasionnés par les tempêtes de sable ou la grêle, et neutralise les attaques à base de poudre.",
            "it": "Rende immuni ai danni da grandine e tempesta di sabbia, alle mosse Spora, Cottonspora, Sonnifero, Paralizzante e alle mosse “polvere”.",
            "de": "Nimmt weder durch Wetterlagen wie Sandsturm oder Hagel noch durch Pulver oder Puder Schaden.",
            "es": "No le afectan las tormentas de arena, el granizo y los movimientos con polvos.",
            "ko": "모래바람이나 싸라기눈 등의 데미지를 입지 않는다. 가루의 기술을 받지 않는다."
          }
        },
        {
          "symbol": "stamina",
          "textId": 192,
          "names": {
            "en": "Stamina",
            "fr": "Endurance",
            "it": "Sopportazione",
            "de": "Zähigkeit",
            "es": "Firmeza",
            "ko": "지구력"
          },
          "descriptions": {
            "en": "Boosts the Defense stat when hit by an attack.",
            "fr": "Augmente la Défense du Pokémon lorsqu’il subit une attaque.",
            "it": "Se il Pokémon subisce un attacco, la sua Difesa aumenta.",
            "de": "Wird es von einer Attacke getroffen, steigt seine Verteidigung.",
            "es": "Aumenta su Defensa al recibir un ataque.",
            "ko": "공격을 받으면 방어가 올라간다."
          }
        },
        {
          "symbol": "thick_fat",
          "textId": 47,
          "names": {
            "en": "Thick Fat",
            "fr": "Isograisse",
            "it": "Grassospesso",
            "de": "Speckschicht",
            "es": "Sebo",
            "ko": "두꺼운지방"
          },
          "descriptions": {
            "en": "The Pokémon is protected by a layer of thick fat, which halves the damage taken from Fire- and Ice-type moves.",
            "fr": "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu’il subit des capacités de types Feu et Glace.",
            "it": "Il Pokémon è protetto da uno spesso strato di grasso che dimezza il danno causato da mosse di tipo Fuoco e Ghiaccio.",
            "de": "Das Pokémon wird von einer dicken Fettschicht geschützt, was den durch Feuer- und Eis-Attacken erlittenen Schaden halbiert.",
            "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
            "ko": "두꺼운 지방으로 보호되고 있어 불꽃타입과 얼음타입의 기술의 데미지를 반감시킨다."
          }
        }
      ],
