      "names": {
        "en": "Noxaurian",
        "fr": "Toxiguane",
        "it": "Swinub",
        "de": "Quiekel",
        "es": "Swinub",
        "ko": "꾸꾸리"
      },
      "descriptions": {
        "en": "To protect itself from dryness, Noxaurian's skin continuously secretes a powerful toxin.",
        "fr": "Pour le protéger de la sécheresse, la peau de Toxiguane sécrète en continue une toxine redoutable.",
        "it": "Swinub cerca il proprio nutrimento strofinando il muso sul terreno. È ghiotto dei funghi che crescono sotto la coltre di erba e fogliame rinsecchito. Talvolta scova qualche sorgente termale.",
        "de": "Auf Nahrungssuche schnüffelt Quiekel am Boden entlang. Seine Lieblingsspeise ist ein Pilz, der unter abgestorbenem Gras wächst. Manchmal spürt dieses Pokémon heiße Quellen auf.",
        "es": "Swinub busca el alimento frotando el hocico contra el suelo. Su comida preferida es una seta que crece bajo la hierba marchita. A veces, al frotar, descubre fuentes termales.",
        "ko": "땅에 코를 비비며 먹이를 찾는다. 마른 풀 밑에 난 버섯을 좋아한다. 가끔 온천을 파내기도 한다."
      },
      "abilities_data": [
        {
          "symbol": "shed_skin",
          "textId": 61,
          "names": {
            "en": "Shed Skin",
            "fr": "Mue",
            "it": "Muta",
            "de": "Expidermis",
            "es": "Mudar",
            "ko": "탈피"
          },
          "descriptions": {
            "en": "The Pokémon may heal its own status conditions by shedding its skin.",
            "fr": "Le Pokémon soigne parfois ses altérations de statut en muant.",
            "it": "Il Pokémon può guarire dai problemi di stato facendo la muta completa della pelle.",
            "de": "Das Pokémon befreit sich eventuell von Statusproblemen, indem es seine Haut abstreift.",
            "es": "Puede curar sus problemas de estado al mudar la piel.",
            "ko": "몸의 껍질을 벗어 던져 상태 이상을 회복할 때가 있다."
          }
        },
        {
          "symbol": "poison_point",
          "textId": 38,
          "names": {
            "en": "Poison Point",
            "fr": "Point Poison",
            "it": "Velenopunto",
            "de": "Giftdorn",
            "es": "Punto Tóxico",
            "ko": "독가시"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may poison the attacker.",
            "fr": "Peut empoisonner l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può avvelenare chi manda a segno un attacco diretto.",
            "de": "Vergiftet den Angreifer bei Berührung eventuell.",
            "es": "Puede envenenar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 독 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "dry_skin",
          "textId": 87,
          "names": {
            "en": "Dry Skin",
            "fr": "Peau Sèche",
            "it": "Pellearsa",
            "de": "Trockenheit",
            "es": "Piel Seca",
            "ko": "건조피부"
          },
          "descriptions": {
            "en": "Restores HP in rain or when hit by Water-type moves. Reduces HP in harsh sunlight, and increases the damage received from Fire-type moves.",
            "fr": "Le Pokémon perd des PV quand le soleil brille, mais il en regagne lorsqu’il pleut ou s’il est touché par une capacité Eau. Il subit aussi plus de dégâts de Feu.",
            "it": "Il Pokémon recupera PS se piove o se subisce mosse di tipo Acqua, ma perde PS con la luce solare intensa. Subisce più danni da mosse di tipo Fuoco.",
            "de": "Bei Sonnenschein verliert das Pokémon KP und der Schaden durch Feuer-Attacken steigt. Bei Regen und Treffern durch Wasser-Attacken regeneriert es KP.",
            "es": "Pierde PS si hace sol y los recupera si llueve o recibe un movimiento de tipo Agua. Los movimientos de tipo Fuego, por su parte, le hacen más daño de lo normal.",
            "ko": "비가 오는 날씨나 물타입의 기술로 HP가 회복되고 맑을 때나 불꽃타입의 기술로는 줄어든다."
          }
        }
      ],
