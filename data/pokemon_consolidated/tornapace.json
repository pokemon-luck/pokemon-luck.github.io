      "names": {
        "en": "Raptem",
        "fr": "Rapatonair",
        "it": "Abra",
        "de": "Abra",
        "es": "Abra",
        "ko": "캐이시"
      },
      "descriptions": {
        "en": "Before knowing its evolution, scientists wondered why Raptem remains still with its wings lifted to the sky during storms.",
        "fr": "Avant de connaitre son évolution, les scientifiques se demandaient pourquoi Rapatonair s'immobilise en levant les ailes au ciel pendant les orages.",
        "it": "Può usare i suoi poteri psichici anche mentre dorme. Per questo è difficile capire se è sveglio oppure no.",
        "de": "Da es seine Psycho-Kräfte selbst im Schlaf einsetzt, weiß man meistens nicht, ob es gerade wach ist oder schläft.",
        "es": "Es capaz de usar sus poderes psíquicos aun estando dormido, por lo que es difícil distinguir entre sus estados de sueño y vigilia.",
        "ko": "자는 동안에도 다양한 초능력을 사용하기 때문에 깨어 있는 것이 아닌지 헷갈린다."
      },
      "abilities_data": [
        {
          "symbol": "lightning_rod",
          "textId": 31,
          "names": {
            "en": "Lightning Rod",
            "fr": "Paratonnerre",
            "it": "Parafulmine",
            "de": "Blitzfänger",
            "es": "Pararrayos",
            "ko": "피뢰침"
          },
          "descriptions": {
            "en": "The Pokémon draws in all Electric-type moves. Instead of being hit by Electric-type moves, it boosts its Sp. Atk.",
            "fr": "Le Pokémon détourne sur lui les capacités de type Électrik et les neutralise, tout en montant son Attaque Spéciale.",
            "it": "Il Pokémon attira e neutralizza le mosse di tipo Elettro e fa aumentare il suo Attacco Speciale.",
            "de": "Zieht Elektro-Attacken an. Statt durch diese Schaden zu nehmen, erhöht es den eigenen Spezial-Angriff.",
            "es": "Atrae y neutraliza los movimientos de tipo Eléctrico, que además le suben el Ataque Especial.",
            "ko": "전기타입의 기술을 자신에게 끌어모아 데미지를 받지 않고 특수공격을 올린다."
          }
        },
        {
          "symbol": "static",
          "textId": 9,
          "names": {
            "en": "Static",
            "fr": "Statik",
            "it": "Statico",
            "de": "Statik",
            "es": "Elec. Estática",
            "ko": "정전기"
          },
          "descriptions": {
            "en": "The Pokémon is charged with static electricity, so contact with it may cause paralysis.",
            "fr": "Le Pokémon charge son corps en électricité statique, et tout contact avec lui peut paralyser.",
            "it": "Il contatto fisico con il corpo percorso dall’elettricità statica del Pokémon può causare paralisi.",
            "de": "Kann bei Berührung durch statisch aufgeladenen Körper paralysieren.",
            "es": "La electricidad estática que lo envuelve puede paralizar al mínimo contacto.",
            "ko": "정전기를 몸에 둘러 접촉한 상대를 마비시킬 때가 있다."
          }
        },
        {
          "symbol": "air_lock",
          "textId": 76,
          "names": {
            "en": "Air Lock",
            "fr": "Air Lock",
            "it": "Riparo",
            "de": "Klimaschutz",
            "es": "Bucle Aire",
            "ko": "에어록"
          },
          "descriptions": {
            "en": "Eliminates the effects of weather.",
            "fr": "Annule tous les effets de la météo.",
            "it": "Neutralizza gli effetti di tutte le condizioni atmosferiche.",
            "de": "Hebt alle Wetter-Effekte auf.",
            "es": "Neutraliza todos los efectos del tiempo atmosférico.",
            "ko": "모든 날씨의 영향이 없어진다."
          }
        }
      ],
