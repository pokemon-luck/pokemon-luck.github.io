      "names": {
        "en": "Folkobold",
        "fr": "Ancestroll",
        "it": "Kabutops",
        "de": "Kabutops",
        "es": "Kabutops",
        "ko": "투구푸스"
      },
      "descriptions": {
        "en": "Coming from another time, this Pokémon prefers to be captured in ancient Poké Balls made from apricorns.",
        "fr": "Venu d'un autre temps, ce pokémon préfère être capturé dans les pokéball anciennes fabriquées à base de noigrumes.",
        "it": "Questo Pokémon stava cominciando ad adattarsi alla vita sulla terraferma, ma si è estinto prima della conclusione del processo.",
        "de": "Dieses Pokémon hatte begonnen, sich an das Leben an Land anzupassen, starb aber aus, bevor es den Wandel vollziehen konnte.",
        "es": "Empezó a desarrollar rasgos de adaptación a la vida en tierra firme, pero fue demasiado tarde para evitar la extinción de la especie.",
        "ko": "육지에서도 활동할 수 있도록 신체가 변화하기 시작했지만 때가 늦어서 멸종해 버렸다."
      },
      "abilities_data": [
        {
          "symbol": "pixilate",
          "textId": 182,
          "names": {
            "en": "Pixilate",
            "fr": "Peau Féérique",
            "it": "Pellefolletto",
            "de": "Feenschicht",
            "es": "Piel Feérica",
            "ko": "페어리스킨"
          },
          "descriptions": {
            "en": "Normal-type moves become Fairy-type moves. The power of those moves is boosted a little.",
            "fr": "Les capacités de type Normal deviennent de type Fée. Leur puissance augmente légèrement.",
            "it": "Le mosse di tipo Normale diventano di tipo Folletto e la loro potenza aumenta un po’.",
            "de": "Attacken vom Typ Normal nehmen den Typ Fee an und ihre Stärke erhöht sich ein wenig.",
            "es": "Convierte los movimientos de tipo Normal en tipo Hada y aumenta ligeramente su potencia.",
            "ko": "노말타입의 기술이 페어리타입이 된다. 위력이 조금 올라간다."
          }
        },
        {
          "symbol": "magic_bounce",
          "textId": 156,
          "names": {
            "en": "Magic Bounce",
            "fr": "Miroir Magik",
            "it": "Magispecchio",
            "de": "Magiespiegel",
            "es": "Espejo Mágico",
            "ko": "매직미러"
          },
          "descriptions": {
            "en": "Reflects status moves instead of getting hit by them.",
            "fr": "Annule les effets des capacités de statut subies par le Pokémon et les retourne à l’envoyeur.",
            "it": "Il Pokémon respinge al mittente le mosse di stato senza subirne gli effetti.",
            "de": "Lenkt Status-Attacken auf den Angreifer um, ohne selbst von ihnen getroffen zu werden.",
            "es": "Puede devolver los movimientos de estado lanzados por el rival, sin verse afectado por ellos.",
            "ko": "상대가 쓴 변화 기술을 받지 않고 그대로 되받아칠 수 있다."
          }
        },
        {
          "symbol": "cute_charm",
          "textId": 56,
          "names": {
            "en": "Cute Charm",
            "fr": "Joli Sourire",
            "it": "Incantevole",
            "de": "Charmebolzen",
            "es": "Gran Encanto",
            "ko": "헤롱헤롱바디"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may cause infatuation.",
            "fr": "Peut séduire l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare infatuazione a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, verliebt sich der Gegner eventuell in es.",
            "es": "Puede causar enamoramiento al rival que lo toque.",
            "ko": "자신과 접촉한 상대를 헤롱헤롱 상태로 만들 때가 있다."
          }
        }
      ],
