      "names": {
        "en": "Folkurrent",
        "fr": "Nuclétroll",
        "it": "Jolteon",
        "de": "Blitza",
        "es": "Jolteon",
        "ko": "쥬피썬더"
      },
      "descriptions": {
        "en": "To avoid overloading with energy, Folkurrent releases it into the clouds, causing thunderstorms.",
        "fr": "Pour ne pas se surcharger en énergie, Nuclétroll en libère dans les nuages, provoquant des orages.",
        "it": "I suoi polmoni contengono un organo che produce elettricità. Quando respira, si può udire un crepitio.",
        "de": "Blitza verfügt über ein Organ in der Lunge, das Elektrizität erzeugt. Wenn dieses Pokémon ausatmet, hört man ein elektrisches Knistern.",
        "es": "Posee un órgano en los pulmones que genera electricidad. Cuando respira se puede oír un crepitar eléctrico.",
        "ko": "폐 안에 전기를 만드는 기관이 있다. 날숨에 섞여 탁탁하는 전기 소리가 들린다."
      },
      "abilities_data": [
        {
          "symbol": "quick_feet",
          "textId": 95,
          "names": {
            "en": "Quick Feet",
            "fr": "Pied Véloce",
            "it": "Piedisvelti",
