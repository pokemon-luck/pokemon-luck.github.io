      "names": {
        "en": "Smallder",
        "fr": "Cramin",
        "it": "Squirtle",
        "de": "Schiggy",
        "es": "Squirtle",
        "ko": "꼬부기"
      },
      "descriptions": {
        "en": "Overflowing with energy, his loyalty is questioned only by his ardour.",
        "fr": "Débordant d'énergie, sa fidélité n'est remise en question que par sa fougue.",
        "it": "La corazza di Squirtle non serve soltanto da protezione. La particolare forma arrotondata e le scanalature superficiali lo aiutano a minimizzare l’attrito dell’acqua per nuotare ad alta velocità.",
        "de": "Schiggys Panzer dient nicht nur zum Schutz. Die runde Form und die Furchen auf der Oberfläche verringern den Widerstand im Wasser, sodass dieses Pokémon sehr schnell schwimmen kann.",
        "es": "El caparazón de Squirtle no le sirve de protección únicamente. Su forma redondeada y las hendiduras que tiene le ayudan a deslizarse en el agua y le permiten nadar a gran velocidad.",
        "ko": "등껍질의 역할은 몸을 지키는 것뿐만이 아니다. 둥그런 모양과 표면의 홈이 물의 저항을 줄여서 빠르게 헤엄칠 수 있다."
      },
      "abilities_data": [
        {
          "symbol": "intimidate",
          "textId": 22,
          "names": {
            "en": "Intimidate",
            "fr": "Intimidation",
            "it": "Prepotenza",
            "de": "Bedroher",
            "es": "Intimidación",
            "ko": "위협"
          },
          "descriptions": {
            "en": "The Pokémon intimidates opposing Pokémon upon entering battle, lowering their Attack stat.",
            "fr": "Le Pokémon rugit lorsqu’il arrive au combat, ce qui intimide l’ennemi et baisse son Attaque.",
            "it": "Quando il Pokémon entra in campo, la sua prepotenza intimidisce i nemici, riducendone l’Attacco.",
            "de": "Senkt den Angriff der Gegner, indem es sie gleich zu Kampfantritt bedroht und einschüchtert.",
            "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
            "ko": "등장했을 때 위협해서 상대를 위축시켜 상대의 공격을 떨어뜨린다."
          }
        },
        {
          "symbol": "hustle",
          "textId": 55,
          "names": {
            "en": "Hustle",
            "fr": "Agitation",
            "it": "Tuttafretta",
            "de": "Übereifer",
            "es": "Entusiasmo",
            "ko": "의욕"
          },
          "descriptions": {
            "en": "Boosts the Attack stat, but lowers accuracy.",
            "fr": "Améliore l’Attaque du Pokémon, mais diminue la Précision.",
            "it": "L’Attacco aumenta, ma la precisione diminuisce.",
            "de": "Erhöht den Angriffs-Wert, aber senkt die Genauigkeit.",
            "es": "Aumenta su Ataque, pero reduce su Precisión.",
            "ko": "자신의 공격이 높아지지만 명중률이 떨어진다."
          }
        },
        {
          "symbol": "hellfire_fury",
          "textId": 297,
          "names": {
            "en": "Hellfire Fury",
            "fr": "Furie d'Enfer",
            "it": "Furie d'Enfer",
            "de": "Furie d'Enfer",
            "es": "Furie d'Enfer",
            "ko": "Furie d'Enfer"
          },
          "descriptions": {
            "en": "Whenever the user lands a critical hit, attack and special attack are boosted by 1 stage.",
            "fr": "Chaque fois que l'utilisateur réussit un coup critique, augmente l'attaque et attaque spéciale de 1 niveau.",
            "it": "Chaque fois que l'utilisateur réussit un coup critique, toutes ses statistiques sont augmentées de 1 niveau.",
            "de": "Chaque fois que l'utilisateur réussit un coup critique, toutes ses statistiques sont augmentées de 1 niveau.",
            "es": "Chaque fois que l'utilisateur réussit un coup critique, toutes ses statistiques sont augmentées de 1 niveau.",
            "ko": "Chaque fois que l'utilisateur réussit un coup critique, toutes ses statistiques sont augmentées de 1 niveau."
          }
        }
