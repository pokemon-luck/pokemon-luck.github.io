      "names": {
        "en": "Frozant",
        "fr": "Faisangelure",
        "it": "Poliwhirl",
        "de": "Quaputzi",
        "es": "Poliwhirl",
        "ko": "슈륙챙이"
      },
      "descriptions": {
        "en": "It keeps its eggs under the coldest ice to protect them from predators and maintain them at the desired temperature.",
        "fr": "Il conserve ses œufs sous les glaces les plus froides pour les protéger des prédateurs et les garder à la température voulue.",
        "it": "Si è adattato anche alla terraferma, ma passa la maggior parte del tempo in acqua, dove trova molti Pokémon acquatici di cui cibarsi.",
        "de": "Es hat zwar gelernt, auch an Land zu überleben, hält sich aber trotzdem vorwiegend im Wasser auf, wo es nach Fisch-Pokémon jagen kann.",
        "es": "Puede vivir en tierra firme perfectamente, pero prefiere el agua, donde encuentra más Pokémon pez que le sirven de sustento.",
        "ko": "지상에서 살 수 있게 되었는데도 먹이인 물고기포켓몬이 많은 수중에서 지낸다."
      },
      "abilities_data": [
        {
          "symbol": "ice_body",
          "textId": 115,
          "names": {
            "en": "Ice Body",
            "fr": "Corps Gel",
            "it": "Corpogelo",
            "de": "Eishaut",
            "es": "Gélido",
            "ko": "아이스바디"
          },
          "descriptions": {
            "en": "The Pokémon gradually regains HP in a hailstorm.",
            "fr": "Régénère les PV du Pokémon lors des tempêtes de grêle.",
            "it": "Se grandina, il Pokémon recupera PS.",
            "de": "Regeneriert bei Hagel nach und nach KP.",
            "es": "Recupera PS de forma gradual cuando hay tormentas de granizo.",
            "ko": "날씨가 싸라기눈일 때 HP를 조금씩 회복한다."
          }
        },
        {
          "symbol": "snow_warning",
          "textId": 117,
          "names": {
            "en": "Snow Warning",
            "fr": "Alerte Neige",
            "it": "Scendineve",
            "de": "Hagelalarm",
            "es": "Nevada",
            "ko": "눈퍼뜨리기"
          },
          "descriptions": {
            "en": "The Pokémon summons a hailstorm when it enters a battle.",
            "fr": "Déclenche une tempête de grêle quand le Pokémon entre au combat.",
            "it": "Quando il Pokémon entra in campo, provoca una grandinata.",
            "de": "Löst bei Kampfantritt Hagel aus.",
            "es": "Invoca una tormenta de granizo al entrar en combate.",
            "ko": "등장했을 때 날씨를 싸라기눈으로 만든다."
          }
        },
        {
          "symbol": "gale_wings",
          "textId": 177,
          "names": {
            "en": "Gale Wings",
            "fr": "Ailes Bourrasque",
            "it": "Aliraffica",
            "de": "Orkanschwingen",
            "es": "Alas Vendaval",
            "ko": "질풍날개"
          },
          "descriptions": {
            "en": "Gives priority to Flying-type moves when the Pokémon’s HP is full.",
            "fr": "Quand les PV du Pokémon sont au maximum, ses capacités de type Vol sont prioritaires.",
            "it": "Se il Pokémon ha tutti i PS, le sue mosse di tipo Volante acquistano priorità alta.",
            "de": "Kann bei vollen KP einen Erstschlag mit Flug-Attacken ermöglichen.",
            "es": "Da prioridad a los movimientos de tipo Volador si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 비행타입의 기술을 먼저 쓸 수 있다."
          }
        }
      ],
