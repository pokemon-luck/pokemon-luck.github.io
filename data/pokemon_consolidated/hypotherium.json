      "names": {
        "en": "Hypotherium",
        "fr": "Hypothérium",
        "it": "Ampharos",
        "de": "Ampharos",
        "es": "Ampharos",
        "ko": "전룡"
      },
      "descriptions": {
        "en": "Some high mountain glaciers actually hide hibernating Hypotheriums.",
        "fr": "Certains glaciers de haute montagne cachent en fait des Hypothérium en hibernation.",
        "it": "Questo Pokémon è facile da individuare grazie alla luce della sua coda, visibile anche dallo spazio. Per questo di solito la tiene spenta.",
        "de": "Das Licht seiner Schweifspitze kann man selbst aus dem Weltall noch sehen. Um seinen Standort zu verbergen, macht es sein Licht zumeist aus.",
        "es": "La luz que emite su cola puede verse desde el espacio, delatando su presencia a todos. Es por eso que normalmente la mantiene apagada.",
        "ko": "꼬리의 빛은 우주까지 도달하여 어디에 있든 바로 알 수 있다. 그래서 평소에는 끄고 있다."
      },
      "abilities_data": [
        {
          "symbol": "thick_fat",
          "textId": 47,
          "names": {
            "en": "Thick Fat",
            "fr": "Isograisse",
            "it": "Grassospesso",
            "de": "Speckschicht",
            "es": "Sebo",
            "ko": "두꺼운지방"
          },
          "descriptions": {
            "en": "The Pokémon is protected by a layer of thick fat, which halves the damage taken from Fire- and Ice-type moves.",
            "fr": "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu’il subit des capacités de types Feu et Glace.",
            "it": "Il Pokémon è protetto da uno spesso strato di grasso che dimezza il danno causato da mosse di tipo Fuoco e Ghiaccio.",
            "de": "Das Pokémon wird von einer dicken Fettschicht geschützt, was den durch Feuer- und Eis-Attacken erlittenen Schaden halbiert.",
            "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
            "ko": "두꺼운 지방으로 보호되고 있어 불꽃타입과 얼음타입의 기술의 데미지를 반감시킨다."
          }
        },
        {
          "symbol": "snow_warning",
          "textId": 117,
          "names": {
            "en": "Snow Warning",
            "fr": "Alerte Neige",
            "it": "Scendineve",
            "de": "Hagelalarm",
            "es": "Nevada",
            "ko": "눈퍼뜨리기"
          },
          "descriptions": {
            "en": "The Pokémon summons a hailstorm when it enters a battle.",
            "fr": "Déclenche une tempête de grêle quand le Pokémon entre au combat.",
            "it": "Quando il Pokémon entra in campo, provoca una grandinata.",
            "de": "Löst bei Kampfantritt Hagel aus.",
            "es": "Invoca una tormenta de granizo al entrar en combate.",
            "ko": "등장했을 때 날씨를 싸라기눈으로 만든다."
          }
        },
        {
          "symbol": "ancient_slumber",
          "textId": 277,
          "names": {
            "en": "Ancient Slumber",
            "fr": "Sommeil Ancien",
            "it": "Sommeil Ancien",
            "de": "Sommeil Ancien",
            "es": "Sommeil Ancien",
            "ko": "Sommeil Ancien"
          },
          "descriptions": {
            "en": "Once per fight, when below 30% HP, restores 50% of its max HP and cures status conditions. The pokémon falls asleep.",
            "fr": "Une fois par combat, en dessous de 30% de HP, restaure 50% des HP max et soigne les conditions d'état. Le pokémon s'endort.",
            "it": "En dessous de 30% de HP, restaure 30% des HP max et soigne les conditions d'état. Le pokémon s'endort.",
            "de": "En dessous de 30% de HP, restaure 30% des HP max et soigne les conditions d'état. Le pokémon s'endort.",
            "es": "En dessous de 30% de HP, restaure 30% des HP max et soigne les conditions d'état. Le pokémon s'endort.",
            "ko": "En dessous de 30% de HP, restaure 30% des HP max et soigne les conditions d'état. Le pokémon s'endort."
          }
        }
