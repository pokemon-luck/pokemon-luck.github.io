      "names": {
        "en": "Fungusprite",
        "fr": "Fongobelin",
        "it": "Oddish",
        "de": "Myrapla",
        "es": "Oddish",
        "ko": "뚜벅쵸"
      },
      "descriptions": {
        "en": "The mushroom on his back regrows into Amanixies when it falls off.",
        "fr": "Le champignon sur son dos repousse en Sporefadet lorsqu'il tombe.",
        "it": "Oddish cerca suolo fertile e ricco di sostanze nutritive per piantarvi le radici. Si dice che durante il giorno, quando è fisso nel terreno, le sue zampe si trasformino prendendo la forma delle radici degli alberi.",
        "de": "Myrapla sucht nach fruchtbarem, nahrhaftem Boden und pflanzt sich selbst darin ein. Solange es eingepflanzt ist, nehmen seine Füße tagsüber die Gestalt von Baumwurzeln an.",
        "es": "Oddish busca los suelos fértiles y ricos en nutrientes para plantarse en la tierra. Durante el día, se cree que le cambia la forma de los pies y se le empiezan a parecer a las raíces de los árboles.",
        "ko": "영양 만점인 흙을 찾아 몸을 묻는다. 낮 동안 땅에 묻혀 있을 때는 다리가 나무뿌리 같은 형태를 띠고 있는 듯하다."
      },
      "abilities_data": [
        {
          "symbol": "shield_dust",
          "textId": 19,
          "names": {
            "en": "Shield Dust",
            "fr": "Écran Poudre",
            "it": "Polvoscudo",
            "de": "Puderabwehr",
            "es": "Polvo Escudo",
            "ko": "인분"
          },
          "descriptions": {
            "en": "This Pokémon’s dust blocks the additional effects of attacks taken.",
            "fr": "Le Pokémon dispose d’un écran naturel qui le protège des effets additionnels des attaques ennemies.",
            "it": "Il Pokémon è protetto da uno strato di scaglie che annulla gli effetti aggiuntivi delle mosse subite.",
            "de": "Blockiert durch Puder die Zusatzeffekte gegnerischer Angriffe.",
            "es": "El polvo de escamas que lo envuelve lo protege de los efectos secundarios de los ataques recibidos.",
            "ko": "인분에 보호받아 기술의 추가 효과를 받지 않게 된다."
          }
        },
        {
          "symbol": "harvest",
          "textId": 139,
          "names": {
            "en": "Harvest",
            "fr": "Récolte",
            "it": "Coglibacche",
            "de": "Reiche Ernte",
            "es": "Cosecha",
            "ko": "수확"
          },
          "descriptions": {
            "en": "May create another Berry after one is used.",
            "fr": "Permet de réutiliser une même Baie plusieurs fois.",
            "it": "Può ricreare una bacca utilizzata.",
            "de": "Dieselbe Beere kann mehrmals verwendet werden.",
            "es": "Puede reutilizar varias veces una misma baya.",
            "ko": "사용한 나무열매를 몇 번이고 만들어 낸다."
          }
        },
        {
          "symbol": "effect_spore",
          "textId": 27,
          "names": {
            "en": "Effect Spore",
            "fr": "Pose Spore",
            "it": "Spargispora",
            "de": "Sporenwirt",
            "es": "Efecto Espora",
            "ko": "포자"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may inflict poison, sleep, or paralysis on its attacker.",
            "fr": "Peut paralyser, empoisonner ou endormir l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare avvelenamento, paralisi o sonno a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, kann das beim Gegner Paralyse, Vergiftung oder Schlaf auslösen.",
            "es": "Puede dormir, envenenar o paralizar al Pokémon con el que entre en contacto al recibir un ataque.",
            "ko": "공격으로 자신에게 접촉한 상대를 독이나 마비, 잠듦 상태로 만들 때가 있다."
          }
        }
      ],
