      "names": {
        "en": "Disguible",
        "fr": "Dissibule",
        "it": "Nidorino",
        "de": "Nidorino",
        "es": "Nidorino",
        "ko": "니드리노"
      },
      "descriptions": {
        "en": "Its favorite season is autumn, as it provides it with the leaves under which it loves to hide.",
        "fr": "Sa saison préférée est l'automne, elle lui fournit les feuilles sous lesquelles il aime se dissimuler.",
        "it": "Nidorino è dotato di un corno più duro del diamante. Quando percepisce una presenza ostile, gli si rizzano immediatamente tutti gli aculei sulla schiena. A questo punto sfida il nemico con tutta la sua forza.",
        "de": "Nidorino besitzt ein Horn, das sogar härter ist als ein Diamant. Wenn es einen Feind wahrnimmt, stellen sich all die Widerhaken auf seinem Rücken auf und es schlägt den Gegner mit aller Kraft in die Flucht.",
        "es": "Nidorino tiene un cuerno de dureza superior a la del diamante. Si siente una presencia hostil, se le erizan las púas del lomo enseguida y carga contra el enemigo con todas sus fuerzas.",
        "ko": "다이아몬드보다 단단한 뿔을 지녔다. 적의 기척을 느끼면 등에 달린 가시를 일제히 세우고 전력을 다해 맞선다."
      },
      "abilities_data": [
        {
          "symbol": "sniper",
          "textId": 97,
          "names": {
            "en": "Sniper",
            "fr": "Sniper",
            "it": "Cecchino",
            "de": "Superschütze",
            "es": "Francotirador",
            "ko": "스나이퍼"
          },
          "descriptions": {
            "en": "Powers up moves if they become critical hits when attacking.",
            "fr": "Lorsque le Pokémon porte un coup critique, les dégâts infligés augmentent encore plus que d’habitude.",
            "it": "Aumenta ulteriormente i danni inflitti dai brutti colpi.",
            "de": "Erhöht bei Volltreffern die Stärke der Attacke noch weiter.",
            "es": "Potencia los golpes críticos que asesta aún más de lo normal.",
            "ko": "공격을 급소에 맞혔을 때 위력이 더욱 올라간다."
          }
        },
        {
          "symbol": "super_luck",
          "textId": 105,
          "names": {
            "en": "Super Luck",
            "fr": "Chanceux",
            "it": "Supersorte",
            "de": "Glückspilz",
            "es": "Afortunado",
            "ko": "대운"
          },
          "descriptions": {
            "en": "The Pokémon is so lucky that the critical-hit ratios of its moves are boosted.",
            "fr": "Le Pokémon est tellement chanceux qu’il inflige plus fréquemment des coups critiques.",
            "it": "L’incredibile fortuna del Pokémon aumenta la sua probabilità di infliggere brutti colpi.",
            "de": "Großes Glück erhöht die Wahrscheinlichkeit, einen Volltreffer zu landen.",
            "es": "Su buena suerte aumenta la probabilidad de asestar golpes críticos.",
            "ko": "대운을 가지고 있어 상대의 급소에 공격이 맞기 쉽다."
          }
        },
        {
          "symbol": "long_reach",
          "textId": 203,
          "names": {
            "en": "Long Reach",
            "fr": "Longue Portée",
            "it": "Distacco",
            "de": "Langstrecke",
            "es": "Remoto",
            "ko": "원격"
          },
          "descriptions": {
            "en": "The Pokémon uses its moves without making contact with the target.",
            "fr": "Le Pokémon est capable d’utiliser toutes ses capacités sans entrer en contact direct avec sa cible.",
            "it": "Il Pokémon è in grado di usare tutte le sue mosse senza entrare in contatto diretto con il bersaglio.",
            "de": "Ermöglicht dem Pokémon den Einsatz aller seiner Attacken, ohne das Ziel dabei direkt zu berühren.",
            "es": "Puede usar cualquier movimiento sin entrar en contacto con el rival.",
            "ko": "모든 기술을 상대에게 접촉하지 않고 사용할 수 있다."
          }
        }
      ],
