      "names": {
        "en": "Lethallion",
        "fr": "Léthalon",
        "it": "Parasect",
        "de": "Parasek",
        "es": "Parasect",
        "ko": "파라섹트"
      },
      "descriptions": {
        "en": "Having crossed the border between life and death, it has a special connection with ghost-type Pokémon.",
        "fr": "Ayant franchi la frontière entre la vie et la mort, il a un lien particulier avec les pokémon spectres.",
        "it": "La parte essenziale di questo Pokémon, praticamente morto, è costituita dal fungo sulla sua schiena. Se si stacca, non può più muoversi.",
        "de": "Der Pilz auf seinem Rücken ist sein wichtigstes Körperteil. Der Rest ist quasi leblos und kann sich ohne den Pilz nicht bewegen.",
        "es": "La mayor parte de su cuerpo está atrofiada, excepto la seta del dorso, que controla al resto. Si se desprende, Parasect ya no podrá moverse.",
        "ko": "벌레는 거의 죽은 상태이고 본체는 등의 버섯이다. 떨어지면 더는 움직일 수 없다."
      },
      "abilities_data": [
        {
          "symbol": "shadow_tag",
          "textId": 23,
          "names": {
            "en": "Shadow Tag",
            "fr": "Marque Ombre",
            "it": "Pedinombra",
            "de": "Wegsperre",
            "es": "Sombra Trampa",
            "ko": "그림자밟기"
          },
          "descriptions": {
            "en": "This Pokémon steps on the opposing Pokémon’s shadow to prevent it from escaping.",
            "fr": "Empêche les Pokémon ennemis de quitter le combat.",
            "it": "Il Pokémon calpesta l’ombra del nemico impedendogli la fuga o la sostituzione.",
            "de": "Hindert Gegner an der Flucht beziehungsweise am Auswechseln, indem es ihnen den Weg versperrt.",
            "es": "Impide que el enemigo huya o sea cambiado por otro.",
            "ko": "상대의 그림자를 밟아 도망치거나 교체할 수 없게 한다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "perish_body",
          "textId": 253,
          "names": {
            "en": "Perish Body",
            "fr": "Corps Condamné",
            "it": "Ultimotocco",
            "de": "Unheilskörper",
            "es": "Cuerpo Mortal",
            "ko": "멸망의바디"
          },
          "descriptions": {
            "en": "When hit by a move that makes direct contact, the Pokémon and the attacker will faint after three turns unless they switch out of battle.",
            "fr": "Force le Pokémon et l'adversaire à tomber K.O. trois tours après que le Pokémon a été touché par une capacité directe, à moins qu'ils ne soient remplacés entre temps.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, dopo tre turni va KO assieme a chi lo ha attaccato. Se uno dei due viene sostituito, non va KO.",
            "de": "Erleidet es einen Treffer von einer direkten Attacke, wird es zusammen mit dem Angreifer nach drei Runden besiegt. Rettung ist durch Austausch möglich.",
            "es": "Si le alcanza un movimiento de contacto, se debilitará al cabo de 3 turnos, así como su agresor, a menos que abandonen el terreno de combate.",
            "ko": "접촉하는 기술을 받으면 3턴 후에 양쪽 모두 기절한다. 교체되면 효과가 없어진다."
          }
        }
      ],
