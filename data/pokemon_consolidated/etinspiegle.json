      "names": {
        "en": "Mischievil",
        "fr": "Étinspiègle",
        "it": "Victreebel",
        "de": "Sarzenia",
        "es": "Victreebel",
        "ko": "우츠보트"
      },
      "descriptions": {
        "en": "Campers can sometimes observe curious Mischievil approaching them to play with the embers of their campfire.",
        "fr": "Les campeurs observent parfois des Étinspiègle curieux, s'approchant d'eux pour jouer avec les braises de leur feu de camp.",
        "it": "Victreebel è dotato di una lunga liana che parte dalla testa. Il Pokémon la sventola e la agita come fosse un’esca per attirare la preda. Quando la preda ignara si avvicina, il Pokémon la inghiotte in un sol boccone.",
        "de": "Aus Sarzenias Kopf ragt eine lange Ranke hervor, die es bewegt, als wäre sie ein kleines Lebewesen. Nähert sich ahnungslose Beute dieser Falle, verschlingt Sarzenia sie im Ganzen.",
        "es": "Victreebel tiene una enredadera que le sale de la cabeza y que agita a modo de señuelo para atraer a sus presas y así engullirlas por sorpresa cuando estas se aproximan incautas.",
        "ko": "머리에 달린 긴 덩굴을 작은 생물처럼 움직여서 먹이를 유인한다. 가까이 왔을 때 덥석 한 번에 삼킨다."
      },
      "abilities_data": [
        {
          "symbol": "flame_body",
          "textId": 49,
          "names": {
            "en": "Flame Body",
            "fr": "Corps Ardent",
            "it": "Corpodifuoco",
            "de": "Flammkörper",
            "es": "Cuerpo Llama",
            "ko": "불꽃몸"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may burn the attacker.",
            "fr": "Peut brûler l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può scottare chi manda a segno un attacco diretto.",
            "de": "Fügt dem Angreifer bei Berührung eventuell Verbrennungen zu.",
            "es": "Puede quemar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 화상 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "prankster",
          "textId": 158,
          "names": {
            "en": "Prankster",
            "fr": "Farceur",
            "it": "Burla",
            "de": "Strolch",
            "es": "Bromista",
            "ko": "짓궂은마음"
          },
          "descriptions": {
            "en": "Gives priority to a status move.",
            "fr": "Rend les capacités de statut prioritaires.",
            "it": "Le mosse di stato del Pokémon acquistano priorità alta.",
            "de": "Ermöglicht einen Erstschlag mit Status-Attacken.",
            "es": "Sus movimientos de estado tienen prioridad alta.",
            "ko": "변화 기술을 먼저 쓸 수 있다."
          }
        },
        {
          "symbol": "sheer_force",
          "textId": 125,
          "names": {
            "en": "Sheer Force",
            "fr": "Sans Limite",
            "it": "Forzabruta",
            "de": "Rohe Gewalt",
            "es": "Potencia Bruta",
            "ko": "우격다짐"
          },
          "descriptions": {
            "en": "Removes additional effects to increase the power of moves when attacking.",
            "fr": "Les capacités ayant un effet additionnel le perdent, mais leur puissance augmente.",
            "it": "Aumenta la potenza delle mosse, ma ne annulla gli effetti aggiuntivi.",
            "de": "Erhöht die Stärke von Attacken, aber hebt dafür ihre Zusatzeffekte auf.",
            "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
            "ko": "기술의 추가 효과가 없어지지만 그만큼 높은 위력으로 기술을 사용할 수 있다."
          }
        }
      ],
