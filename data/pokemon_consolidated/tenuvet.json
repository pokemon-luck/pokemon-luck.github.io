      "names": {
        "en": "Puffuzz",
        "fr": "Ténuvet",
        "it": "Mankey",
        "de": "Menki",
        "es": "Mankey",
        "ko": "망키"
      },
      "descriptions": {
        "en": "It is said that those who meet Puffuzz's gaze are forever traumatized.",
        "fr": "On raconte que ceux qui croisent le regard de Ténuvet restent traumatisés à jamais.",
        "it": "Basta un nonnulla per farlo andare su tutte le furie. Tuttavia, non accumula stress e vive molto a lungo.",
        "de": "Selbst Kleinigkeiten regen es sofort auf. Da es Stress aber nicht in sich hineinfrisst, erfreut es sich eines langen Lebens.",
        "es": "Se encoleriza enseguida por cualquier minucia. Por otro lado, al no acumular estrés, suele gozar de una vida longeva.",
        "ko": "작은 일에도 금방 화를 낸다. 스트레스를 쌓아 두지 않아서 꽤 오래 사는 포켓몬이다."
      },
      "abilities_data": [
        {
          "symbol": "oblivious",
          "textId": 12,
          "names": {
            "en": "Oblivious",
            "fr": "Benêt",
            "it": "Indifferenza",
            "de": "Dösigkeit",
            "es": "Despiste",
            "ko": "둔감"
          },
          "descriptions": {
            "en": "The Pokémon is oblivious, and that keeps it from being infatuated or falling for taunts.",
            "fr": "Le Pokémon est un grand benêt, ce qui l’immunise contre l’attraction ou la provocation.",
            "it": "L’imperturbabilità del Pokémon lo protegge da infatuazioni e provocazioni.",
            "de": "Das Pokémon ist so apathisch, dass es nicht betört oder provoziert werden kann.",
            "es": "Su indiferencia evita que sea provocado o caiga presa del enamoramiento.",
            "ko": "둔감해서 헤롱헤롱이나 도발 상태가 되지 않는다."
          }
        },
        {
          "symbol": "gluttony",
          "textId": 82,
          "names": {
            "en": "Gluttony",
            "fr": "Gloutonnerie",
            "it": "Voracità",
            "de": "Völlerei",
            "es": "Gula",
            "ko": "먹보"
          },
          "descriptions": {
            "en": "Makes the Pokémon eat a held Berry when its HP drops to half or less, which is sooner than usual.",
            "fr": "Si le Pokémon tient une Baie à manger en cas de PV bas, il la mange dès qu’il a perdu la moitié de ses PV.",
            "it": "Il Pokémon non attende di aver perso molti PS per mangiare certe bacche, ma lo fa non appena i suoi PS scendono a metà o meno.",
            "de": "Setzt bestimmte Beeren nicht erst in einer Notlage ein, sondern bereits dann, wenn seine KP auf die Hälfte des Maximalwerts fallen.",
            "es": "Cuando sus PS se ven reducidos a la mitad, engulle la baya que normalmente solo se comería cuando le quedasen pocos PS.",
            "ko": "HP가 줄어들면 먹을 나무열매를 HP가 절반일 때 먹어버린다."
          }
        },
        {
          "symbol": "anger_point",
          "textId": 83,
          "names": {
            "en": "Anger Point",
            "fr": "Colérique",
            "it": "Grancollera",
            "de": "Kurzschluss",
            "es": "Irascible",
            "ko": "분노의경혈"
          },
          "descriptions": {
            "en": "The Pokémon is angered when it takes a critical hit, and that maxes its Attack stat.",
            "fr": "Si le Pokémon subit un coup critique, il entre dans une colère noire qui augmente son Attaque au maximum.",
            "it": "Se il Pokémon subisce un brutto colpo, monta su tutte le furie e il suo Attacco aumenta al massimo.",
            "de": "Wird nach Einstecken eines Volltreffers wütend und maximiert dabei seinen Angriffs-Wert.",
            "es": "Si recibe un golpe crítico, monta en cólera y sube su Ataque hasta el máximo.",
            "ko": "급소에 공격이 맞으면 크게 분노해 공격력이 최대가 된다."
          }
        }
      ],
