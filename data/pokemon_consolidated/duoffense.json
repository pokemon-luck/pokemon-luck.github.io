      "names": {
        "en": "Dueternal",
        "fr": "Duoffense",
        "it": "Marill",
        "de": "Marill",
        "es": "Marill",
        "ko": "마릴"
      },
      "descriptions": {
        "en": "It happens that Dueternal remains still for a few seconds, struggling to decide which head to follow.",
        "fr": "Il arrive à Duoffense de s'immobiliser quelques secondes, le temps de décider quelle tête suivre.",
        "it": "Per nutrirsi Marill pesca il cibo in riva a torrenti impetuosi, avvinghiando la coda attorno ai tronchi degli alberi. La coda di questo Pokémon è flessibile e dalla costituzione elastica.",
        "de": "Wenn es am Ufer eines reißenden Flusses fischt, wickelt Marill seinen Schweif um einen Baumstamm. Der Schweif dieses Pokémon ist flexibel und elastisch, sodass es ihn ausdehnen kann.",
        "es": "Este Pokémon tiene la cola muy flexible y elástica. A la hora de pescar a su presa en una rápida corriente, Marill enrosca la cola en un árbol.",
        "ko": "흐름이 빠른 강에서 먹이를 잡을 때는 꼬리를 강가의 나무줄기에 휘감는다. 꼬리는 탄력이 있어서 늘어나는 구조다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "haunting_aura",
          "textId": 278,
          "names": {
            "en": "Haunting Aura",
            "fr": "Aura Inquiétante",
            "it": "Aura Inquiétante",
            "de": "Aura Inquiétante",
            "es": "Aura Inquiétante",
            "ko": "Aura Inquiétante"
          },
          "descriptions": {
            "en": "Ghost-type moves have a 20% chance to lower either the target’s Defense or Special Defense by 1 stage.",
            "fr": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
            "it": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
            "de": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
            "es": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
            "ko": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau."
          }
        }
