      "names": {
        "en": "Wassid",
        "fr": "Wasside",
        "it": "Kakuna",
        "de": "Kokuna",
        "es": "Kakuna",
        "ko": "딱충이"
      },
      "descriptions": {
        "en": "Receiving one of Wassid's hairs or one of its teeth would guarantee absolute happiness.",
        "fr": "Recevoir de Wasside un de ses poils ou une de ses dents garantirait un bonheur absolu.",
        "it": "Kakuna rimane praticamente immobile abbarbicato agli alberi. Tuttavia, internamente è intento a preparare la sua futura evoluzione. Lo si può capire dall’intensità del calore sviluppato dal guscio.",
        "de": "Kokuna bewegt sich kaum, wenn es sich an einen Baum heftet. In seinem Inneren jedoch regt sich einiges, da es sich auf seine bevorstehende Entwicklung vorbereitet. Dabei wird seine Schale sehr heiß.",
        "es": "Kakuna permanece prácticamente inmóvil al encaramarse a los árboles, aunque la actividad interna de su organismo tiene un ritmo frenético, pues se prepara para su evolución. Prueba de esto es la alta temperatura de su caparazón.",
        "ko": "거의 움직이지 않고 나무에 매달려 있지만 내부는 진화 준비로 굉장히 바쁜 상태다. 그 증거로 몸이 뜨거워져 있다."
      },
      "abilities_data": [
        {
          "symbol": "volt_absorb",
          "textId": 10,
          "names": {
            "en": "Volt Absorb",
            "fr": "Absorbe-Volt",
            "it": "Assorbivolt",
            "de": "Voltabsorber",
            "es": "Absorbe Elec",
            "ko": "축전"
          },
          "descriptions": {
            "en": "Restores HP if hit by an Electric-type move instead of taking damage.",
            "fr": "Si le Pokémon est touché par une capacité Électrik, il ne subit aucun dégât et regagne des PV à la place.",
            "it": "Se il Pokémon viene colpito da una mossa di tipo Elettro, recupera PS anziché subire danni.",
            "de": "Treffer durch Elektro-Attacken verursachen keinen Schaden, sondern regenerieren stattdessen KP.",
            "es": "Si le alcanza un movimiento de tipo Eléctrico, recupera PS en vez de sufrir daño.",
            "ko": "전기타입의 기술을 받으면 데미지를 받지 않고 회복한다."
          }
        },
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        },
        {
          "symbol": "lightning_rod",
          "textId": 31,
          "names": {
            "en": "Lightning Rod",
            "fr": "Paratonnerre",
            "it": "Parafulmine",
            "de": "Blitzfänger",
            "es": "Pararrayos",
            "ko": "피뢰침"
          },
          "descriptions": {
            "en": "The Pokémon draws in all Electric-type moves. Instead of being hit by Electric-type moves, it boosts its Sp. Atk.",
            "fr": "Le Pokémon détourne sur lui les capacités de type Électrik et les neutralise, tout en montant son Attaque Spéciale.",
            "it": "Il Pokémon attira e neutralizza le mosse di tipo Elettro e fa aumentare il suo Attacco Speciale.",
            "de": "Zieht Elektro-Attacken an. Statt durch diese Schaden zu nehmen, erhöht es den eigenen Spezial-Angriff.",
            "es": "Atrae y neutraliza los movimientos de tipo Eléctrico, que además le suben el Ataque Especial.",
            "ko": "전기타입의 기술을 자신에게 끌어모아 데미지를 받지 않고 특수공격을 올린다."
          }
        }
      ],
