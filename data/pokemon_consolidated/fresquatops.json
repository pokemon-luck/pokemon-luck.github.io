      "names": {
        "en": "Permafresco",
        "fr": "Fresquatops",
        "it": "Sceptile",
        "de": "Gewaldro",
        "es": "Sceptile",
        "ko": "나무킹"
      },
      "descriptions": {
        "en": "Some cave paintings have been attributed to the Permafresco by experts.",
        "fr": "Certaines peintures rupestres ont été attribuées aux Fresquatops par des spécialistes.",
        "it": "Sulla schiena di Sceptile crescono alcuni semi che si dice siano ricchi di nutrienti per gli alberi. Questo Pokémon coltiva amorevolmente le sue piante nella foresta.",
        "de": "Auf Gewaldros Rücken wachsen Samen. Darin sind Nährstoffe, die Bäume beleben können. Dieses Pokémon achtet mit viel Fürsorge darauf, dass die Bäume seines Waldes prächtig gedeihen.",
        "es": "A Sceptile le crecen en la espalda unas semillas llenas de nutrientes que sirven para revitalizar los árboles. De hecho, se dedica a cuidarlos con mimo para que crezcan bien.",
        "ko": "등의 씨앗에는 나무를 건강하게 만드는 영양이 많이 채워져 있다고 전해진다. 숲의 나무를 소중히 키우고 있는 포켓몬이다."
      },
      "abilities_data": [
        {
          "symbol": "gooey",
          "textId": 183,
          "names": {
            "en": "Gooey",
            "fr": "Poisseux",
            "it": "Viscosità",
            "de": "Viskosität",
            "es": "Baba",
            "ko": "미끈미끈"
          },
          "descriptions": {
            "en": "Contact with the Pokémon lowers the attacker’s Speed stat.",
            "fr": "Baisse la Vitesse de l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, la Velocità di chi l’ha colpito diminuisce.",
            "de": "Senkt bei Berührung im Zuge eines Angriffs die Initiative des Angreifers.",
            "es": "Baja la Velocidad del rival cuando este le ataca con un movimiento de contacto.",
            "ko": "공격으로 자신과 접촉한 상대의 스피드를 떨어뜨린다."
          }
        },
        {
          "symbol": "refrigerate",
          "textId": 174,
          "names": {
            "en": "Refrigerate",
            "fr": "Peau Gelée",
            "it": "Pellegelo",
            "de": "Frostschicht",
            "es": "Piel Helada",
            "ko": "프리즈스킨"
          },
          "descriptions": {
            "en": "Normal-type moves become Ice-type moves. The power of those moves is boosted a little.",
            "fr": "Les capacités de type Normal deviennent de type Glace. Leur puissance augmente légèrement.",
            "it": "Le mosse di tipo Normale diventano di tipo Ghiaccio e la loro potenza aumenta un po’.",
            "de": "Attacken vom Typ Normal nehmen den Typ Eis an und ihre Stärke erhöht sich ein wenig.",
            "es": "Convierte los movimientos de tipo Normal en tipo Hielo y aumenta ligeramente su potencia.",
            "ko": "노말타입의 기술이 얼음타입이 된다. 위력이 조금 올라간다."
          }
        },
        {
