      "names": {
        "en": "Crystalien",
        "fr": "Cristalien",
        "it": "Gastly",
        "de": "Nebulak",
        "es": "Gastly",
        "ko": "고오스"
      },
      "descriptions": {
        "en": "Once asleep, it becomes difficult to distinguish Crystalien from a simple geode.",
        "fr": "Une fois endormi, il devient compliqué de différencier Cristalien d'une simple géode.",
        "it": "Si dice che questo Pokémon sia nato quando i gas esalati da un cimitero sono stati animati da un sentimento di rancore.",
        "de": "Es heißt, dieses Pokémon sei aus einem tiefen Groll entstanden, der Gasen innewohnte, die auf Friedhöfen ausgeströmt waren.",
        "es": "Se dice que su origen son nubes de gas provenientes de un cementerio que cobraron vida al verse imbuidas de rencor.",
        "ko": "무덤에서 발생한 가스에 원념이 머물러 이윽고 포켓몬이 되었다고 전해진다."
      },
      "abilities_data": [
        {
          "symbol": "inner_focus",
          "textId": 39,
          "names": {
            "en": "Inner Focus",
            "fr": "Attention",
            "it": "Forza Interiore",
            "de": "Konzentrator",
            "es": "Foco Interno",
            "ko": "정신력"
          },
          "descriptions": {
            "en": "The Pokémon’s intensely focused, and that protects the Pokémon from flinching.",
            "fr": "Le Pokémon a un mental à toute épreuve qui empêche les capacités ennemies de lui faire peur.",
            "it": "La capacità di concentrazione del Pokémon evita che tentenni per gli attacchi del nemico.",
            "de": "Verhindert durch erhöhte Konzentrationsfähigkeit Zurückschrecken.",
            "es": "Gracias a su profunda concentración, no se amedrenta ante los ataques del rival.",
            "ko": "단련한 정신으로 인하여 상대의 공격에 풀죽지 않는다."
          }
        },
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        },
        {
          "symbol": "analytic",
          "textId": 148,
          "names": {
            "en": "Analytic",
            "fr": "Analyste",
            "it": "Ponderazione",
            "de": "Analyse",
            "es": "Cálculo Final",
            "ko": "애널라이즈"
          },
          "descriptions": {
            "en": "Boosts move power when the Pokémon moves last.",
            "fr": "Augmente la puissance des capacités du Pokémon s’il attaque en dernier.",
            "it": "Se il Pokémon agisce per ultimo, la potenza della mossa aumenta.",
            "de": "Greift das Pokémon zuletzt an, erhöht sich die Stärke der Attacke, die es einsetzt.",
            "es": "Aumenta la potencia de su movimiento si es el último en atacar.",
            "ko": "제일 마지막에 기술을 쓰면 기술의 위력이 올라간다."
          }
        }
      ],
