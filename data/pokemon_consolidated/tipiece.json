      "names": {
        "en": "Spookoin",
        "fr": "Tipièce",
        "it": "Dodrio",
        "de": "Dodri",
        "es": "Dodrio",
        "ko": "두트리오"
      },
      "descriptions": {
        "en": "Spookoin enjoys lying face down in busy streets, waiting for a passerby to pick it up to startle them.",
        "fr": "Tipièce aime rester face contre sol dans les rues fréquentées, attendant qu'un passant le ramasse pour le faire sursauter.",
        "it": "Pare che Dodrio non abbia soltanto tre teste, ma anche altri organi triplici: ha infatti anche tre cuori e sei polmoni che gli consentono di percorrere grandi distanze senza sosta.",
        "de": "Dodri hat nicht nur drei Köpfe, auch andere Körperteile sind dreifach vorhanden. Es besitzt drei Herzen und drei Lungen, sodass es lange Strecken ohne Pause rennen kann.",
        "es": "Según parece, las cabezas no son las únicas partes del cuerpo que tiene triplicadas. Dodrio también tiene tres corazones y tres pares de pulmones. Con esta constitución, puede correr largas distancias sin cansarse.",
        "ko": "3개 있는 것은 머리뿐이 아닌 것 같다. 심장과 폐도 3개라서 숨이 가빠지지 않으며 먼 거리를 달릴 수 있다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "bulletproof",
          "textId": 171,
          "names": {
            "en": "Bulletproof",
            "fr": "Pare-Balles",
            "it": "Antiproiettile",
            "de": "Kugelsicher",
            "es": "Antibalas",
            "ko": "방탄"
          },
          "descriptions": {
            "en": "Protects the Pokémon from some ball and bomb moves.",
            "fr": "Protège de certaines capacités lançant des projectiles comme des bombes et des balles.",
            "it": "Protegge da alcune mosse a base di proiettili e bombe.",
            "de": "Kann das Pokémon vor geworfenen kugelförmigen Objekten, wie zum Beispiel Bomben, schützen.",
            "es": "No le afectan las bombas ni algunos proyectiles.",
            "ko": "상대 구슬이나 폭탄 등 기술을 막을 수 있다."
          }
        },
        {
          "symbol": "weak_armor",
          "textId": 133,
          "names": {
            "en": "Weak Armor",
            "fr": "Armurouillée",
            "it": "Sottilguscio",
            "de": "Bruchrüstung",
            "es": "Armadura Frágil",
            "ko": "깨어진갑옷"
          },
          "descriptions": {
            "en": "Physical attacks to the Pokémon lower its Defense stat but sharply raise its Speed stat.",
            "fr": "Quand le Pokémon est touché par une capacité physique, sa Défense baisse mais sa Vitesse augmente beaucoup.",
            "it": "Se il Pokémon subisce danni da mosse fisiche, la Difesa diminuisce e la Velocità aumenta di molto.",
            "de": "Senkt bei erlittenem Treffer durch eine physische Attacke die Verteidigung des Pokémon, aber erhöht dafür seine Initiative stark.",
            "es": "Al recibir daño de un ataque físico, le baja la Defensa, pero le sube mucho la Velocidad.",
            "ko": "물리 기술로 데미지를 받으면 방어가 떨어지고 스피드가 크게 올라간다."
          }
        }
      ],
