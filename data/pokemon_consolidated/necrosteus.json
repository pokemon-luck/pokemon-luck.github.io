      "names": {
        "en": "Necrosteus",
        "fr": "Necrosteus",
        "it": "Sneasel",
        "de": "Sniebel",
        "es": "Sneasel",
        "ko": "포푸니"
      },
      "descriptions": {
        "en": "In the past, Necrosteus were seen as warning signs for the surfacing of a ghost ship.",
        "fr": "Autrefois, les necrosteus étaient considérés comme signe avant-coureur de l'apparition imminente d'un navire fantôme.",
        "it": "Questi Pokémon agiscono in squadra per rubare le Uova dai nidi dei Pokémon alati, ma poi litigano per stabilire chi le mangerà.",
        "de": "Sie bilden ein Team, um gemeinsam Eier aus den Nestern von Vogel-Pokémon zu klauen. Dann streiten sie sich darüber, wer sie fressen darf.",
        "es": "Colabora con los suyos para saquear nidos de Pokémon pájaro, aunque luego se disputan fieramente quién se come los huevos.",
        "ko": "팀플레이로 새포켓몬의 둥지에서 알을 훔쳐 내지만, 누가 먹을까로 싸움이 난다."
      },
      "abilities_data": [
        {
          "symbol": "filter",
          "textId": 111,
          "names": {
            "en": "Filter",
            "fr": "Filtre",
            "it": "Filtro",
            "de": "Filter",
            "es": "Filtro",
            "ko": "필터"
          },
          "descriptions": {
            "en": "Reduces the power of supereffective attacks taken.",
            "fr": "Réduit les dégâts subis lorsque le Pokémon est touché par une capacité super efficace.",
            "it": "Riduce i danni subiti dalle mosse superefficaci.",
            "de": "Reduziert die Stärke von sehr effektiven Attacken und verringert damit den Schaden, den das Pokémon durch sie erleidet.",
            "es": "Mitiga el daño que le infligen los movimientos supereficaces.",
            "ko": "효과가 굉장한 공격의 위력을 약하게 만든다."
          }
        },
        {
          "symbol": "liquid_ooze",
          "textId": 64,
          "names": {
            "en": "Liquid Ooze",
            "fr": "Suintement",
            "it": "Melma",
            "de": "Kloakensoße",
            "es": "Lodo Líquido",
            "ko": "해감액"
          },
          "descriptions": {
            "en": "The oozed liquid has a strong stench, which damages attackers using any draining move.",
            "fr": "Le Pokémon suinte un liquide toxique nauséabond qui blesse tous ceux qui tentent de voler ses PV.",
            "it": "Il Pokémon secerne delle sostanze tossiche. Se un nemico manda a segno una mossa che assorbe i PS, subisce dei danni.",
            "de": "Angreifer, die durch Saug-Attacken Kloakensoße in sich aufgenommen haben, nehmen durch deren widerwärtigen Gestank Schaden.",
            "es": "Exuda una sustancia tóxica de intenso hedor que hiere a quienes intentan drenarle PS.",
            "ko": "해감액을 흡수한 상대는 강렬한 악취로 데미지를 받아 HP가 줄어든다."
          }
        },
        {
          "symbol": "rattling_bones",
          "textId": 305,
          "names": {
            "en": "Rattling Bones",
            "fr": "Cliquet'Os",
            "it": "Rattling Bones",
            "de": "Rattling Bones",
            "es": "Rattling Bones",
            "ko": "Rattling Bones"
          },
          "descriptions": {
            "en": "Raises speed if at least one opposing pokémon is inflincted by the Decay status effect.",
            "fr": "Augmente la vitesse si au moins un ennemi possède la condition de statut Décomposition.",
            "it": "",
            "de": "",
            "es": "",
            "ko": ""
          }
        }
