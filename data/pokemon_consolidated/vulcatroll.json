      "names": {
        "en": "Folkano",
        "fr": "Vulcatroll",
        "it": "Flareon",
        "de": "Flamara",
        "es": "Flareon",
        "ko": "부스터"
      },
      "descriptions": {
        "en": "Because of its fiery fists, no one ever dares to approach it.",
        "fr": "A cause de ses poings de feu, personne n'ose jamais l'approcher.",
        "it": "Quando inspira profondamente significa che si sta preparando all’attacco. Sputa fiamme alla temperatura di 1.700 °C.",
        "de": "Wenn es tief einatmet, bereitet es gerade einen Angriff vor. Es kann bis zu 1700 °C heiße Flammen speien.",
        "es": "Cuando inspira profundamente es señal de que se dispone a atacar. Expele llamaradas que alcanzan temperaturas de 1700 °C.",
        "ko": "크게 공기를 들이쉬는 것은 공격 신호다. 1700도의 불꽃이 엄습해 온다."
      },
      "abilities_data": [
        {
          "symbol": "sheer_force",
          "textId": 125,
          "names": {
            "en": "Sheer Force",
            "fr": "Sans Limite",
            "it": "Forzabruta",
            "de": "Rohe Gewalt",
            "es": "Potencia Bruta",
            "ko": "우격다짐"
          },
          "descriptions": {
            "en": "Removes additional effects to increase the power of moves when attacking.",
            "fr": "Les capacités ayant un effet additionnel le perdent, mais leur puissance augmente.",
            "it": "Aumenta la potenza delle mosse, ma ne annulla gli effetti aggiuntivi.",
            "de": "Erhöht die Stärke von Attacken, aber hebt dafür ihre Zusatzeffekte auf.",
            "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
            "ko": "기술의 추가 효과가 없어지지만 그만큼 높은 위력으로 기술을 사용할 수 있다."
          }
        },
        {
          "symbol": "flame_body",
          "textId": 49,
          "names": {
            "en": "Flame Body",
            "fr": "Corps Ardent",
            "it": "Corpodifuoco",
            "de": "Flammkörper",
            "es": "Cuerpo Llama",
            "ko": "불꽃몸"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may burn the attacker.",
            "fr": "Peut brûler l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può scottare chi manda a segno un attacco diretto.",
            "de": "Fügt dem Angreifer bei Berührung eventuell Verbrennungen zu.",
            "es": "Puede quemar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 화상 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        }
      ],
