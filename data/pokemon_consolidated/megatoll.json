      "names": {
        "en": "Megatoll",
        "fr": "Mégatoll",
        "it": "Ninetales",
        "de": "Vulnona",
        "es": "Ninetales",
        "ko": "나인테일"
      },
      "descriptions": {
        "en": "Boats sometimes ground on Megatoll, with sailors mistaking it for real islands.",
        "fr": "Des bateaux s'échouent parfois sur Mégatoll, les marins le confondant avec de vraies îles.",
        "it": "È molto ostinato e vendicativo. Chi si attira il suo rancore cade vittima di una maledizione millenaria che si trasmette anche ai discendenti.",
        "de": "Dieses Pokémon ist sehr rachsüchtig. Wer seinen Groll provoziert, den verfolgt bis in seine Nachkommenschaft ein tausendjähriger Fluch.",
        "es": "Un Pokémon extraordinariamente vengativo. Si recibe una afrenta, su rencor puede perdurar durante un milenio y trascender generaciones.",
        "ko": "끈질기고 집념이 강한 성질을 가졌다. 한 번 원한을 사면 자손을 포함해 1000년간 해를 입는다."
      },
      "abilities_data": [
        {
          "symbol": "rain_dish",
          "textId": 44,
          "names": {
            "en": "Rain Dish",
            "fr": "Cuvette",
            "it": "Copripioggia",
            "de": "Regengenuss",
            "es": "Cura Lluvia",
            "ko": "젖은접시"
          },
          "descriptions": {
            "en": "The Pokémon gradually regains HP in rain.",
            "fr": "Le Pokémon récupère progressivement des PV lorsqu’il pleut.",
            "it": "Il Pokémon recupera PS quando piove.",
            "de": "Regeneriert bei Regen nach und nach KP.",
            "es": "Recupera PS de forma gradual cuando llueve.",
            "ko": "비가 오는 날씨일 때 조금씩 HP를 회복한다."
          }
        },
        {
          "symbol": "swift_swim",
          "textId": 33,
          "names": {
            "en": "Swift Swim",
            "fr": "Glissade",
            "it": "Nuotovelox",
            "de": "Wassertempo",
            "es": "Nado Rápido",
            "ko": "쓱쓱"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in rain.",
            "fr": "Augmente la Vitesse du Pokémon s’il pleut.",
            "it": "Se piove, la Velocità aumenta.",
            "de": "Erhöht bei Regen die Initiative.",
            "es": "Sube su Velocidad cuando llueve.",
            "ko": "비가 오는 날씨일 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "hydration",
          "textId": 93,
          "names": {
            "en": "Hydration",
            "fr": "Hydratation",
            "it": "Idratazione",
            "de": "Hydration",
            "es": "Hidratación",
            "ko": "촉촉바디"
          },
          "descriptions": {
            "en": "Heals status conditions if it’s raining.",
            "fr": "Soigne les altérations de statut du Pokémon quand il pleut.",
            "it": "Se piove, il Pokémon guarisce dai problemi di stato.",
            "de": "Heilt bei Regen Statusprobleme.",
            "es": "Cura los problemas de estado si está lloviendo.",
            "ko": "비가 오는 날씨일 때 상태 이상이 회복된다."
          }
        }
      ],
