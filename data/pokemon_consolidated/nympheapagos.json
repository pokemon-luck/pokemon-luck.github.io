      "names": {
        "en": "Lotapagos",
        "fr": "Nymphéapagos",
        "it": "Marshtomp",
        "de": "Moorabbel",
        "es": "Marshtomp",
        "ko": "늪짱이"
      },
      "descriptions": {
        "en": "Lotapagos' imposing stature protects the Paddurtle in its pond by deterring intruders.",
        "fr": "La carrure imposante de Nymphéapagos assure la protection des Torténuphar de sa mare en dissuadant les envahisseurs.",
        "it": "Marshtomp è molto più a suo agio nel fango che non in acqua e sa muoversi con estrema rapidità. La parte inferiore del suo corpo mostra un chiaro sviluppo, consentendogli di camminare solo sugli arti inferiori.",
        "de": "Moorabbel kommt im Schlamm besser voran als im Wasser. Das Hinterteil dieses Pokémon ist gut entwickelt, sodass es auf seinen Hinterbeinen laufen kann.",
        "es": "Marshtomp se desplaza más rápido por el lodo que por el agua. Los cuartos traseros de este Pokémon muestran un desarrollo más que evidente, lo que le permite andar solo sobre las patas traseras.",
        "ko": "물속을 헤엄치는 것보다 진흙 속에서 이동하는 편이 훨씬 빠르게 이동할 수 있다.  하반신이 발달하여 두 다리로 걷는다."
      },
      "abilities_data": [
        {
          "symbol": "effect_spore",
          "textId": 27,
          "names": {
            "en": "Effect Spore",
            "fr": "Pose Spore",
            "it": "Spargispora",
            "de": "Sporenwirt",
            "es": "Efecto Espora",
            "ko": "포자"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may inflict poison, sleep, or paralysis on its attacker.",
            "fr": "Peut paralyser, empoisonner ou endormir l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare avvelenamento, paralisi o sonno a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, kann das beim Gegner Paralyse, Vergiftung oder Schlaf auslösen.",
            "es": "Puede dormir, envenenar o paralizar al Pokémon con el que entre en contacto al recibir un ataque.",
            "ko": "공격으로 자신에게 접촉한 상대를 독이나 마비, 잠듦 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "rain_dish",
          "textId": 44,
          "names": {
            "en": "Rain Dish",
            "fr": "Cuvette",
            "it": "Copripioggia",
            "de": "Regengenuss",
            "es": "Cura Lluvia",
            "ko": "젖은접시"
          },
          "descriptions": {
            "en": "The Pokémon gradually regains HP in rain.",
            "fr": "Le Pokémon récupère progressivement des PV lorsqu’il pleut.",
            "it": "Il Pokémon recupera PS quando piove.",
            "de": "Regeneriert bei Regen nach und nach KP.",
            "es": "Recupera PS de forma gradual cuando llueve.",
            "ko": "비가 오는 날씨일 때 조금씩 HP를 회복한다."
          }
        },
        {
          "symbol": "liquid_ooze",
          "textId": 64,
          "names": {
            "en": "Liquid Ooze",
            "fr": "Suintement",
            "it": "Melma",
            "de": "Kloakensoße",
            "es": "Lodo Líquido",
            "ko": "해감액"
          },
          "descriptions": {
            "en": "The oozed liquid has a strong stench, which damages attackers using any draining move.",
            "fr": "Le Pokémon suinte un liquide toxique nauséabond qui blesse tous ceux qui tentent de voler ses PV.",
            "it": "Il Pokémon secerne delle sostanze tossiche. Se un nemico manda a segno una mossa che assorbe i PS, subisce dei danni.",
            "de": "Angreifer, die durch Saug-Attacken Kloakensoße in sich aufgenommen haben, nehmen durch deren widerwärtigen Gestank Schaden.",
            "es": "Exuda una sustancia tóxica de intenso hedor que hiere a quienes intentan drenarle PS.",
            "ko": "해감액을 흡수한 상대는 강렬한 악취로 데미지를 받아 HP가 줄어든다."
          }
        }
      ],
