      "names": {
        "en": "Momotoo",
        "fr": "Momotoo",
        "it": "Skiploom",
        "de": "Hubelupf",
        "es": "Skiploom",
        "ko": "두코"
      },
      "descriptions": {
        "en": "Momotoo steals the life energy of the unfortunate souls who meet its gaze for too long.",
        "fr": "Momotoo dérobe l'énergie vitale des malheureux qui croisent son regard pendant trop longtemps.",
        "it": "Il fiore di Skiploom sboccia quando la temperatura sale oltre i 18 °C. L’apertura del fiore dipende dalla temperatura. Per questo motivo il Pokémon è usato anche come termometro.",
        "de": "Hubelupfs Blume beginnt zu blühen, wenn die Temperatur über 18 °C steigt. Wie weit sich die Blume öffnet, hängt von der Temperatur ab. Daher wird dieses Pokémon manchmal als Thermometer eingesetzt.",
        "es": "Skiploom florece cuando la temperatura llega a 18 °C. La apertura de los pétalos varía según la temperatura que haga. Por este motivo, la gente lo usa a veces a modo de termómetro.",
        "ko": "기온이 18도를 넘으면 꽃이 핀다. 온도에 따라 꽃이 피는 모습이 바뀌어서 온도계 대신 쓰기도 한다."
      },
      "abilities_data": [
        {
          "symbol": "insomnia",
          "textId": 15,
          "names": {
            "en": "Insomnia",
            "fr": "Insomnia",
            "it": "Insonnia",
            "de": "Insomnia",
            "es": "Insomnio",
            "ko": "불면"
          },
          "descriptions": {
            "en": "The Pokémon is suffering from insomnia and cannot fall asleep.",
            "fr": "Le Pokémon est incapable de dormir.",
            "it": "Il Pokémon soffre d’insonnia e non può addormentarsi.",
            "de": "Verhindert Einschlafen.",
            "es": "Su resistencia al sueño le impide quedarse dormido.",
            "ko": "잠들지 못하는 체질이라 잠듦 상태가 되지 않는다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "trace",
          "textId": 36,
          "names": {
            "en": "Trace",
            "fr": "Calque",
            "it": "Traccia",
            "de": "Erfassen",
            "es": "Rastro",
            "ko": "트레이스"
          },
          "descriptions": {
            "en": "When it enters a battle, the Pokémon copies an opposing Pokémon’s Ability.",
            "fr": "Lorsque le Pokémon entre au combat, il calque le talent d’un ennemi pour remplacer le sien.",
            "it": "Quando il Pokémon entra in campo, copia l’abilità di un nemico.",
            "de": "Kopiert bei Kampfantritt die Fähigkeit eines Gegners.",
            "es": "Al entrar en combate copia la habilidad del rival.",
            "ko": "등장했을 때 상대의 특성을 트레이스해서 같은 특성이 된다."
          }
        }
      ],
