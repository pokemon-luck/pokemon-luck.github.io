      "names": {
        "en": "Lycanight",
        "fr": "Lunarou",
        "it": "Raticate",
        "de": "Rattikarl",
        "es": "Raticate",
        "ko": "레트라"
      },
      "descriptions": {
        "en": "When a Murkub sees the full moon, its fury sometimes overwhelms it and transforms it into Lycanight.",
        "fr": "Lorsqu'un Loune voit la pleine lune, sa fureur le dépasse parfois et le transforme en Lunarou.",
        "it": "Si dice che sia sfuggito ai nemici nuotando da un’isola all’altra grazie alle minuscole membrane tra le dita delle zampe posteriori.",
        "de": "Auf der Flucht vor seinen Feinden nutzt es die Schwimmhäute an seinen Hinterläufen, um von Insel zu Insel zu schwimmen.",
        "es": "Las pequeñas membranas que tiene en las patas traseras le permiten nadar entre las islas de Alola y escapar así de sus depredadores.",
        "ko": "뒷발의 작의 물갈퀴로 바다를 헤엄쳐 섬을 건너 적을 피해 도망쳤다고 한다."
      },
      "abilities_data": [
        {
          "symbol": "night_affinity",
          "textId": 268,
          "names": {
            "en": "Night Affinity",
            "fr": "Affinité Nocturne",
            "it": "Night Affinity",
            "de": "Night Affinity",
            "es": "Night Affinity",
            "ko": "Night Affinity"
          },
          "descriptions": {
            "en": "Night-time gives this Pokémon strength, boosting its statistics and switching its secondary typing to Dark",
            "fr": "La nuit renforce ce Pokémon, augmentant ses statistiques et remplaçant son second type par Ténèbres",
            "it": "",
            "de": "Night-time gives this Pokémon strength, boosting its statistics and switching its secondary typing to Dark",
            "es": "Night-time gives this Pokémon strength, boosting its statistics and switching its secondary typing to Dark",
            "ko": ""
          }
        },
        {
          "symbol": "intimidate",
          "textId": 22,
          "names": {
            "en": "Intimidate",
            "fr": "Intimidation",
            "it": "Prepotenza",
            "de": "Bedroher",
            "es": "Intimidación",
            "ko": "위협"
          },
          "descriptions": {
            "en": "The Pokémon intimidates opposing Pokémon upon entering battle, lowering their Attack stat.",
            "fr": "Le Pokémon rugit lorsqu’il arrive au combat, ce qui intimide l’ennemi et baisse son Attaque.",
            "it": "Quando il Pokémon entra in campo, la sua prepotenza intimidisce i nemici, riducendone l’Attacco.",
            "de": "Senkt den Angriff der Gegner, indem es sie gleich zu Kampfantritt bedroht und einschüchtert.",
            "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
            "ko": "등장했을 때 위협해서 상대를 위축시켜 상대의 공격을 떨어뜨린다."
          }
        },
        {
          "symbol": "unaware",
          "textId": 109,
          "names": {
            "en": "Unaware",
            "fr": "Inconscient",
            "it": "Imprudenza",
            "de": "Unkenntnis",
            "es": "Ignorante",
            "ko": "천진"
          },
          "descriptions": {
            "en": "When attacking, the Pokémon ignores the target Pokémon’s stat changes.",
            "fr": "Quand il attaque, le Pokémon ignore les changements de stats de l’ennemi.",
            "it": "Quando il Pokémon attacca, ignora le modifiche alle statistiche del nemico.",
            "de": "Greift das Pokémon an, ignoriert es sämtliche Statusveränderungen des Zieles.",
            "es": "Pasa por alto las mejoras en las características del rival al atacar.",
            "ko": "상대의 능력 변화를 무시하고 공격할 수 있다."
          }
        }
      ],
