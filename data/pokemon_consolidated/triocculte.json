      "names": {
        "en": "Trioccult",
        "fr": "Triocculte",
        "it": "Azumarill",
        "de": "Azumarill",
        "es": "Azumarill",
        "ko": "마릴리"
      },
      "descriptions": {
        "en": "The movements of Trioccult's three heads serve as choreography for occult ceremonies.",
        "fr": "Les mouvements des têtes de Triocculte servent de chorégraphie à des cérémonies occultes.",
        "it": "Azumarill riesce a creare bolle d’aria in grado di aiutare un Pokémon che sta per affogare. Quando ne vede uno, Azumarill gli manda una bolla per aiutarlo a respirare.",
        "de": "Azumarill kann aus Luft Ballons machen. Diese Luft-Ballons erzeugt es, wenn es ein ertrinkendes Pokémon erspäht. Durch die Ballons kann das Pokémon, das in Schwierigkeiten geraten ist, atmen.",
        "es": "Azumarill puede hacer burbujas de aire si ve a algún Pokémon que esté a punto de ahogarse. Estas burbujas de aire son básicas para que los Pokémon puedan seguir respirando.",
        "ko": "공기로 풍선을 만들 수 있다. 포켓몬이 물에 빠져 있으면 공기 방울을 만들어내 호흡을 할 수 있게 해준다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "haunting_aura",
          "textId": 278,
          "names": {
            "en": "Haunting Aura",
            "fr": "Aura Inquiétante",
            "it": "Aura Inquiétante",
            "de": "Aura Inquiétante",
            "es": "Aura Inquiétante",
            "ko": "Aura Inquiétante"
          },
          "descriptions": {
            "en": "Ghost-type moves have a 20% chance to lower either the target’s Defense or Special Defense by 1 stage.",
            "fr": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
            "it": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
            "de": "Les attaques de type Spectre ont 20% de chances de diminuer la Défense ou la Défense Spéciale de la cible de 1 niveau.",
