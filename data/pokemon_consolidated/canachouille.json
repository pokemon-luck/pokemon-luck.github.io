      "names": {
        "en": "Cuteeth",
        "fr": "Canachouille",
        "it": "Chikorita",
        "de": "Endivie",
        "es": "Chikorita",
        "ko": "치코리타"
      },
      "descriptions": {
        "en": "Its voracious appetite combined with its powerful jaw makes Cuteeth difficult to contain for some trainers.",
        "fr": "Son appétit vorace couplé à sa mâchoire puissante rendent Canachouille difficile à contenir pour certains dresseurs.",
        "it": "Nella lotta, Chikorita sventola la sua foglia in modo da tenere a bada il nemico. Tuttavia, la foglia emana anche un aroma dolce, che calma il Pokémon avversario, creando un’atmosfera gradevole e rilassata tutt’attorno.",
        "de": "Im Kampf wedelt Endivie mit seinem Blatt, um den Feind fernzuhalten. Von dem Blatt geht auch ein süßlicher Duft aus, der das gegnerische Pokémon im Kampf beruhigt und eine gemütliche, freundliche Atmosphäre schafft.",
        "es": "Al luchar, Chikorita agita la hoja que tiene para mantener a raya al rival. Pero, al mismo tiempo, libera una suave fragancia que apacigua el encuentro y crea un ambiente agradable y de amistad.",
        "ko": "잎사귀를 휘둘러 상대를 위협하지만 잎사귀에서 달콤한 향기가 풍겨 나와 서로 온화한 분위기가 된다."
      },
      "abilities_data": [
        {
          "symbol": "intimidate",
          "textId": 22,
          "names": {
            "en": "Intimidate",
            "fr": "Intimidation",
            "it": "Prepotenza",
            "de": "Bedroher",
            "es": "Intimidación",
            "ko": "위협"
          },
          "descriptions": {
            "en": "The Pokémon intimidates opposing Pokémon upon entering battle, lowering their Attack stat.",
            "fr": "Le Pokémon rugit lorsqu’il arrive au combat, ce qui intimide l’ennemi et baisse son Attaque.",
            "it": "Quando il Pokémon entra in campo, la sua prepotenza intimidisce i nemici, riducendone l’Attacco.",
            "de": "Senkt den Angriff der Gegner, indem es sie gleich zu Kampfantritt bedroht und einschüchtert.",
            "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
            "ko": "등장했을 때 위협해서 상대를 위축시켜 상대의 공격을 떨어뜨린다."
          }
        },
        {
          "symbol": "strong_jaw",
          "textId": 173,
          "names": {
            "en": "Strong Jaw",
            "fr": "Prognathe",
            "it": "Ferromascella",
            "de": "Titankiefer",
            "es": "Mandíbula Fuerte",
            "ko": "옹골찬턱"
          },
          "descriptions": {
            "en": "The Pokémon’s strong jaw boosts the power of its biting moves.",
            "fr": "Le Pokémon a une mâchoire robuste qui augmente la puissance de ses capacités à base de morsures.",
            "it": "La robusta mascella del Pokémon permette morsi molto potenti.",
            "de": "Der kräftige Kiefer des Pokémon erhöht die Stärke von Biss-Attacken.",
            "es": "Su robusta mandíbula le confiere una mordedura potente.",
            "ko": "턱이 튼튼하여 무는 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "bloodthirst",
          "textId": 271,
          "names": {
            "en": "Bloodthirst",
            "fr": "Soif de Sang",
            "it": "Bloodthirst",
            "de": "Bloodthirst",
            "es": "Bloodthirst",
            "ko": "Bloodthirst"
          },
          "descriptions": {
            "en": "The Pokémon heals 25% of its HP for each KO caused by a biting attack.",
            "fr": "Le Pokémon soigne 25% de ses PV pour chaque KO causé par une attaque de morsure.",
            "it": "The Pokémon heals 25% of its HP for each KO caused by a biting attack.",
            "de": "The Pokémon heals 25% of its HP for each KO caused by a biting attack.",
            "es": "The Pokémon heals 25% of its HP for each KO caused by a biting attack.",
            "ko": "The Pokémon heals 25% of its HP for each KO caused by a biting attack."
          }
        }
      ],
