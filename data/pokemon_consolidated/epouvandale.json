      "names": {
        "en": "Scarestraw",
        "fr": "Épouvandale",
        "it": "Doduo",
        "de": "Dodu",
        "es": "Doduo",
        "ko": "두두"
      },
      "descriptions": {
        "en": "Inexplicably, the aura emanating from Scarestraw seems to repel bird Pokémon, which go out of their way to avoid approaching it.",
        "fr": "D'une manière inexplicable, l'aura émanant d'Épouvandale semble repousser les pokémon oiseaux, qui évitent à tout prix de s'en approcher.",
        "it": "Le due teste di Doduo contengono lo stesso identico cervello. Secondo uno studio scientifico sono stati riportati rari casi di Doduo con cervelli diversi.",
        "de": "Dodu hat zwei Köpfe mit absolut identischen Gehirnen. Eine wissenschaftliche Studie hat allerdings nachgewiesen, dass es auch Exemplare dieses Pokémon gibt, die zwei unterschiedliche Gehirne haben.",
        "es": "Doduo es un Pokémon bicéfalo de cerebros idénticos. Según un estudio científico, podría darse el extraño caso de que hubiera algún Doduo con cerebros distintos.",
        "ko": "두 개의 머리는 같은 뇌를 지녔다. 드물게 각각의 뇌를 지닌 두두가 태어난다는 연구 결과도 보고되었다."
      },
      "abilities_data": [
        {
          "symbol": "scare_birds",
          "textId": 269,
          "names": {
            "en": "Scare Birds",
            "fr": "Effraie Oiseaux",
            "it": "Scare Birds",
            "de": "Scare Birds",
            "es": "Scare Birds",
            "ko": "Scare Birds"
          },
          "descriptions": {
            "en": "The Pokémon scares birds, strongly dampening damage from Flying type moves and lowering a random statistic of the attacker",
            "fr": "Le Pokémon effraie les oiseaux, réduisant fortement les dégâts des attaques Vol et baissant une statistique aléatoire de l'attaquant.",
            "it": "",
            "de": "The Pokémon scares birds, strongly dampening damage from Flying type moves and lowering a random statistic of the attacker",
            "es": "The Pokémon scares birds, strongly dampening damage from Flying type moves and lowering a random statistic of the attacker",
            "ko": ""
          }
        },
        {
          "symbol": "inner_focus",
          "textId": 39,
          "names": {
            "en": "Inner Focus",
            "fr": "Attention",
            "it": "Forza Interiore",
            "de": "Konzentrator",
            "es": "Foco Interno",
            "ko": "정신력"
          },
          "descriptions": {
            "en": "The Pokémon’s intensely focused, and that protects the Pokémon from flinching.",
            "fr": "Le Pokémon a un mental à toute épreuve qui empêche les capacités ennemies de lui faire peur.",
            "it": "La capacità di concentrazione del Pokémon evita che tentenni per gli attacchi del nemico.",
            "de": "Verhindert durch erhöhte Konzentrationsfähigkeit Zurückschrecken.",
            "es": "Gracias a su profunda concentración, no se amedrenta ante los ataques del rival.",
            "ko": "단련한 정신으로 인하여 상대의 공격에 풀죽지 않는다."
          }
        },
        {
          "symbol": "sturdy",
          "textId": 5,
          "names": {
            "en": "Sturdy",
            "fr": "Fermeté",
            "it": "Vigore",
            "de": "Robustheit",
            "es": "Robustez",
            "ko": "옹골참"
          },
          "descriptions": {
            "en": "It cannot be knocked out with one hit. One-hit KO moves cannot knock it out, either.",
            "fr": "Le Pokémon encaisse toujours au moins une attaque s’il a tous ses PV. Il est également immunisé contre les capacités pouvant mettre K.O. en un coup.",
            "it": "Evita che il Pokémon vada KO in un sol colpo se ha tutti i PS, e lo rende immune alle mosse che causano KO immediato.",
            "de": "Bietet Schutz gegen K.O.-Attacken. Bei vollen KP übersteht das Pokémon auch K.O.-Treffer.",
            "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
            "ko": "상대 기술을 받아도 일격으로 쓰러지지 않는다. 일격필살 기술도 효과 없다."
          }
        }
      ],
