      "names": {
        "en": "Stormane",
        "fr": "Tempétigre",
        "it": "Xatu",
        "de": "Xatu",
        "es": "Xatu",
        "ko": "네이티오"
      },
      "descriptions": {
        "en": "Its thick fur stores air, which it can alter the temperature of to vary its altitude.",
        "fr": "Sa fourrure épaisse emmagasine de l'air dont il peut altérer la température afin de varier son altitude. ",
        "it": "Si dice che questo Pokémon abbia il potere di prevedere il futuro, ma non di cambiarlo.",
        "de": "Dieses Pokémon kann zwar angeblich die Zukunft voraussehen, aber seine Kräfte reichen nicht aus, um diese auch zu ändern.",
        "es": "Según se cree, este Pokémon posee el don de la clarividencia, pero carece del poder para alterar el futuro.",
        "ko": "미래를 예지하는 힘이 있지만, 미래를 바꿀 정도의 힘은 없다고 전해지는 포켓몬."
      },
      "abilities_data": [
        {
          "symbol": "gale_wings",
          "textId": 177,
          "names": {
            "en": "Gale Wings",
            "fr": "Ailes Bourrasque",
            "it": "Aliraffica",
            "de": "Orkanschwingen",
            "es": "Alas Vendaval",
            "ko": "질풍날개"
          },
          "descriptions": {
            "en": "Gives priority to Flying-type moves when the Pokémon’s HP is full.",
            "fr": "Quand les PV du Pokémon sont au maximum, ses capacités de type Vol sont prioritaires.",
            "it": "Se il Pokémon ha tutti i PS, le sue mosse di tipo Volante acquistano priorità alta.",
            "de": "Kann bei vollen KP einen Erstschlag mit Flug-Attacken ermöglichen.",
            "es": "Da prioridad a los movimientos de tipo Volador si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 비행타입의 기술을 먼저 쓸 수 있다."
          }
        },
        {
          "symbol": "berserk",
          "textId": 201,
          "names": {
            "en": "Berserk",
            "fr": "Dracolère",
            "it": "Furore",
            "de": "Wutausbruch",
            "es": "Cólera",
            "ko": "발끈"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Sp. Atk stat when it takes a hit that causes its HP to become half or less.",
            "fr": "Augmente l’Attaque Spéciale du Pokémon lorsqu’il tombe à la moitié de ses PV à cause d’une attaque.",
            "it": "Se i PS scendono a metà o meno a causa di un attacco, l’Attacco Speciale aumenta.",
            "de": "Fallen seine KP nach einem Angriff auf die Hälfte des Maximalwerts oder weniger, steigt sein Spezial-Angriff.",
            "es": "Aumenta su Ataque Especial si sus PS se ven reducidos a la mitad debido a algún ataque.",
            "ko": "상대의 공격으로 HP가 절반이 되면 특수공격이 올라간다."
          }
        },
        {
          "symbol": "wind_rider",
          "textId": 276,
          "names": {
            "en": "Aéroporté",
            "fr": "Aéroporté",
            "it": "Aéroporté",
            "de": "Aéroporté",
            "es": "Aéroporté",
            "ko": "Aéroporté"
          },
          "descriptions": {
            "en": "Boosts the Pokémon's Attack stat if Tailwind takes effect or if the Pokémon is hit by a wind move. The Pokémon also takes no damage from wind moves.",
            "fr": "L'Attaque du Pokémon augmente si un vent arrière souffle ou s'il est touché par une capacité faisant appel au vent. Dans ce dernier cas, il ne subit aucun dégât.",
            "it": "Boosts the Pokémon's Attack stat if Tailwind takes effect or if the Pokémon is hit by a wind move. The Pokémon also takes no damage from wind moves.",
            "de": "Boosts the Pokémon's Attack stat if Tailwind takes effect or if the Pokémon is hit by a wind move. The Pokémon also takes no damage from wind moves.",
            "es": "Boosts the Pokémon's Attack stat if Tailwind takes effect or if the Pokémon is hit by a wind move. The Pokémon also takes no damage from wind moves.",
            "ko": "Boosts the Pokémon's Attack stat if Tailwind takes effect or if the Pokémon is hit by a wind move. The Pokémon also takes no damage from wind moves."
          }
        }
