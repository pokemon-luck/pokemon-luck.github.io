      "names": {
        "en": "Plesioxic",
        "fr": "Plésioxic",
        "it": "Mr. Mime",
        "de": "Pantimos",
        "es": "Mr. Mime",
        "ko": "마임맨"
      },
      "descriptions": {
        "en": "The covering of corals and algae on Plesioxic's body is sometimes used by Squideep to take shelter.",
        "fr": "La couverture de coraux et d'algues sur le corps de Plésioxic sert de temps à autre aux Poulpoti pour se mettre à l'abri.",
        "it": "Con le sue eccezionali abilità di mimo incanta gli spettatori e, prima che se ne accorgano, crea dei muri in tutto e per tutto reali.",
        "de": "Sein Können als Pantomime ist verblüffend. Vor lauter Bewunderung merkt man gar nicht, wie plötzlich eine echte Wand vor einem erscheint.",
        "es": "Su talento para el mimo es tal que resulta cautivador, y llega a crear muros de verdad sin que quien lo observa se dé cuenta.",
        "ko": "팬터마임 실력이 굉장하다. 넋을 놓고 보다 보면 어느새 진짜 벽이 나타난다."
      },
      "abilities_data": [
        {
          "symbol": "damp",
          "textId": 6,
          "names": {
            "en": "Damp",
            "fr": "Moiteur",
            "it": "Umidità",
            "de": "Feuchtigkeit",
            "es": "Humedad",
            "ko": "습기"
          },
          "descriptions": {
            "en": "Prevents the use of explosive moves, such as Self-Destruct, by dampening its surroundings.",
            "fr": "Le Pokémon augmente l’humidité de l’air, ce qui empêche tous les Pokémon d’utiliser des capacités explosives telles que Destruction.",
            "it": "Aumenta l’umidità circostante, impedendo l’uso di Autodistruzione e di altre mosse esplosive.",
            "de": "Befeuchtet die Umgebung und verhindert so den Einsatz von Attacken wie Finale, die Explosionen auslösen.",
            "es": "Aumenta la humedad del entorno y evita que se puedan utilizar movimientos explosivos, tales como Autodestrucción.",
            "ko": "주변을 습하게 함으로써 자폭 등 폭발하는 기술을 아무도 못 쓰게 한다."
          }
        },
        {
          "symbol": "gooey",
          "textId": 183,
          "names": {
            "en": "Gooey",
            "fr": "Poisseux",
            "it": "Viscosità",
            "de": "Viskosität",
            "es": "Baba",
            "ko": "미끈미끈"
          },
          "descriptions": {
            "en": "Contact with the Pokémon lowers the attacker’s Speed stat.",
            "fr": "Baisse la Vitesse de l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, la Velocità di chi l’ha colpito diminuisce.",
            "de": "Senkt bei Berührung im Zuge eines Angriffs die Initiative des Angreifers.",
            "es": "Baja la Velocidad del rival cuando este le ataca con un movimiento de contacto.",
            "ko": "공격으로 자신과 접촉한 상대의 스피드를 떨어뜨린다."
          }
        },
        {
          "symbol": "liquid_ooze",
          "textId": 64,
          "names": {
            "en": "Liquid Ooze",
            "fr": "Suintement",
            "it": "Melma",
            "de": "Kloakensoße",
            "es": "Lodo Líquido",
            "ko": "해감액"
          },
          "descriptions": {
            "en": "The oozed liquid has a strong stench, which damages attackers using any draining move.",
            "fr": "Le Pokémon suinte un liquide toxique nauséabond qui blesse tous ceux qui tentent de voler ses PV.",
            "it": "Il Pokémon secerne delle sostanze tossiche. Se un nemico manda a segno una mossa che assorbe i PS, subisce dei danni.",
            "de": "Angreifer, die durch Saug-Attacken Kloakensoße in sich aufgenommen haben, nehmen durch deren widerwärtigen Gestank Schaden.",
            "es": "Exuda una sustancia tóxica de intenso hedor que hiere a quienes intentan drenarle PS.",
            "ko": "해감액을 흡수한 상대는 강렬한 악취로 데미지를 받아 HP가 줄어든다."
          }
        }
      ],
