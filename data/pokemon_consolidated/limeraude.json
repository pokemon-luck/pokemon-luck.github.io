      "names": {
        "en": "Dabrilliant",
        "fr": "Limeraude",
        "it": "Typhlosion",
        "de": "Tornupto",
        "es": "Typhlosion",
        "ko": "블레이범"
      },
      "descriptions": {
        "en": "Dabrilliant's species is said to be one of the oldest in Laemu. The longer a Dabrilliant lives, the more its hollow body fills with crystals of different colors.",
        "fr": "L'espèce de Limeraude serait l'une des plus anciennes de la région [région]. Plus un Limeraude a vécu, plus son corps creux se remplit de cristaux de différentes couleurs.",
        "it": "Typhlosion si nasconde avvolto da una lucente nube di calore creata dalle sue fiamme roventi. Questo Pokémon crea esplosioni spettacolari che riducono in cenere ogni cosa.",
        "de": "Tornupto versteckt sich hinter einem flimmernden Hitzeschild, den es mithilfe seiner heißen Flammen erzeugt. Dieses Pokémon erzeugt Explosionen, die alles in Schutt und Asche legen.",
        "es": "Typhlosion se oculta tras un trémulo haz de calor que crea mediante sus intensas y sofocantes llamaradas. Este Pokémon causa explosiones de fuego que reducen todo a cenizas.",
        "ko": "작열하는 불꽃으로 주변에 아지랑이를 만들어내서 모습을 숨길 수 있다. 불타오르며 폭발하는 바람은 모든 것을 태운다."
      },
      "abilities_data": [
        {
          "symbol": "water_absorb",
          "textId": 11,
          "names": {
            "en": "Water Absorb",
            "fr": "Absorbe-Eau",
            "it": "Assorbacqua",
            "de": "H2O-Absorber",
            "es": "Absorbe Agua",
            "ko": "저수"
          },
          "descriptions": {
            "en": "Restores HP if hit by a Water-type move instead of taking damage.",
            "fr": "Si le Pokémon est touché par une capacité Eau, il ne subit aucun dégât et regagne des PV à la place.",
            "it": "Se il Pokémon viene colpito da una mossa di tipo Acqua, recupera PS anziché subire danni.",
            "de": "Treffer durch Wasser-Attacken verursachen keinen Schaden, sondern regenerieren stattdessen KP.",
            "es": "Si le alcanza un movimiento de tipo Agua, recupera PS en vez de sufrir daño.",
            "ko": "물타입의 기술을 받으면 데미지를 받지 않고 회복한다."
          }
        },
        {
          "symbol": "sturdy",
          "textId": 5,
          "names": {
            "en": "Sturdy",
            "fr": "Fermeté",
            "it": "Vigore",
            "de": "Robustheit",
            "es": "Robustez",
            "ko": "옹골참"
          },
          "descriptions": {
            "en": "It cannot be knocked out with one hit. One-hit KO moves cannot knock it out, either.",
            "fr": "Le Pokémon encaisse toujours au moins une attaque s’il a tous ses PV. Il est également immunisé contre les capacités pouvant mettre K.O. en un coup.",
            "it": "Evita che il Pokémon vada KO in un sol colpo se ha tutti i PS, e lo rende immune alle mosse che causano KO immediato.",
            "de": "Bietet Schutz gegen K.O.-Attacken. Bei vollen KP übersteht das Pokémon auch K.O.-Treffer.",
            "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
            "ko": "상대 기술을 받아도 일격으로 쓰러지지 않는다. 일격필살 기술도 효과 없다."
          }
        },
        {
          "symbol": "storm_drain",
          "textId": 114,
          "names": {
            "en": "Storm Drain",
            "fr": "Lavabo",
            "it": "Acquascolo",
            "de": "Sturmsog",
            "es": "Colector",
            "ko": "마중물"
          },
          "descriptions": {
            "en": "Draws in all Water-type moves. Instead of being hit by Water-type moves, it boosts its Sp. Atk.",
            "fr": "Le Pokémon détourne sur lui les capacités de type Eau et les neutralise, tout en montant son Attaque Spéciale.",
            "it": "Il Pokémon attira e neutralizza le mosse di tipo Acqua e fa aumentare il proprio Attacco Speciale.",
            "de": "Zieht Wasser-Attacken an. Statt durch diese Schaden zu nehmen, erhöht es den eigenen Spezial-Angriff.",
            "es": "Atrae y neutraliza los movimientos de tipo Agua, que además le suben el Ataque Especial.",
            "ko": "물타입의 기술을 자신에게 끌어모아 데미지는 받지 않고 특수공격이 올라간다."
          }
        }
      ],
