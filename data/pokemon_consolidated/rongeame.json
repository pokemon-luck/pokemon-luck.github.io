      "names": {
        "en": "Spirat",
        "fr": "Ragonie",
        "it": "Meowth",
        "de": "Mauzi",
        "es": "Meowth",
        "ko": "나옹"
      },
      "descriptions": {
        "en": "Researchers believe that Spirat is the ghost of a Rattata.",
        "fr": "Les chercheurs pensent que Ragonie serait le fantôme d'un Rattata.",
        "it": "Nelle discariche capita di vederlo lottare furiosamente con Murkrow per gli oggetti luccicanti.",
        "de": "Auf Müllhalden wird man oft Zeuge davon, wie es sich einen heftigen Streit mit Kramurx um glänzende Gegenstände liefert.",
        "es": "No es extraño encontrarlos en los vertederos, donde suelen pelearse con los Murkrow por cualquier objeto reluciente.",
        "ko": "쓰레기장에 가면 빛이 나는 물건을 두고 니로우와 격렬하게 싸우는 광경을 볼 수 있다."
      },
      "abilities_data": [
        {
          "symbol": "pickup",
          "textId": 53,
          "names": {
            "en": "Pickup",
            "fr": "Ramassage",
            "it": "Raccolta",
            "de": "Mitnahme",
            "es": "Recogida",
            "ko": "픽업"
          },
          "descriptions": {
            "en": "The Pokémon may pick up the item an opposing Pokémon used during a battle. It may pick up items outside of battle, too.",
            "fr": "Permet parfois au Pokémon de ramasser les objets que ses ennemis ont utilisés. Il lui arrive aussi d’en trouver hors des combats.",
            "it": "Il Pokémon può raccogliere lo strumento usato da un nemico durante la lotta. A volte potrebbe raccogliere strumenti anche fuori dalla lotta.",
            "de": "Hebt gelegentlich von Gegnern benutzte Items auf. Dies geschieht nicht nur während Kämpfen, sondern auch unterwegs.",
            "es": "Puede recoger objetos que el rival haya usado, o bien otros que encuentre en plena aventura.",
            "ko": "상대가 사용한 도구를 주워올 때가 있다. 모험 중에도 주워온다."
          }
        },
        {
          "symbol": "infiltrator",
          "textId": 151,
          "names": {
            "en": "Infiltrator",
            "fr": "Infiltration",
            "it": "Intrapasso",
            "de": "Schwebedurch",
            "es": "Allanamiento",
            "ko": "틈새포착"
          },
          "descriptions": {
            "en": "Passes through the opposing Pokémon’s barrier, substitute, and the like and strikes.",
            "fr": "Traverse les barrières et les clones de l’ennemi pour attaquer directement.",
            "it": "Il Pokémon attacca evitando le barriere e il sostituto del nemico.",
            "de": "Überwindet gegnerische Schilde sowie Delegatoren und greift an.",
            "es": "Ataca sorteando la barrera o el sustituto del rival.",
            "ko": "상대의 벽이나 대타출동을 뚫고 공격할 수 있다."
          }
        },
        {
          "symbol": "rattled",
          "textId": 155,
          "names": {
            "en": "Rattled",
            "fr": "Phobique",
            "it": "Paura",
            "de": "Hasenfuß",
            "es": "Cobardía",
            "ko": "주눅"
          },
          "descriptions": {
            "en": "Dark-, Ghost-, and Bug-type moves scare the Pokémon and boost its Speed stat.",
            "fr": "Si le Pokémon est touché par une capacité de type Ténèbres, Spectre ou Insecte, sa phobie se révèle et sa Vitesse augmente.",
            "it": "Le mosse di tipo Buio, Spettro e Coleottero spaventano il Pokémon aumentandone la Velocità.",
            "de": "Wird es von einer Unlicht-, Geister- oder Käfer-Attacke getroffen, bekommt es Angst und seine Initiative steigt.",
            "es": "Si le alcanza un movimiento de tipo Siniestro, Bicho o Fantasma, el miedo hace que le suba la Velocidad.",
            "ko": "악타입과 고스트타입과 벌레타입의 기술을 받으면 주눅이 들어 스피드가 올라간다."
          }
        }
      ],
