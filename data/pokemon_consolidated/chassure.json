      "names": {
        "en": "Sheow",
        "fr": "Chassure",
        "it": "Hitmonchan",
        "de": "Nockchan",
        "es": "Hitmonchan",
        "ko": "홍수몬"
      },
      "descriptions": {
        "en": "All the items that Sheow steals, it hides at the bottom of its boot.",
        "fr": "Tous les objets que dérobe Chassure, il les cache au fond de sa botte.",
        "it": "Si dice che Hitmonchan abbia l’animo di un pugile destinato a partecipare al campionato mondiale. Questo Pokémon ha uno spirito indomito e non demorde mai di fronte alle avversità.",
        "de": "Nockchan besitzt das Herz eines Boxers, der sich auf eine Weltmeisterschaft vorbereitet. Dieses Pokémon hat einen unbeugsamen Willen und gibt niemals auf.",
        "es": "Dicen que Hitmonchan tiene el mismo ímpetu que un boxeador entrenándose para un campeonato mundial. Este Pokémon tiene un espíritu indomable que nunca se doblega ante la adversidad.",
        "ko": "세계 챔피언을 목표했던 복서의 혼이 깃들었다고 하는 홍수몬은 불굴의 정신으로 절대 지쳐 쓰러지지 않는다."
      },
      "abilities_data": [
        {
          "symbol": "inner_focus",
          "textId": 39,
          "names": {
            "en": "Inner Focus",
            "fr": "Attention",
            "it": "Forza Interiore",
            "de": "Konzentrator",
            "es": "Foco Interno",
            "ko": "정신력"
          },
          "descriptions": {
            "en": "The Pokémon’s intensely focused, and that protects the Pokémon from flinching.",
            "fr": "Le Pokémon a un mental à toute épreuve qui empêche les capacités ennemies de lui faire peur.",
            "it": "La capacità di concentrazione del Pokémon evita che tentenni per gli attacchi del nemico.",
            "de": "Verhindert durch erhöhte Konzentrationsfähigkeit Zurückschrecken.",
            "es": "Gracias a su profunda concentración, no se amedrenta ante los ataques del rival.",
            "ko": "단련한 정신으로 인하여 상대의 공격에 풀죽지 않는다."
          }
        },
        {
          "symbol": "limber",
          "textId": 7,
          "names": {
            "en": "Limber",
            "fr": "Échauffement",
            "it": "Scioltezza",
            "de": "Flexibilität",
            "es": "Flexibilidad",
            "ko": "유연"
          },
          "descriptions": {
            "en": "Its limber body protects the Pokémon from paralysis.",
            "fr": "Le Pokémon s’est suffisamment échauffé, ce qui l’immunise contre la paralysie.",
            "it": "Il corpo flessibile del Pokémon gli impedisce di subire gli effetti della paralisi.",
            "de": "Der flexible Körper des Pokémon schützt es vor Paralyse.",
            "es": "Evita ser paralizado gracias a la flexibilidad de su cuerpo.",
            "ko": "유연한 몸으로 인해 마비 상태가 되지 않는다."
          }
        },
        {
          "symbol": "steadfast",
          "textId": 80,
          "names": {
            "en": "Steadfast",
            "fr": "Impassible",
            "it": "Cuordeciso",
            "de": "Felsenfest",
            "es": "Impasible",
            "ko": "불굴의마음"
          },
          "descriptions": {
            "en": "The Pokémon’s determination boosts the Speed stat each time the Pokémon flinches.",
            "fr": "Augmente la Vitesse du Pokémon quand il a peur.",
            "it": "Se il Pokémon tentenna, il suo animo indomito si risveglia e la sua Velocità aumenta.",
            "de": "Sein eiserner Wille erhöht die Initiative, wann immer das Pokémon zurückschreckt.",
            "es": "Cada vez que se amedrenta sube su Velocidad, debido a su voluntad inquebrantable.",
            "ko": "풀죽을 때마다 불굴의 마음을 불태워 스피드가 올라간다."
          }
        }
      ],
