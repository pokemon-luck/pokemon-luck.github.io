      "names": {
        "en": "Cromagma",
        "fr": "Cromagma",
        "it": "Swampert",
        "de": "Sumpex",
        "es": "Swampert",
        "ko": "대짱이"
      },
      "descriptions": {
        "en": "The discovery of Cromagma has reignited the debate over the link that may exist between humans and Pokémon.",
        "fr": "La découverte de Cromagma relance les débats sur le lien qui existerait entre humains et pokémon.",
        "it": "Swampert prevede le tempeste poiché grazie alle pinne percepisce le sottili differenze nel suono delle onde e dei venti dovuti alle maree. In caso di burrasca imminente, crea delle pile di massi per proteggere la tana.",
        "de": "Sumpex kann Stürme voraussagen, indem es feine Veränderungen der Geräusche von Wellen und Wind mit seinen Flossen wahrnimmt. Wenn eine Sturmfront aufzieht, häuft es Felsbrocken an, um sich zu schützen.",
        "es": "Swampert puede predecir tormentas al percibir con las aletas los sutiles cambios que producen las olas y las corrientes. Si está a punto de estallar una tormenta, empezará a apilar piedras para resguardarse.",
        "ko": "대짱이는 파도 소리나 바닷바람의 아주 작은 차이를 지느러미로 감지하여 태풍을 예감한다. 태풍이 불면 바위를 쌓아서 둥지를 지킨다."
      },
      "abilities_data": [
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        },
        {
          "symbol": "reckless",
          "textId": 120,
          "names": {
            "en": "Reckless",
            "fr": "Téméraire",
            "it": "Temerarietà",
            "de": "Achtlos",
            "es": "Audaz",
            "ko": "이판사판"
          },
          "descriptions": {
            "en": "Powers up moves that have recoil damage.",
            "fr": "Augmente la puissance des capacités occasionnant un contrecoup.",
            "it": "Potenzia le mosse che causano contraccolpo.",
            "de": "Erhöht die Stärke von Attacken mit Rückstoßschaden.",
            "es": "Potencia los movimientos que también dañan al usuario.",
            "ko": "반동 데미지를 받는 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "anger_point",
          "textId": 83,
          "names": {
            "en": "Anger Point",
            "fr": "Colérique",
            "it": "Grancollera",
            "de": "Kurzschluss",
            "es": "Irascible",
            "ko": "분노의경혈"
          },
          "descriptions": {
            "en": "The Pokémon is angered when it takes a critical hit, and that maxes its Attack stat.",
            "fr": "Si le Pokémon subit un coup critique, il entre dans une colère noire qui augmente son Attaque au maximum.",
            "it": "Se il Pokémon subisce un brutto colpo, monta su tutte le furie e il suo Attacco aumenta al massimo.",
            "de": "Wird nach Einstecken eines Volltreffers wütend und maximiert dabei seinen Angriffs-Wert.",
            "es": "Si recibe un golpe crítico, monta en cólera y sube su Ataque hasta el máximo.",
            "ko": "급소에 공격이 맞으면 크게 분노해 공격력이 최대가 된다."
          }
        }
      ],
