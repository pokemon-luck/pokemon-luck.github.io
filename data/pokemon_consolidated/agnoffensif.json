      "names": {
        "en": "Lambattle",
        "fr": "Agnoffensif",
        "it": "Beedrill",
        "de": "Bibor",
        "es": "Beedrill",
        "ko": "독침붕"
      },
      "descriptions": {
        "en": "No one can resist the charm and sweetness of this Pokémon, nor even the strength of its hooves.",
        "fr": "Personne ne peut résister au charme et à la douceur de ce pokémon, ni même à la force de ses sabots.",
        "it": "Beedrill difende strenuamente il proprio territorio. Per ragioni di sicurezza nessuno può avvicinarsi al suo nido. Se vengono disturbati, questi Pokémon attaccano violentemente in sciami.",
        "de": "Bibor ist sehr wehrhaft. Es sollte sich besser niemand seinem Nest nähern. Wenn man sie ärgert, greifen sie in Schwärmen an.",
        "es": "Los Beedrill defienden su territorio a toda costa. No es conveniente acercarse a su colmena, por seguridad. Si se les molesta, todo un enjambre atacará ferozmente.",
        "ko": "영역에 대한 집착이 매우 강해서 독침붕이 사는 곳에는 가까이 가지 않는 것이 신상에 좋다. 화나면 집단으로 습격해 온다."
      },
      "abilities_data": [
        {
          "symbol": "vital_spirit",
          "textId": 72,
          "names": {
            "en": "Vital Spirit",
            "fr": "Esprit Vital",
            "it": "Spiritovivo",
            "de": "Munterkeit",
            "es": "Espíritu Vital",
            "ko": "의기양양"
          },
          "descriptions": {
            "en": "The Pokémon is full of vitality, and that prevents it from falling asleep.",
            "fr": "Empêche le Pokémon de s’endormir.",
            "it": "Il Pokémon è talmente vivace che non può addormentarsi.",
            "de": "Das Pokémon ist so munter, dass es nicht einschlafen kann.",
            "es": "Su determinación le impide quedarse dormido.",
            "ko": "의기양양해져서 잠듦 상태가 되지 않는다."
          }
        },
        {
          "symbol": "fluffy",
          "textId": 218,
          "names": {
            "en": "Fluffy",
            "fr": "Boule de Poils",
            "it": "Morbidone",
            "de": "Flauschigkeit",
            "es": "Peluche",
            "ko": "복슬복슬"
          },
          "descriptions": {
            "en": "Halves the damage taken from moves that make direct contact, but doubles that of Fire-type moves.",
            "fr": "Divise par deux les dégâts des attaques directes subies par le Pokémon, mais double les dégâts des capacités de type Feu.",
            "it": "Dimezza il danno causato dagli attacchi diretti di un nemico, ma raddoppia quello subito dalle mosse di tipo Fuoco.",
            "de": "Halbiert den Schaden, den es durch direkte Attacken nimmt, aber verdoppelt dafür den durch Feuer-Attacken erlittenen Schaden.",
            "es": "Reduce a la mitad el daño provocado por los movimientos de contacto, pero duplica el infligido por los de tipo Fuego.",
            "ko": "상대로부터 받은 접촉하는 기술의 데미지를 반감시키지만 불꽃타입 기술의 데미지는 2배가 된다."
          }
        },
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        }
      ],
