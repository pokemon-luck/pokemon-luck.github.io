      "names": {
        "en": "Kidung",
        "fr": "Spherabé",
        "it": "Clefairy",
        "de": "Piepi",
        "es": "Clefairy",
        "ko": "삐삐"
      },
      "descriptions": {
        "en": "It collects food that it protects with a layer of mud.",
        "fr": "Il collecte de la nourriture qu'il protège d'une couche de boue.",
        "it": "Questo Pokémon molto popolare è piuttosto raro e prezioso. È meglio evitare di metterlo troppo in mostra, o si corre il rischio di farselo rubare.",
        "de": "Dieses beliebte Pokémon hat Seltenheitswert. Wer leichtsinnig damit prahlt, eins zu haben, könnte in das Visier von Dieben geraten.",
        "es": "Es muy popular y la escasez de ejemplares lo hace muy valioso. Quien presume mucho de tener uno se arriesga a que se lo roben.",
        "ko": "인기가 있지만, 개체 수가 적어 귀하다. 함부로 자랑하다가는 도둑의 타깃이 된다."
      },
      "abilities_data": [
        {
          "symbol": "shell_armor",
          "textId": 75,
          "names": {
            "en": "Shell Armor",
            "fr": "Coque Armure",
            "it": "Guscioscudo",
            "de": "Panzerhaut",
            "es": "Caparazón",
            "ko": "조가비갑옷"
          },
          "descriptions": {
            "en": "A hard shell protects the Pokémon from critical hits.",
            "fr": "Le Pokémon est protégé des coups critiques par sa carapace.",
            "it": "Il Pokémon è protetto da un guscio robusto che gli evita di subire brutti colpi.",
            "de": "Wehrt gegnerische Volltreffer mit einem harten Panzer ab.",
            "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
            "ko": "단단한 껍질의 보호를 받아 상대의 공격이 급소에 맞지 않는다."
          }
        },
        {
          "symbol": "rough_skin",
          "textId": 24,
          "names": {
            "en": "Rough Skin",
            "fr": "Peau Dure",
            "it": "Cartavetro",
            "de": "Rauhaut",
            "es": "Piel Tosca",
            "ko": "까칠한피부"
          },
          "descriptions": {
            "en": "This Pokémon inflicts damage with its rough skin to the attacker on contact.",
            "fr": "Blesse l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon è colpito da un attacco diretto, grazie alla sua pelle ruvida infligge danni a sua volta.",
            "de": "Angreifer werden durch die raue Haut des Pokémon bei direkten Attacken verletzt.",
            "es": "Hiere con su piel áspera al rival que lo ataque con un movimiento de contacto.",
            "ko": "공격을 받았을 때 자신에게 접촉한 상대를 까칠까칠한 피부로 상처를 입힌다."
          }
        },
        {
          "symbol": "solid_rock",
          "textId": 116,
          "names": {
            "en": "Solid Rock",
            "fr": "Solide Roc",
            "it": "Solidroccia",
            "de": "Felskern",
            "es": "Roca Sólida",
            "ko": "하드록"
          },
          "descriptions": {
            "en": "Reduces the power of supereffective attacks taken.",
            "fr": "Réduit les dégâts subis lorsque le Pokémon est touché par une capacité super efficace.",
            "it": "Riduce i danni subiti dalle mosse superefficaci.",
            "de": "Reduziert die Stärke von sehr effektiven Attacken und verringert damit den Schaden, den das Pokémon durch sie erleidet.",
            "es": "Mitiga el daño que le infligen los movimientos supereficaces.",
            "ko": "효과가 굉장한 공격의 위력을 약하게 만든다."
          }
        }
      ],
