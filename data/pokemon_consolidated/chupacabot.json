      "names": {
        "en": "Chupacanine",
        "fr": "Chupacabot",
        "it": "Politoed",
        "de": "Quaxo",
        "es": "Politoed",
        "ko": "왕구리"
      },
      "descriptions": {
        "en": "When a stick is thrown to a Chupacanine, it is not uncommon for it to bring back a Doggorible bone instead.",
        "fr": "Lorsqu'un bâton est lancé à un Chupacabot, il n'est pas rare qu'il ramène à la place un os de Clebzombi.",
        "it": "Nonostante emetta un verso chiassoso, un compositore si è ispirato alle sue grida per scrivere delle splendide ballate.",
        "de": "Sein Ruf mag zwar wie Gebrüll klingen, doch ein Komponist ließ sich von ihm zu einer traumhaften Ballade inspirieren.",
        "es": "A pesar de lo discordante de sus gritos, un autor se inspiró en ellos para componer una hermosa balada.",
        "ko": "고함치는 듯한 울음소리임에도 어느 작곡가는 영향을 받아 아름다운 발라드를 만들었다."
      },
      "abilities_data": [
        {
          "symbol": "stakeout",
          "textId": 198,
          "names": {
            "en": "Stakeout",
            "fr": "Filature",
            "it": "Sorveglianza",
            "de": "Beschattung",
            "es": "Vigilante",
            "ko": "잠복"
          },
          "descriptions": {
            "en": "Doubles the damage dealt to the target’s replacement if the target switches out.",
            "fr": "Lorsque le Pokémon attaque une cible qui vient d’entrer sur le terrain en remplacement d’un autre Pokémon, les dégâts infligés sont doublés.",
            "it": "Raddoppia i danni inflitti a un bersaglio che è appena entrato in campo per sostituire un altro Pokémon.",
            "de": "Bewirkt bei Angriffen auf neu eingewechselte Ziele doppelten Schaden.",
            "es": "Si el objetivo de su ataque es sustituido por otro, duplica el daño que infligirá.",
            "ko": "교체로 나온 상대에게 2배 데미지로 공격할 수 있다."
          }
        },
        {
          "symbol": "corrosion",
          "textId": 212,
          "names": {
            "en": "Corrosion",
            "fr": "Corrosion",
            "it": "Corrosione",
            "de": "Korrosion",
            "es": "Corrosión",
            "ko": "부식"
          },
          "descriptions": {
            "en": "The Pokémon can poison the target even if it’s a Steel or Poison type.",
            "fr": "Permet d’empoisonner les Pokémon de type Acier ou Poison.",
            "it": "Il Pokémon è in grado di avvelenare il bersaglio anche se questo è di tipo Acciaio o Veleno.",
            "de": "Kann selbst Pokémon vom Typ Stahl oder Gift vergiften.",
            "es": "Puede envenenar incluso a rivales de tipo Acero o Veneno.",
            "ko": "강철타입이나 독타입도 독 상태로 만들 수 있다."
          }
        },
        {
          "symbol": "venomous_aura",
          "textId": 279,
          "names": {
            "en": "Venomous Aura",
            "fr": "Aura Venimeuse",
            "it": "Aura Venimeuse",
            "de": "Aura Venimeuse",
            "es": "Aura Venimeuse",
            "ko": "Aura Venimeuse"
          },
          "descriptions": {
            "en": "All contact moves have a 25% chance to badly poison the target.",
            "fr": "Toutes les attaques physiques ont 25% de chances d'empoisonner gravement la cible.",
            "it": "Toutes les attaques physiques ont 25% de chances d'empoisonner gravement la cible.",
            "de": "Toutes les attaques physiques ont 25% de chances d'empoisonner gravement la cible.",
