      "names": {
        "en": "Kidive",
        "fr": "Bicrachin",
        "it": "Celebi",
        "de": "Celebi",
        "es": "Celebi",
        "ko": "세레비"
      },
      "descriptions": {
        "en": "This Pokémon came from the future by crossing over time. It is thought that so long as Celebi appears, a bright and shining future awaits us.",
        "fr": "",
        "it": "Celebi è giunto a noi dal futuro, viaggiando attraverso il tempo. Si dice che ogni sua apparizione preannunci un futuro roseo e splendente.",
        "de": "Dieses Pokémon kommt aus der Zukunft und ist durch die Zeit gereist. Solange Celebi auftaucht, ist der Menschheit angeblich eine rosige Zukunft beschieden.",
        "es": "Este Pokémon vino del futuro haciendo un viaje en el tiempo. Hay quien piensa que, mientras Celebi siga apareciendo, hay un futuro brillante y esperanzador.",
        "ko": "시간을 넘어 미래에서 찾아온 포켓몬이다. 세레비가 모습을 나타내는 한 밝은 미래가 기다린다고 여겨지고 있다."
      },
      "abilities_data": [
        {
          "symbol": "torrent",
          "textId": 67,
          "names": {
            "en": "Torrent",
            "fr": "Torrent",
            "it": "Acquaiuto",
            "de": "Sturzbach",
            "es": "Torrente",
            "ko": "급류"
          },
          "descriptions": {
            "en": "Powers up Water-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Eau du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Acqua aumenta.",
            "de": "Erhöht die Stärke von Wasser-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Agua cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 물타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "water_veil",
          "textId": 41,
          "names": {
            "en": "Water Veil",
            "fr": "Ignifu-Voile",
            "it": "Idrovelo",
            "de": "Aquahülle",
            "es": "Velo Agua",
            "ko": "수의베일"
          },
          "descriptions": {
            "en": "The Pokémon is covered with a water veil, which prevents the Pokémon from getting a burn.",
            "fr": "Le voile qui recouvre le Pokémon le protège des brûlures.",
            "it": "Un velo d’acqua riveste il corpo del Pokémon impedendogli di venire scottato.",
            "de": "Verhindert durch eine Hülle aus Wasser Verbrennungen.",
            "es": "Evita las quemaduras gracias a la capa de agua que lo envuelve.",
            "ko": "물의 베일을 몸에 둘러서 화상 상태가 되지 않는다."
          }
        },
        {
          "symbol": "sap_sipper",
          "textId": 157,
          "names": {
            "en": "Sap Sipper",
            "fr": "Herbivore",
            "it": "Mangiaerba",
            "de": "Vegetarier",
            "es": "Herbívoro",
            "ko": "초식"
          },
          "descriptions": {
            "en": "Boosts the Attack stat if hit by a Grass-type move instead of taking damage.",
            "fr": "Annule les attaques de type Plante subies par le Pokémon et augmente son Attaque.",
            "it": "Se il Pokémon viene colpito da una mossa di tipo Erba, la neutralizza e aumenta il proprio Attacco.",
            "de": "Wird es von einer Pflanzen-Attacke getroffen, erleidet es keinerlei Schaden und sein Angriff steigt.",
            "es": "Neutraliza los movimientos de tipo Planta y sube su Ataque.",
            "ko": "풀타입 기술을 받으면 데미지를 입지 않고 공격이 올라간다."
          }
        }
      ],
