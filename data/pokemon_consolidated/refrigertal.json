      "names": {
        "en": "Neanderthaw",
        "fr": "Réfrigertal",
        "it": "Poochyena",
        "de": "Fiffyen",
        "es": "Poochyena",
        "ko": "포챠나"
      },
      "descriptions": {
        "en": "More and more researchers are trying to prove that humans and Neanderthaw share a common ancestor.",
        "fr": "De plus en plus de chercheurs tentent de prouver que l'être humain et les Réfrigertal auraient un ancêtre commun.",
        "it": "Poochyena è onnivoro: mangia di tutto. Una caratteristica distintiva è la dimensione delle zanne rispetto al corpo. Cerca di intimidire i nemici rizzando il pelo della coda.",
        "de": "Fiffyen ist ein Allesfresser. Auffällig an diesem Pokémon ist das Verhältnis seiner Körpergröße zur Länge seiner Zähne. Es versucht Feinde einzuschüchtern, indem es die Haare an seinem Schweif abstehen lässt.",
        "es": "Poochyena es un Pokémon omnívoro. Se come lo que sea. Le caracteriza el gran tamaño de sus colmillos respecto al resto del cuerpo. Este Pokémon hace que se le erice la cola para intentar intimidar a su rival.",
        "ko": "무엇이든 먹는 잡식성인 포켓몬이다. 몸에 비해 큰 이빨이 특징이다. 꼬리의 털을 세우고 적을 위협한다."
      },
      "abilities_data": [
        {
          "symbol": "moxie",
          "textId": 153,
          "names": {
            "en": "Moxie",
            "fr": "Impudence",
            "it": "Arroganza",
            "de": "Hochmut",
            "es": "Autoestima",
            "ko": "자기과신"
          },
          "descriptions": {
            "en": "The Pokémon shows moxie, and that boosts the Attack stat after knocking out any Pokémon.",
            "fr": "Quand le Pokémon met un ennemi K.O., sa confiance en lui ne connaît plus de limite et son Attaque augmente.",
            "it": "Quando manda un nemico KO, il Pokémon si fa sicuro di sé e aumenta il proprio Attacco.",
            "de": "Besiegt es ein Pokémon, steigt sein Selbstvertrauen und somit auch sein Angriff.",
            "es": "Al debilitar a un objetivo, su confianza se refuerza de tal manera que aumenta su Ataque.",
            "ko": "상대를 쓰러뜨리면 자신감이 붙어서 공격이 올라간다."
          }
        },
        {
          "symbol": "slush_rush",
          "textId": 202,
          "names": {
            "en": "Slush Rush",
            "fr": "Chasse-Neige",
            "it": "Spalaneve",
            "de": "Schneescharrer",
            "es": "Quitanieves",
            "ko": "눈치우기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in a hailstorm.",
            "fr": "Augmente la Vitesse du Pokémon quand il grêle.",
            "it": "Se grandina, la Velocità aumenta.",
            "de": "Erhöht bei Hagel die Initiative.",
            "es": "Aumenta su Velocidad si está granizando.",
            "ko": "날씨가 싸라기눈일 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "long_reach",
          "textId": 203,
          "names": {
            "en": "Long Reach",
            "fr": "Longue Portée",
            "it": "Distacco",
            "de": "Langstrecke",
            "es": "Remoto",
            "ko": "원격"
          },
          "descriptions": {
            "en": "The Pokémon uses its moves without making contact with the target.",
            "fr": "Le Pokémon est capable d’utiliser toutes ses capacités sans entrer en contact direct avec sa cible.",
            "it": "Il Pokémon è in grado di usare tutte le sue mosse senza entrare in contatto diretto con il bersaglio.",
            "de": "Ermöglicht dem Pokémon den Einsatz aller seiner Attacken, ohne das Ziel dabei direkt zu berühren.",
            "es": "Puede usar cualquier movimiento sin entrar en contacto con el rival.",
            "ko": "모든 기술을 상대에게 접촉하지 않고 사용할 수 있다."
          }
        }
      ],
