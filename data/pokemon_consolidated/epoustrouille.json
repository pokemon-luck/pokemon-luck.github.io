      "names": {
        "en": "Gourdamn",
        "fr": "Époustrouille",
        "it": "Muk",
        "de": "Sleimok",
        "es": "Muk",
        "ko": "질뻐기"
      },
      "descriptions": {
        "en": "Gourdamn forms a body with roots and leaves to appear more imposing. This plant skeleton gives it the ability to defend itself against anyone who would attack its pumpkin.",
        "fr": "Époustrouille se constitue un corps avec des racines et des feuilles de manière à paraitre plus imposant. Ce squelette végétal lui offre la possibilité de se défendre contre quiconque s'en prendrait à sa citrouille.",
        "it": "Il loro numero è calato drasticamente a causa della mancanza di cibo. Per evitarne l’estinzione, sono state create pozze di liquami artificiali.",
        "de": "Aufgrund von Futtermangel sieht man es immer seltener. Um es vom Aussterben zu bewahren, werden nun künstliche Schlammteiche angelegt.",
        "es": "Su número ha disminuido por falta de sustento, por lo que se han creado estanques de lodo artificiales para salvarlo de la extinción.",
        "ko": "먹이가 줄어들어 개체 수가 격감했다. 멸종을 방지하기 위해  인공 진흙 연못을 만들기 시작했다."
      },
      "abilities_data": [
        {
          "symbol": "chlorophyll",
          "textId": 34,
          "names": {
            "en": "Chlorophyll",
            "fr": "Chlorophylle",
            "it": "Clorofilla",
            "de": "Chlorophyll",
            "es": "Clorofila",
            "ko": "엽록소"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in harsh sunlight.",
            "fr": "Augmente la Vitesse du Pokémon s’il y a du soleil.",
            "it": "Se la luce del sole è intensa, la Velocità aumenta.",
            "de": "Erhöht bei Sonnenschein die Initiative.",
            "es": "Sube su Velocidad cuando hace sol.",
            "ko": "날씨가 맑을 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "flash_fire",
          "textId": 18,
          "names": {
            "en": "Flash Fire",
            "fr": "Torche",
            "it": "Fuocardore",
            "de": "Feuerfänger",
            "es": "Absorbe Fuego",
            "ko": "타오르는불꽃"
          },
          "descriptions": {
            "en": "Powers up the Pokémon’s Fire-type moves if it’s hit by one.",
            "fr": "Lorsque le Pokémon est touché par une capacité de type Feu, il absorbe la chaleur pour renforcer ses propres capacités Feu.",
            "it": "Se il Pokémon subisce una mossa di tipo Fuoco, ne sfrutta il calore per potenziare le proprie mosse dello stesso tipo.",
            "de": "Verstärkt Feuer-Attacken, wenn es von Feuer-Attacken getroffen wird.",
            "es": "Si le alcanza algún movimiento de tipo Fuego, potencia sus propios movimientos de dicho tipo.",
            "ko": "불꽃타입의 기술을 받으면 불꽃을 받아서 자신이 사용하는 불꽃타입의 기술이 강해진다."
          }
        },
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        }
      ],
