      "names": {
        "en": "Paddurtle",
        "fr": "Torténuphar",
        "it": "Mudkip",
        "de": "Hydropi",
        "es": "Mudkip",
        "ko": "물짱이"
      },
      "descriptions": {
        "en": "Indistinguishable from a real lily pad when motionless, Paddurtle feeds on Bug-type Pokémon that inadvertently land on its back.",
        "fr": "Indiscernable d'un véritable nénuphar quand il est immobile, Torténuphar se nourrit des pokémon insectes se posant par mégarde sur son dos.",
        "it": "In acqua Mudkip respira usando le branchie sulle mascelle. In caso di situazioni critiche nella lotta scatena la sua forza strabiliante, riuscendo a frantumare rocce più grandi di lui.",
        "de": "Im Wasser atmet Hydropi durch die Kiemen an seinen Wangen. Wenn es im Kampf in eine brenzlige Situation gerät, setzt es seine verblüffende Kraft ein, mit der es Felsbrocken zerquetschen kann, die größer sind als es selbst.",
        "es": "En el agua, Mudkip usa las branquias que tiene en los mofletes para respirar. Cuando tiene que enfrentarse a una situación delicada en combate, desata una fuerza asombrosa con la que puede destruir rocas incluso mayores que él.",
        "ko": "물속에서는 뺨의 아가미로 호흡한다. 위급해지면 몸보다 큰 바위를 산산이 부숴버리는 파워를 발휘한다."
      },
      "abilities_data": [
        {
          "symbol": "effect_spore",
          "textId": 27,
          "names": {
            "en": "Effect Spore",
            "fr": "Pose Spore",
            "it": "Spargispora",
            "de": "Sporenwirt",
            "es": "Efecto Espora",
            "ko": "포자"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may inflict poison, sleep, or paralysis on its attacker.",
            "fr": "Peut paralyser, empoisonner ou endormir l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare avvelenamento, paralisi o sonno a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, kann das beim Gegner Paralyse, Vergiftung oder Schlaf auslösen.",
            "es": "Puede dormir, envenenar o paralizar al Pokémon con el que entre en contacto al recibir un ataque.",
            "ko": "공격으로 자신에게 접촉한 상대를 독이나 마비, 잠듦 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "rain_dish",
          "textId": 44,
          "names": {
            "en": "Rain Dish",
            "fr": "Cuvette",
            "it": "Copripioggia",
            "de": "Regengenuss",
            "es": "Cura Lluvia",
            "ko": "젖은접시"
          },
          "descriptions": {
            "en": "The Pokémon gradually regains HP in rain.",
            "fr": "Le Pokémon récupère progressivement des PV lorsqu’il pleut.",
            "it": "Il Pokémon recupera PS quando piove.",
            "de": "Regeneriert bei Regen nach und nach KP.",
            "es": "Recupera PS de forma gradual cuando llueve.",
            "ko": "비가 오는 날씨일 때 조금씩 HP를 회복한다."
          }
        },
        {
          "symbol": "liquid_ooze",
          "textId": 64,
          "names": {
            "en": "Liquid Ooze",
            "fr": "Suintement",
            "it": "Melma",
            "de": "Kloakensoße",
            "es": "Lodo Líquido",
            "ko": "해감액"
          },
          "descriptions": {
            "en": "The oozed liquid has a strong stench, which damages attackers using any draining move.",
            "fr": "Le Pokémon suinte un liquide toxique nauséabond qui blesse tous ceux qui tentent de voler ses PV.",
            "it": "Il Pokémon secerne delle sostanze tossiche. Se un nemico manda a segno una mossa che assorbe i PS, subisce dei danni.",
            "de": "Angreifer, die durch Saug-Attacken Kloakensoße in sich aufgenommen haben, nehmen durch deren widerwärtigen Gestank Schaden.",
            "es": "Exuda una sustancia tóxica de intenso hedor que hiere a quienes intentan drenarle PS.",
            "ko": "해감액을 흡수한 상대는 강렬한 악취로 데미지를 받아 HP가 줄어든다."
          }
        }
      ],
