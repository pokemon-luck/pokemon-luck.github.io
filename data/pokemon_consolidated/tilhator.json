      "names": {
        "en": "Tilhator",
        "fr": "Tilhator",
        "it": "Espeon",
        "de": "Psiana",
        "es": "Espeon",
        "ko": "에브이"
      },
      "descriptions": {
        "en": "As Tilathor's body dissolves into sea foam, the babies it has been protecting emerge from its mouth to live their lives as Tilasson.",
        "fr": "Tandis que le corps de Tilathor disparait en écume de mer, les bébés qu'il protégeait jusqu'ici sortent de sa bouche pour vivre leur vie de Tilasson.",
        "it": "Inizialmente non aveva particolari abilità, ma in seguito ha sviluppato delle capacità premonitrici per difendersi.",
        "de": "Es heißt, dass die Fähigkeit der Prophezeiung erst im Laufe der Zeit in ihm erwacht sei, damit es sich selbst vor Unheil bewahren könne.",
        "es": "Originariamente, carecía de habilidades especiales, pero terminó desarrollando facultades premonitorias para protegerse.",
        "ko": "원래는 아무런 능력도 없었지만 몸을 지키기 위해 예지 능력에 눈뜨게 됐다고 한다."
      },
      "abilities_data": [
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        },
        {
          "symbol": "hydration",
          "textId": 93,
          "names": {
            "en": "Hydration",
            "fr": "Hydratation",
            "it": "Idratazione",
            "de": "Hydration",
            "es": "Hidratación",
            "ko": "촉촉바디"
          },
          "descriptions": {
            "en": "Heals status conditions if it’s raining.",
            "fr": "Soigne les altérations de statut du Pokémon quand il pleut.",
            "it": "Se piove, il Pokémon guarisce dai problemi di stato.",
            "de": "Heilt bei Regen Statusprobleme.",
            "es": "Cura los problemas de estado si está lloviendo.",
            "ko": "비가 오는 날씨일 때 상태 이상이 회복된다."
          }
        },
        {
          "symbol": "soul_drain",
          "textId": 284,
          "names": {
            "en": "Soul Drain",
            "fr": "Aspir'Âme",
            "it": "Aspir'Âme",
            "de": "Aspir'Âme",
            "es": "Aspir'Âme",
            "ko": "Aspir'Âme"
          },
          "descriptions": {
            "en": "Heals the user by 1/8th of its max HP whenever it inflicts a status condition on an opponent.",
            "fr": "Soigne 1/8e des PV maximum du Pokémon chaque fois qu'il inflige un problème de statut à un adversaire.",
            "it": "Soigne 1/8e des PV maximum du Pokémon chaque fois qu'il inflige un problème de statut à un adversaire.",
