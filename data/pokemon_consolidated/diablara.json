      "names": {
        "en": "Crypthorn",
        "fr": "Diablara",
        "it": "Dragonair",
        "de": "Dragonir",
        "es": "Dragonair",
        "ko": "신뇽"
      },
      "descriptions": {
        "en": "To survive longer in the desert, Crypthorn can store a significant amount of water in its spines.",
        "fr": "Pour survivre plus longtemps dans le désert, Diablara peut stocker une bonne quantité d'eau dans ses épines.",
        "it": "Si crede che abbia il potere di controllare le condizioni atmosferiche. Presso i laghi in cui vive non mancano mai offerte a lui dedicate.",
        "de": "Aufgrund der Annahme, es könne das Wetter beeinflussen, finden sich an Seen, die es bewohnt, viele Opfergaben.",
        "es": "Existe la creencia de que puede controlar el clima y a menudo se hallan ofrendas a orillas de los lagos donde habita.",
        "ko": "날씨를 조종한다는 믿음 때문에 신뇽이 있는 호수에는 공물이 끊이지 않는다."
      },
      "abilities_data": [
        {
          "symbol": "rough_skin",
          "textId": 24,
          "names": {
            "en": "Rough Skin",
            "fr": "Peau Dure",
            "it": "Cartavetro",
            "de": "Rauhaut",
            "es": "Piel Tosca",
            "ko": "까칠한피부"
          },
          "descriptions": {
            "en": "This Pokémon inflicts damage with its rough skin to the attacker on contact.",
            "fr": "Blesse l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon è colpito da un attacco diretto, grazie alla sua pelle ruvida infligge danni a sua volta.",
            "de": "Angreifer werden durch die raue Haut des Pokémon bei direkten Attacken verletzt.",
            "es": "Hiere con su piel áspera al rival que lo ataque con un movimiento de contacto.",
            "ko": "공격을 받았을 때 자신에게 접촉한 상대를 까칠까칠한 피부로 상처를 입힌다."
          }
        },
        {
          "symbol": "sand_stream",
          "textId": 45,
          "names": {
            "en": "Sand Stream",
            "fr": "Sable Volant",
            "it": "Sabbiafiume",
            "de": "Sandsturm",
            "es": "Chorro Arena",
            "ko": "모래날림"
          },
          "descriptions": {
            "en": "The Pokémon summons a sandstorm when it enters a battle.",
            "fr": "Le Pokémon invoque une tempête de sable quand il entre au combat.",
            "it": "Quando il Pokémon entra in campo, scatena una tempesta di sabbia.",
            "de": "Erzeugt bei Kampfantritt Sandstürme.",
            "es": "Crea una tormenta de arena al entrar en combate.",
            "ko": "등장했을 때 날씨를 모래바람으로 만든다."
          }
        },
        {
          "symbol": "sand_force",
          "textId": 159,
          "names": {
            "en": "Sand Force",
            "fr": "Force Sable",
            "it": "Silicoforza",
            "de": "Sandgewalt",
            "es": "Poder Arena",
            "ko": "모래의힘"
          },
          "descriptions": {
            "en": "Boosts the power of Rock-, Ground-, and Steel-type moves in a sandstorm.",
            "fr": "Augmente la puissance des capacités de types Roche, Sol et Acier en cas de tempête de sable.",
            "it": "Potenzia le mosse di tipo Roccia, Terra e Acciaio durante le tempeste di sabbia.",
            "de": "Erhöht in Sandstürmen die Stärke von Gesteins-, Boden- und Stahl-Attacken.",
            "es": "Potencia los movimientos de tipo Tierra, Acero y Roca durante las tormentas de arena.",
            "ko": "날씨가 모래바람일 때 바위타입과 땅타입과 강철타입의 위력이 올라간다."
          }
        }
      ],
