      "names": {
        "en": "Merlinbrador",
        "fr": "Merlinbrador",
        "it": "Togepi",
        "de": "Togepi",
        "es": "Togepi",
        "ko": "토게피"
      },
      "descriptions": {
        "en": "It is said that Merlinbrador approaches children on their birthdays to delight them with a few magic tricks.",
        "fr": "On dit que les Merlinbrador approchent les enfants dont c'est l'anniversaire pour les émerveiller de quelques tours de magie.",
        "it": "Togepi ricava la sua energia dai nobili sentimenti di affetto e generosità emanati dai Pokémon e dall’uomo. Togepi immagazzina le sensazioni di felicità dentro il suo guscio e le divide con gli altri.",
        "de": "Togepi benutzt die positiven Emotionen Freude und Mitgefühl von Menschen und Pokémon als Energie. Dieses Pokémon speichert Glücksgefühle in seiner Schale und teilt sie mit anderen.",
        "es": "Togepi usa los sentimientos positivos de compasión y alegría que desprenden las personas y los Pokémon. Este Pokémon almacena sentimientos de felicidad en su interior y después los comparte con otros.",
        "ko": "사람이나 포켓몬이 발산하는 상냥함이나 즐거운 마음을 에너지로 삼는다. 껍질 안에 모은 행복을 나눈다."
      },
      "abilities_data": [
        {
          "symbol": "synchronize",
          "textId": 28,
          "names": {
            "en": "Synchronize",
            "fr": "Synchro",
            "it": "Sincronismo",
            "de": "Synchro",
            "es": "Sincronía",
            "ko": "싱크로"
          },
          "descriptions": {
            "en": "The attacker will receive the same status condition if it inflicts a burn, poison, or paralysis to the Pokémon.",
            "fr": "Quand le Pokémon est brûlé, paralysé ou empoisonné par un autre Pokémon, il partage ce statut avec celui-ci.",
            "it": "Se un nemico avvelena, paralizza o scotta un Pokémon con questa abilità, viene colpito dallo stesso problema di stato.",
            "de": "Erleidet das Pokémon Verbrennungen, Vergiftungen oder Paralyse, ereilt das jeweilige Statusproblem auch den Verursacher.",
            "es": "Contagia el envenenamiento, las quemaduras o la parálisis al Pokémon que le cause ese estado.",
            "ko": "자신이 걸린 독이나 마비, 화상을 상대에게 옮긴다."
          }
        },
        {
          "symbol": "magic_bounce",
          "textId": 156,
          "names": {
            "en": "Magic Bounce",
            "fr": "Miroir Magik",
            "it": "Magispecchio",
            "de": "Magiespiegel",
            "es": "Espejo Mágico",
            "ko": "매직미러"
          },
          "descriptions": {
            "en": "Reflects status moves instead of getting hit by them.",
            "fr": "Annule les effets des capacités de statut subies par le Pokémon et les retourne à l’envoyeur.",
            "it": "Il Pokémon respinge al mittente le mosse di stato senza subirne gli effetti.",
            "de": "Lenkt Status-Attacken auf den Angreifer um, ohne selbst von ihnen getroffen zu werden.",
            "es": "Puede devolver los movimientos de estado lanzados por el rival, sin verse afectado por ellos.",
            "ko": "상대가 쓴 변화 기술을 받지 않고 그대로 되받아칠 수 있다."
          }
        },
        {
          "symbol": "enlightened_mind",
          "textId": 275,
          "names": {
            "en": "Enlightened Mind",
            "fr": "Esprit Éveillé",
            "it": "Esprit Éveillé",
            "de": "Esprit Éveillé",
            "es": "Esprit Éveillé",
            "ko": "Esprit Éveillé"
          },
          "descriptions": {
            "en": "Increases Special Attack and Special Defense by 1 stage if hit by a Dark-type move.",
            "fr": "Augmente l'Attaque Spéciale et la Défense Spéciale de 1 niveau si le pokémon est touché par une attaque de type Ténèbres.",
            "it": "Augmente l'Attaque Spéciale et la Défense Spéciale de 1 niveau si le pokémon est touché par une attaque de type Ténèbres.",
            "de": "Augmente l'Attaque Spéciale et la Défense Spéciale de 1 niveau si le pokémon est touché par une attaque de type Ténèbres.",
            "es": "Augmente l'Attaque Spéciale et la Défense Spéciale de 1 niveau si le pokémon est touché par une attaque de type Ténèbres.",
            "ko": "Augmente l'Attaque Spéciale et la Défense Spéciale de 1 niveau si le pokémon est touché par une attaque de type Ténèbres."
          }
        }
