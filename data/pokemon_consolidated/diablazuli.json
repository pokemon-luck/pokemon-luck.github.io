      "names": {
        "en": "Cryptopaz",
        "fr": "Diablazuli",
        "it": "Mewtwo",
        "de": "Mewtu",
        "es": "Mewtwo",
        "ko": "뮤츠"
      },
      "descriptions": {
        "en": "Cryptopaz regularly polishes its gemstones to keep them shining brightly.",
        "fr": "Diablazuli polit régulièrement ses pierres précieuses pour les garder bien brillantes.",
        "it": "Mewtwo è stato creato grazie a una manipolazione genetica. Tuttavia, sebbene la scienza sia riuscita a creare un corpo di Pokémon, ha fallito nell’intento di dare a Mewtwo un animo generoso.",
        "de": "Mewtu ist ein Pokémon, das durch Genmanipulation entstanden ist. Die Menschen haben es zwar mit ihrem wissenschaftlichen Sachverstand erzeugt, aber nicht mit einem mitfühlenden Herzen ausgestattet.",
        "es": "Mewtwo fue creado por manipulación genética. Pero, a pesar de que el hombre creó su cuerpo, dotar a Mewtwo de un corazón compasivo quedó en el olvido.",
        "ko": "유전자조작을 통해 만들어진 포켓몬이다. 인간은 과학의 힘으로 몸은 만들었지만 상냥한 마음을 만들 수는 없었다."
      },
      "abilities_data": [
        {
          "symbol": "sturdy",
          "textId": 5,
          "names": {
            "en": "Sturdy",
            "fr": "Fermeté",
            "it": "Vigore",
            "de": "Robustheit",
            "es": "Robustez",
            "ko": "옹골참"
          },
          "descriptions": {
            "en": "It cannot be knocked out with one hit. One-hit KO moves cannot knock it out, either.",
            "fr": "Le Pokémon encaisse toujours au moins une attaque s’il a tous ses PV. Il est également immunisé contre les capacités pouvant mettre K.O. en un coup.",
            "it": "Evita che il Pokémon vada KO in un sol colpo se ha tutti i PS, e lo rende immune alle mosse che causano KO immediato.",
            "de": "Bietet Schutz gegen K.O.-Attacken. Bei vollen KP übersteht das Pokémon auch K.O.-Treffer.",
            "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
            "ko": "상대 기술을 받아도 일격으로 쓰러지지 않는다. 일격필살 기술도 효과 없다."
          }
        },
        {
          "symbol": "battle_armor",
          "textId": 4,
          "names": {
            "en": "Battle Armor",
            "fr": "Armurbaston",
            "it": "Lottascudo",
            "de": "Kampfpanzer",
            "es": "Armadura Batalla",
            "ko": "전투무장"
          },
          "descriptions": {
            "en": "Hard armor protects the Pokémon from critical hits.",
            "fr": "Le Pokémon est protégé des coups critiques par une solide carapace.",
            "it": "Il Pokémon è protetto da una dura corazza che gli evita di subire brutti colpi.",
            "de": "Wehrt gegnerische Volltreffer mit einem harten Panzer ab.",
            "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
            "ko": "단단한 껍질에 보호받아 상대의 공격이 급소에 맞지 않는다."
          }
        },
        {
          "symbol": "solid_rock",
          "textId": 116,
          "names": {
            "en": "Solid Rock",
            "fr": "Solide Roc",
            "it": "Solidroccia",
            "de": "Felskern",
            "es": "Roca Sólida",
            "ko": "하드록"
          },
          "descriptions": {
            "en": "Reduces the power of supereffective attacks taken.",
            "fr": "Réduit les dégâts subis lorsque le Pokémon est touché par une capacité super efficace.",
            "it": "Riduce i danni subiti dalle mosse superefficaci.",
            "de": "Reduziert die Stärke von sehr effektiven Attacken und verringert damit den Schaden, den das Pokémon durch sie erleidet.",
            "es": "Mitiga el daño que le infligen los movimientos supereficaces.",
            "ko": "효과가 굉장한 공격의 위력을 약하게 만든다."
          }
        }
      ],
