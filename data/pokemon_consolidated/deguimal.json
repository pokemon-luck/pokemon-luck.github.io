      "names": {
        "en": "Maskin",
        "fr": "Déguimal",
        "it": "Hoothoot",
        "de": "Hoothoot",
        "es": "Hoothoot",
        "ko": "부우부"
      },
      "descriptions": {
        "en": "It is said that Maskin draws power from the skin it wears as a mask.",
        "fr": "On dit que Déguimal tirerait des pouvoirs de la peau qu'il porte en tant que masque.",
        "it": "Ogni giorno piega la testa a intervalli regolari. In passato questi Pokémon venivano usati come veri e propri orologi.",
        "de": "Es neigt seinen Kopf tagein, tagaus in einem festgelegten Rhythmus. Früher verwendete man es als Uhr.",
        "es": "Mueve la cabeza a un ritmo preciso y constante, por lo que en la antigüedad la gente lo usaba como reloj.",
        "ko": "매일 정해진 리듬에 맞춰 목을 기울인다. 옛날 사람들은 시계 대용으로 길렀다."
      },
      "abilities_data": [
        {
          "symbol": "shadow_tag",
          "textId": 23,
          "names": {
            "en": "Shadow Tag",
            "fr": "Marque Ombre",
            "it": "Pedinombra",
            "de": "Wegsperre",
            "es": "Sombra Trampa",
            "ko": "그림자밟기"
          },
          "descriptions": {
            "en": "This Pokémon steps on the opposing Pokémon’s shadow to prevent it from escaping.",
            "fr": "Empêche les Pokémon ennemis de quitter le combat.",
            "it": "Il Pokémon calpesta l’ombra del nemico impedendogli la fuga o la sostituzione.",
            "de": "Hindert Gegner an der Flucht beziehungsweise am Auswechseln, indem es ihnen den Weg versperrt.",
            "es": "Impide que el enemigo huya o sea cambiado por otro.",
            "ko": "상대의 그림자를 밟아 도망치거나 교체할 수 없게 한다."
          }
        },
        {
          "symbol": "infiltrator",
          "textId": 151,
          "names": {
            "en": "Infiltrator",
            "fr": "Infiltration",
            "it": "Intrapasso",
            "de": "Schwebedurch",
            "es": "Allanamiento",
            "ko": "틈새포착"
          },
          "descriptions": {
            "en": "Passes through the opposing Pokémon’s barrier, substitute, and the like and strikes.",
            "fr": "Traverse les barrières et les clones de l’ennemi pour attaquer directement.",
            "it": "Il Pokémon attacca evitando le barriere e il sostituto del nemico.",
            "de": "Überwindet gegnerische Schilde sowie Delegatoren und greift an.",
            "es": "Ataca sorteando la barrera o el sustituto del rival.",
            "ko": "상대의 벽이나 대타출동을 뚫고 공격할 수 있다."
          }
        },
        {
          "symbol": "illusion",
          "textId": 149,
          "names": {
            "en": "Illusion",
            "fr": "Illusion",
            "it": "Illusione",
            "de": "Trugbild",
            "es": "Ilusión",
            "ko": "일루전"
          },
          "descriptions": {
            "en": "Comes out disguised as the Pokémon in the party’s last spot.",
            "fr": "Le Pokémon prend l’apparence du dernier membre de l’équipe pour tromper l’adversaire.",
            "it": "Il Pokémon inganna il nemico entrando in campo con le sembianze dell’ultimo Pokémon della propria squadra.",
            "de": "Führt den Gegner hinters Licht, indem es bei Kampfantritt die Gestalt des Pokémon an der letzten Stelle im Team annimmt.",
            "es": "Adopta el aspecto del último Pokémon del equipo al entrar en combate para desconcertar al rival.",
            "ko": "지닌 포켓몬 중 제일 뒤에 있는 포켓몬으로 둔갑하여 나와서 상대를 속인다."
          }
        }
      ],
