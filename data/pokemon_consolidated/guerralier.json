      "names": {
        "en": "Conquestallion",
        "fr": "Guerralier",
        "it": "Vileplume",
        "de": "Giflor",
        "es": "Vileplume",
        "ko": "라플레시아"
      },
      "descriptions": {
        "en": "Its presence influences the character of the surrounding Pokémon, causing many conflicts.",
        "fr": "Sa présence influe sur le caractère des pokémon alentours, provoquant de nombreux conflits.",
        "it": "Vileplume ha i petali più grandi al mondo. Li usa per attirare la preda per poi ricoprirla di spore velenose. Una volta immobilizzata la preda, il Pokémon la cattura e la divora.",
        "de": "Giflor hat die größten Blätter der Welt. Sie ziehen Beute an und bestäuben sie mit giftigen Sporen. Wenn die Beute sich nicht mehr rührt, fängt dieses Pokémon sie und frisst sie auf.",
        "es": "Vileplume tiene los mayores pétalos del mundo. Los usa para atraer a sus presas y llenarlas de esporas tóxicas. Una vez que ha inmovilizado a las víctimas, las atrapa y las devora.",
        "ko": "세계에서 제일 큰 꽃잎으로 먹이를 유인하여 독 꽃가루를 끼얹는다. 움직이지 못하게 된 먹이를 잡아먹는다."
      },
      "abilities_data": [
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        },
        {
          "symbol": "battle_armor",
          "textId": 4,
          "names": {
            "en": "Battle Armor",
            "fr": "Armurbaston",
            "it": "Lottascudo",
            "de": "Kampfpanzer",
            "es": "Armadura Batalla",
            "ko": "전투무장"
          },
          "descriptions": {
            "en": "Hard armor protects the Pokémon from critical hits.",
            "fr": "Le Pokémon est protégé des coups critiques par une solide carapace.",
            "it": "Il Pokémon è protetto da una dura corazza che gli evita di subire brutti colpi.",
            "de": "Wehrt gegnerische Volltreffer mit einem harten Panzer ab.",
            "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
            "ko": "단단한 껍질에 보호받아 상대의 공격이 급소에 맞지 않는다."
          }
        },
        {
          "symbol": "defiant",
          "textId": 128,
          "names": {
            "en": "Defiant",
            "fr": "Acharné",
            "it": "Agonismo",
            "de": "Siegeswille",
            "es": "Competitivo",
            "ko": "오기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Attack stat sharply when its stats are lowered.",
            "fr": "Augmente beaucoup l’Attaque du Pokémon quand ses stats baissent.",
            "it": "L’Attacco aumenta di molto quando le statistiche diminuiscono a causa di un nemico.",
            "de": "Erhöht den Angriff stark, wenn ein Statuswert gesenkt wurde.",
            "es": "Sube mucho su Ataque cuando el rival le baja las características.",
            "ko": "능력이 떨어지면 공격이 크게 올라간다."
          }
        }
      ],
