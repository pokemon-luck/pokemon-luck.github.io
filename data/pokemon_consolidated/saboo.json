      "names": {
        "en": "Soulone",
        "fr": "Saboo",
        "it": "Bellossom",
        "de": "Blubella",
        "es": "Bellossom",
        "ko": "아르코"
      },
      "descriptions": {
        "en": "Soulone regularly enjoys surprising the indecisive heads of the Dueternals to allow others to make a decision.",
        "fr": "Saboo s'amuse régulièrement à surprendre les têtes indécises des duoffenses pour permettre aux autres de prendre une décision.",
        "it": "I fiori di Bellossom sono tanto più belli quanto più forte è il puzzo del Gloom da cui si evolve! Quando la sera chiude i petali significa che se ne va a dormire.",
        "de": "Blubella wachsen schönere Blumen, wenn es sich aus einem übel riechenden Duflor entwickelt hat – je stinkender, desto besser. Nachts schließt dieses Pokémon seine Blätter und schläft.",
        "es": "La belleza de las flores que le crecen a Bellossom depende de lo mal que oliera el Gloom a partir del cual evolucionó. A mayor hedor, mayor belleza. Por la noche, este Pokémon cierra los pétalos y se echa a dormir.",
        "ko": "좀 더 악취를 풍기는 냄새꼬 쪽이 진화하면 아름다운 꽃을 피운 아르코가 된다. 밤이 되면 꽃잎을 오므리고 잔다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
