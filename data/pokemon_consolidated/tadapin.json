      "names": {
        "en": "Misqueakal",
        "fr": "Tadapin",
        "it": "Yanma",
        "de": "Yanma",
        "es": "Yanma",
        "ko": "왕자리"
      },
      "descriptions": {
        "en": "Misqueakal's hat serves as protection against its predators, as well as a shelter for spending the night.",
        "fr": "Le chapeau de Tadapin lui sert de protection contre ses prédateurs, mais également d'abri pour passer la nuit. ",
        "it": "Yanma è dotato di un campo visivo a 360 gradi senza bisogno di muovere gli occhi. Grazie alle grandi ali riesce a fermarsi improvvisamente e virare a mezz’aria. Sfrutta la sua abilità in volo per abbattere la preda al suolo.",
        "de": "Yanma hat einen Blickwinkel von 360 Grad, ohne die Augen bewegen zu müssen. Es ist ein großartiger Flieger und geübt darin, plötzlich anzuhalten oder Wendemanöver hinzulegen. So kann es sich blitzschnell auf Beute stürzen.",
        "es": "Yanma tiene un ángulo de visión de 360° sin mover los ojos. Es un gran volador, experto en hacer repentinas paradas y cambios de dirección en el aire. Aprovecha la habilidad que tiene de volar para lanzarse sobre su presa.",
        "ko": "눈알을 움직이지 않고 360도를 볼 수 있다. 급브레이크나 방향 전환이 특기다. 노린 먹이를 빠르게 몰아넣는다."
      },
      "abilities_data": [
        {
          "symbol": "anticipation",
          "textId": 107,
          "names": {
            "en": "Anticipation",
            "fr": "Anticipation",
            "it": "Presagio",
            "de": "Vorahnung",
            "es": "Anticipación",
            "ko": "위험예지"
          },
          "descriptions": {
            "en": "The Pokémon can sense an opposing Pokémon’s dangerous moves.",
            "fr": "Le Pokémon devine si l’adversaire connaît une capacité dangereuse pour lui.",
            "it": "Rivela se il nemico ha mosse pericolose.",
            "de": "Kann gefährliche gegnerische Attacken erahnen.",
            "es": "Prevé los movimientos peligrosos del rival.",
            "ko": "상대가 지닌 위험한 기술을 감지할 수 있다."
          }
        },
        {
          "symbol": "static",
          "textId": 9,
          "names": {
            "en": "Static",
            "fr": "Statik",
            "it": "Statico",
            "de": "Statik",
            "es": "Elec. Estática",
            "ko": "정전기"
          },
          "descriptions": {
            "en": "The Pokémon is charged with static electricity, so contact with it may cause paralysis.",
            "fr": "Le Pokémon charge son corps en électricité statique, et tout contact avec lui peut paralyser.",
            "it": "Il contatto fisico con il corpo percorso dall’elettricità statica del Pokémon può causare paralisi.",
            "de": "Kann bei Berührung durch statisch aufgeladenen Körper paralysieren.",
            "es": "La electricidad estática que lo envuelve puede paralizar al mínimo contacto.",
            "ko": "정전기를 몸에 둘러 접촉한 상대를 마비시킬 때가 있다."
          }
        },
        {
          "symbol": "psychic_surge",
          "textId": 227,
          "names": {
            "en": "Psychic Surge",
            "fr": "Créa-Psy",
            "it": "Psicogenesi",
            "de": "Psycho-Erzeuger",
            "es": "Psicogénesis",
            "ko": "사이코메이커"
          },
          "descriptions": {
            "en": "Turns the ground into Psychic Terrain when the Pokémon enters a battle.",
            "fr": "Le Pokémon crée un Champ Psychique au moment où il entre au combat.",
            "it": "Quando il Pokémon entra in campo, lo trasforma in un Campo Psichico.",
            "de": "Erzeugt bei Kampfantritt ein Psychofeld.",
            "es": "Crea un campo psíquico al entrar en combate.",
            "ko": "등장했을 때 사이코필드를 사용한다."
          }
        }
      ],
