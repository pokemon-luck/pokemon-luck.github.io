      "names": {
        "en": "Mustorrent",
        "fr": "Mustorrent",
        "it": "Croconaw",
        "de": "Tyracroc",
        "es": "Croconaw",
        "ko": "엘리게이"
      },
      "descriptions": {
        "en": "Excelling at swimming, Mustorrent's long body allows it to undulate for propulsion, reaching impressive speeds.",
        "fr": "Excellent nageur, le long corps de Mustorrent lui permet d'onduler afin de se propulser et atteindre des vitesses impressionnantes.",
        "it": "Una volta azzannato il nemico, Croconaw non molla la presa facilmente. Le zanne a punta ricurva all’indietro, a mo’ di amo da pesca, rendono impossibile estrarle quando sono conficcate in profondità.",
        "de": "Wenn Tyracroc einen Feind mit seinen Kiefern eingeklemmt hat, lässt es ihn nicht mehr los. Da seine Zahnspitzen wie Angelhaken gebogen sind, kann man sie nicht mehr entfernen, wenn sie sich verfangen haben.",
        "es": "Una vez que Croconaw le ha clavado los colmillos a su presa, es imposible que escape porque los tiene hacia adentro como si fueran anzuelos. Cuando Croconaw hinca los dientes, no hay escapatoria.",
        "ko": "한 번 물고 늘어지면 절대로 놓지 않는다. 이빨 끝이 낚싯바늘처럼 휘어져 있어서 한 번 들어가면 빠지지 않는다."
      },
      "abilities_data": [
        {
          "symbol": "torrent",
          "textId": 67,
          "names": {
            "en": "Torrent",
            "fr": "Torrent",
            "it": "Acquaiuto",
            "de": "Sturzbach",
            "es": "Torrente",
            "ko": "급류"
          },
          "descriptions": {
            "en": "Powers up Water-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Eau du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Acqua aumenta.",
            "de": "Erhöht die Stärke von Wasser-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Agua cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 물타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "water_veil",
          "textId": 41,
          "names": {
            "en": "Water Veil",
            "fr": "Ignifu-Voile",
            "it": "Idrovelo",
            "de": "Aquahülle",
            "es": "Velo Agua",
            "ko": "수의베일"
          },
          "descriptions": {
            "en": "The Pokémon is covered with a water veil, which prevents the Pokémon from getting a burn.",
            "fr": "Le voile qui recouvre le Pokémon le protège des brûlures.",
            "it": "Un velo d’acqua riveste il corpo del Pokémon impedendogli di venire scottato.",
            "de": "Verhindert durch eine Hülle aus Wasser Verbrennungen.",
            "es": "Evita las quemaduras gracias a la capa de agua que lo envuelve.",
            "ko": "물의 베일을 몸에 둘러서 화상 상태가 되지 않는다."
          }
        },
        {
          "symbol": "swift_swim",
          "textId": 33,
          "names": {
            "en": "Swift Swim",
            "fr": "Glissade",
            "it": "Nuotovelox",
            "de": "Wassertempo",
            "es": "Nado Rápido",
            "ko": "쓱쓱"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in rain.",
            "fr": "Augmente la Vitesse du Pokémon s’il pleut.",
            "it": "Se piove, la Velocità aumenta.",
            "de": "Erhöht bei Regen die Initiative.",
            "es": "Sube su Velocidad cuando llueve.",
            "ko": "비가 오는 날씨일 때 스피드가 올라간다."
          }
        }
      ],
