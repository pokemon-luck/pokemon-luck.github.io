      "names": {
        "en": "Starvallion",
        "fr": "Saborexie",
        "it": "Paras",
        "de": "Paras",
        "es": "Paras",
        "ko": "파라스"
      },
      "descriptions": {
        "en": "Constantly hungry, it makes all the food around him rot.",
        "fr": "Constamment affamé, il fait pourrir toute la nourriture autour de lui.",
        "it": "I funghi sul dorso di Paras crescono con difficoltà ad Alola, forse per mancanza di umidità o di nutrimento.",
        "de": "In Alola sind Paras’ Pilze etwas unterentwickelt. Vielleicht mangelt es ihm hier an Feuchtigkeit oder Nährstoffen.",
        "es": "Ya sea por la falta de humedad o de nutrientes, las setas parásitas de los Paras en Alola suelen ser más pequeñas que en otras regiones.",
        "ko": "습도가 낮아서인지 영양이 부족해서인지 알로라 파라스의 버섯은 성장이 그저 그렇다."
      },
      "abilities_data": [
        {
          "symbol": "unnerve",
          "textId": 127,
          "names": {
            "en": "Unnerve",
            "fr": "Tension",
            "it": "Agitazione",
            "de": "Anspannung",
            "es": "Nerviosismo",
            "ko": "긴장감"
          },
          "descriptions": {
            "en": "Unnerves opposing Pokémon and makes them unable to eat Berries.",
            "fr": "Fait stresser l’ennemi, ce qui l’empêche de manger des Baies.",
            "it": "Il nemico viene intimidito e non può mangiare bacche.",
            "de": "Erzeugt bei Gegnern Stress und hindert sie so daran, Beeren zu konsumieren.",
            "es": "Pone nervioso al rival y le impide usar bayas.",
            "ko": "상대를 긴장시켜 나무열매를 먹지 못하게 한다."
          }
        },
        {
          "symbol": "stench",
          "textId": 1,
          "names": {
            "en": "Stench",
            "fr": "Puanteur",
            "it": "Tanfo",
            "de": "Duftnote",
            "es": "Hedor",
            "ko": "악취"
          },
          "descriptions": {
            "en": "By releasing stench when attacking, this Pokémon may cause the target to flinch.",
            "fr": "Le Pokémon émet une odeur si nauséabonde qu’il peut effrayer sa cible.",
            "it": "A volte il cattivo odore emesso dal Pokémon fa tentennare i nemici quando attacca.",
            "de": "Lässt das Ziel beim Angriff eventuell durch Gestank zurückschrecken.",
            "es": "Puede amedrentar al rival al atacarlo debido al mal olor que emana.",
            "ko": "악취를 풍겨서 공격했을 때 상대가 풀죽을 때가 있다."
          }
        },
        {
          "symbol": "synchronize",
          "textId": 28,
          "names": {
            "en": "Synchronize",
            "fr": "Synchro",
            "it": "Sincronismo",
            "de": "Synchro",
            "es": "Sincronía",
            "ko": "싱크로"
          },
          "descriptions": {
            "en": "The attacker will receive the same status condition if it inflicts a burn, poison, or paralysis to the Pokémon.",
            "fr": "Quand le Pokémon est brûlé, paralysé ou empoisonné par un autre Pokémon, il partage ce statut avec celui-ci.",
            "it": "Se un nemico avvelena, paralizza o scotta un Pokémon con questa abilità, viene colpito dallo stesso problema di stato.",
            "de": "Erleidet das Pokémon Verbrennungen, Vergiftungen oder Paralyse, ereilt das jeweilige Statusproblem auch den Verursacher.",
            "es": "Contagia el envenenamiento, las quemaduras o la parálisis al Pokémon que le cause ese estado.",
            "ko": "자신이 걸린 독이나 마비, 화상을 상대에게 옮긴다."
          }
        }
      ],
