      "names": {
        "en": "Horninja",
        "fr": "Shinobiquette",
        "it": "Pidgeotto",
        "de": "Tauboga",
        "es": "Pidgeotto",
        "ko": "피죤"
      },
      "descriptions": {
        "en": "Jealous of the attention that people give to Lambattles, he will stop at nothing to get noticed.",
        "fr": "Jaloux de l'attention que les gens portent à Agnoffensif, il ne recule devant rien pour se faire remarquer.",
        "it": "Pidgeotto delimita come proprio un territorio immenso, che difende controllandolo costantemente. Se tale territorio viene invaso, questo Pokémon non ha pietà nel punire i nemici con i suoi artigli affilati.",
        "de": "Tauboga nennt ein großes Gebiet sein Eigen. Es fliegt umher und kontrolliert seinen Lebensraum. Wenn jemand sein Gebiet betritt, zeigt es keine Gnade und greift seine Gegner mit seinen scharfen Krallen an.",
        "es": "Pidgeotto se apodera de una zona muy vasta como su territorio y la sobrevuela para controlarla. Si alguien invade su espacio vital, no tendrá ningún reparo en castigarlo con sus afiladas garras.",
        "ko": "넓은 영역을 날며 순찰한다. 영역을 침범하는 상대는 용서하지 않는다. 날카로운 발톱으로 철저히 혼내준다."
      },
      "abilities_data": [
        {
          "symbol": "tangled_feet",
          "textId": 77,
          "names": {
            "en": "Tangled Feet",
            "fr": "Pieds Confus",
            "it": "Intricopiedi",
            "de": "Fußangel",
            "es": "Tumbos",
            "ko": "갈지자걸음"
          },
          "descriptions": {
            "en": "Raises evasiveness if the Pokémon is confused.",
            "fr": "Augmente l’Esquive du Pokémon s’il est confus.",
            "it": "Se il Pokémon è confuso, la sua elusione aumenta.",
            "de": "Erhöht den Ausweichwert, wenn das Pokémon verwirrt ist.",
            "es": "Sube su Evasión si está confuso.",
            "ko": "혼란 상태일 때는 회피율이 올라간다."
          }
        },
        {
          "symbol": "quick_feet",
          "textId": 95,
          "names": {
            "en": "Quick Feet",
            "fr": "Pied Véloce",
            "it": "Piedisvelti",
            "de": "Rasanz",
            "es": "Pies Rápidos",
            "ko": "속보"
          },
          "descriptions": {
            "en": "Boosts the Speed stat if the Pokémon has a status condition.",
            "fr": "Augmente la Vitesse du Pokémon en cas d’altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, la Velocità aumenta.",
            "de": "Erhöht bei Statusproblemen die Initiative.",
            "es": "Aumenta la Velocidad si sufre problemas de estado.",
            "ko": "상태 이상이 되면 스피드가 올라간다."
          }
        },
        {
          "symbol": "anger_point",
          "textId": 83,
          "names": {
            "en": "Anger Point",
            "fr": "Colérique",
            "it": "Grancollera",
            "de": "Kurzschluss",
            "es": "Irascible",
            "ko": "분노의경혈"
          },
          "descriptions": {
            "en": "The Pokémon is angered when it takes a critical hit, and that maxes its Attack stat.",
            "fr": "Si le Pokémon subit un coup critique, il entre dans une colère noire qui augmente son Attaque au maximum.",
            "it": "Se il Pokémon subisce un brutto colpo, monta su tutte le furie e il suo Attacco aumenta al massimo.",
            "de": "Wird nach Einstecken eines Volltreffers wütend und maximiert dabei seinen Angriffs-Wert.",
            "es": "Si recibe un golpe crítico, monta en cólera y sube su Ataque hasta el máximo.",
            "ko": "급소에 공격이 맞으면 크게 분노해 공격력이 최대가 된다."
          }
        }
      ],
