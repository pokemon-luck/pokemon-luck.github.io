      "names": {
        "en": "Caminion",
        "fr": "Caminion",
        "it": "Scyther",
        "de": "Sichlor",
        "es": "Scyther",
        "ko": "스라크"
      },
      "descriptions": {
        "en": "After being arrested for theft, this Pokémon is said to have escaped, dragging along the straitjacket that was supposed to hold it.",
        "fr": "Après s'être fait arrêté pour vol, ce pokémon se serait enfui, trainant avec lui la camisole supposée le retenir.",
        "it": "Usa le due falci affilate sia come armi durante la lotta, sia per sfilettare le prede prima di mangiarle.",
        "de": "Seine scharfen Sicheln sind nicht nur Waffen. Vor einer Mahlzeit filetiert es damit auch geschickt seine Beute.",
        "es": "Sus dos guadañas no son meras armas de combate. También las utiliza diestramente para desmenuzar y devorar a sus presas.",
        "ko": "날카로운 2개의 낫은 단순한 무기가 아니다. 요령 있게 먹이를 발라 먹는다."
      },
      "abilities_data": [
        {
          "symbol": "pickpocket",
          "textId": 124,
          "names": {
            "en": "Pickpocket",
            "fr": "Pickpocket",
            "it": "Arraffalesto",
            "de": "Langfinger",
            "es": "Hurto",
            "ko": "나쁜손버릇"
          },
          "descriptions": {
            "en": "Steals an item from an attacker that made direct contact.",
            "fr": "Vole l’objet que tient l’attaquant quand le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, ruba lo strumento di chi lo ha attaccato.",
            "de": "Stiehlt das Item des Angreifers bei Berührung.",
            "es": "Si el rival usa un movimiento de contacto al atacar, le roba el objeto.",
            "ko": "접촉한 상대의 도구를 훔친다."
          }
        },
        {
          "symbol": "technician",
          "textId": 101,
          "names": {
            "en": "Technician",
            "fr": "Technicien",
            "it": "Tecnico",
            "de": "Techniker",
            "es": "Experto",
            "ko": "테크니션"
          },
          "descriptions": {
            "en": "Powers up the Pokémon’s weaker moves.",
            "fr": "Augmente la puissance des capacités les plus faibles.",
            "it": "Potenzia le mosse più deboli del Pokémon.",
            "de": "Erhöht die Stärke von schwächeren Attacken.",
            "es": "Potencia sus movimientos más débiles.",
            "ko": "위력이 약한 기술의 위력을 올려서 공격할 수 있다."
          }
        },
        {
          "symbol": "quick_feet",
          "textId": 95,
          "names": {
            "en": "Quick Feet",
            "fr": "Pied Véloce",
            "it": "Piedisvelti",
            "de": "Rasanz",
            "es": "Pies Rápidos",
            "ko": "속보"
          },
          "descriptions": {
            "en": "Boosts the Speed stat if the Pokémon has a status condition.",
            "fr": "Augmente la Vitesse du Pokémon en cas d’altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, la Velocità aumenta.",
            "de": "Erhöht bei Statusproblemen die Initiative.",
            "es": "Aumenta la Velocidad si sufre problemas de estado.",
            "ko": "상태 이상이 되면 스피드가 올라간다."
          }
        }
      ],
