      "names": {
        "en": "Cordyshed",
        "fr": "Cordycaille",
        "it": "Piloswine",
        "de": "Keifel",
        "es": "Piloswine",
        "ko": "메꾸리"
      },
      "descriptions": {
        "en": "An empty shell, Cordyshed is nothing more than Shedino's molted skin, which a fungus animates like a puppet.",
        "fr": "Coquille vide, Cordycaille n'est rien de plus que la mue de Caïmue qu'un champignon anime comme sa marionnette.",
        "it": "Piloswine è ricoperto da una fitta chioma di pelo lungo che lo aiuta a contrastare il freddo pungente. Usa le proprie zanne per scavare in cerca del cibo sepolto sotto i ghiacci.",
        "de": "Keifel hat ein dichtes Fell aus langen Haaren. Dadurch ist es gegen eisige Kälte gewappnet. Dieses Pokémon benutzt seine Stoßzähne, um an Nahrung zu gelangen, die unter dem Eis eingeschlossen ist.",
        "es": "Piloswine está cubierto por un pelaje tupido y de largas cerdas que le permite soportar el frío polar. Este Pokémon usa los colmillos para desenterrar los alimentos que hayan podido quedar bajo el hielo.",
        "ko": "얼어붙는 추위에도 버틸 수 있도록 두껍고 긴 털가죽에 덮여 있다. 얼음에 묻힌 먹이를 이빨로 파낸다."
      },
      "abilities_data": [
        {
          "symbol": "shed_skin",
          "textId": 61,
          "names": {
            "en": "Shed Skin",
            "fr": "Mue",
            "it": "Muta",
            "de": "Expidermis",
            "es": "Mudar",
            "ko": "탈피"
          },
          "descriptions": {
            "en": "The Pokémon may heal its own status conditions by shedding its skin.",
            "fr": "Le Pokémon soigne parfois ses altérations de statut en muant.",
            "it": "Il Pokémon può guarire dai problemi di stato facendo la muta completa della pelle.",
            "de": "Das Pokémon befreit sich eventuell von Statusproblemen, indem es seine Haut abstreift.",
            "es": "Puede curar sus problemas de estado al mudar la piel.",
            "ko": "몸의 껍질을 벗어 던져 상태 이상을 회복할 때가 있다."
          }
        },
        {
          "symbol": "effect_spore",
          "textId": 27,
          "names": {
            "en": "Effect Spore",
            "fr": "Pose Spore",
            "it": "Spargispora",
            "de": "Sporenwirt",
            "es": "Efecto Espora",
            "ko": "포자"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may inflict poison, sleep, or paralysis on its attacker.",
            "fr": "Peut paralyser, empoisonner ou endormir l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare avvelenamento, paralisi o sonno a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, kann das beim Gegner Paralyse, Vergiftung oder Schlaf auslösen.",
            "es": "Puede dormir, envenenar o paralizar al Pokémon con el que entre en contacto al recibir un ataque.",
            "ko": "공격으로 자신에게 접촉한 상대를 독이나 마비, 잠듦 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "poison_heal",
          "textId": 90,
          "names": {
            "en": "Poison Heal",
            "fr": "Soin Poison",
            "it": "Velencura",
            "de": "Aufheber",
            "es": "Antídoto",
            "ko": "포이즌힐"
          },
          "descriptions": {
            "en": "Restores HP if the Pokémon is poisoned instead of losing HP.",
            "fr": "Quand le Pokémon est empoisonné, il regagne des PV au lieu d’en perdre.",
            "it": "Se il Pokémon è avvelenato, recupera PS anziché perderli.",
            "de": "Das Pokémon erleidet keinen Schaden durch Vergiftung, sondern regeneriert KP.",
            "es": "Si resulta envenenado, recupera PS en vez de perderlos.",
            "ko": "독 상태가 되면 HP가 줄지 않고 증가한다."
          }
        }
      ],
