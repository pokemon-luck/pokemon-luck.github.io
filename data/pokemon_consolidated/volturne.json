      "names": {
        "en": "Rogturnal",
        "fr": "Volturne",
        "it": "Electabuzz",
        "de": "Elektek",
        "es": "Electabuzz",
        "ko": "에레브"
      },
      "descriptions": {
        "en": "After years of unjust confinement, Rogturnal thirsts for revenge and unleashes its fury.",
        "fr": "Après des années d'enfermement injuste, Volturne a soif de vengeance et libère sa fureur.",
        "it": "Tutto il suo corpo è pervaso di elettricità. Fa roteare vorticosamente le braccia prima di sferrare un pugno per caricarlo il più possibile.",
        "de": "Sein ganzer Körper speichert Elektrizität. Vor einem Schlag lädt es seine Arme mit kreisförmigen Bewegungen elektrisch auf.",
        "es": "Su cuerpo entero emite energía eléctrica. Hace girar los brazos cuales aspas de molino para cargar sus puñetazos con electricidad.",
        "ko": "온몸이 전기로 둘러싸여 있다. 팔을 빙빙 돌려 전기를 충전 후 펀치를 날린다."
      },
      "abilities_data": [
        {
          "symbol": "pickpocket",
          "textId": 124,
          "names": {
            "en": "Pickpocket",
            "fr": "Pickpocket",
            "it": "Arraffalesto",
            "de": "Langfinger",
            "es": "Hurto",
            "ko": "나쁜손버릇"
          },
          "descriptions": {
            "en": "Steals an item from an attacker that made direct contact.",
            "fr": "Vole l’objet que tient l’attaquant quand le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, ruba lo strumento di chi lo ha attaccato.",
            "de": "Stiehlt das Item des Angreifers bei Berührung.",
            "es": "Si el rival usa un movimiento de contacto al atacar, le roba el objeto.",
            "ko": "접촉한 상대의 도구를 훔친다."
          }
        },
        {
          "symbol": "technician",
          "textId": 101,
          "names": {
            "en": "Technician",
            "fr": "Technicien",
            "it": "Tecnico",
            "de": "Techniker",
            "es": "Experto",
            "ko": "테크니션"
          },
          "descriptions": {
            "en": "Powers up the Pokémon’s weaker moves.",
            "fr": "Augmente la puissance des capacités les plus faibles.",
            "it": "Potenzia le mosse più deboli del Pokémon.",
            "de": "Erhöht die Stärke von schwächeren Attacken.",
            "es": "Potencia sus movimientos más débiles.",
            "ko": "위력이 약한 기술의 위력을 올려서 공격할 수 있다."
          }
        },
        {
          "symbol": "quick_feet",
          "textId": 95,
          "names": {
            "en": "Quick Feet",
            "fr": "Pied Véloce",
            "it": "Piedisvelti",
            "de": "Rasanz",
            "es": "Pies Rápidos",
            "ko": "속보"
          },
          "descriptions": {
            "en": "Boosts the Speed stat if the Pokémon has a status condition.",
            "fr": "Augmente la Vitesse du Pokémon en cas d’altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, la Velocità aumenta.",
            "de": "Erhöht bei Statusproblemen die Initiative.",
            "es": "Aumenta la Velocidad si sufre problemas de estado.",
            "ko": "상태 이상이 되면 스피드가 올라간다."
          }
        }
      ],
