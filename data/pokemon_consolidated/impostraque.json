      "names": {
        "en": "Imposkull",
        "fr": "Impostraque",
        "it": "Entei",
        "de": "Entei",
        "es": "Entei",
        "ko": "앤테이"
      },
      "descriptions": {
        "en": "Entei embodies the passion of magma. This Pokémon is thought to have been born in the eruption of a volcano. It sends up massive bursts of fire that utterly consume all that they touch.",
        "fr": "",
        "it": "Entei rappresenta l’ardore del magma. Si narra che questo Pokémon sia nato dall’eruzione di un vulcano. Emette lingue di fuoco così violente da incenerire tutto ciò che lambiscono.",
        "de": "Entei verfügt über die Leidenschaft von Magma. Dieses Pokémon wurde bei einem Vulkanausbruch geboren und bringt Feuersbrünste hervor, die alles auslöschen, was mit ihnen in Kontakt kommt.",
        "es": "Entei contiene el fulgor del magma en su interior. Se cree que este Pokémon nació de la erupción de un volcán. Escupe numerosas ráfagas de fuego que devoran y reducen a cenizas todo lo que tocan.",
        "ko": "마그마의 정열이 깃들어 있는 포켓몬이다. 화산 분화 속에서 태어났다고 여겨지며 모든 것을 태워버리는 불꽃을 뿜어 올린다."
      },
      "abilities_data": [
        {
          "symbol": "arena_trap",
          "textId": 71,
          "names": {
            "en": "Arena Trap",
            "fr": "Piège Sable",
            "it": "Trappoarena",
            "de": "Ausweglos",
            "es": "Trampa Arena",
            "ko": "개미지옥"
          },
          "descriptions": {
            "en": "Prevents opposing Pokémon from fleeing.",
            "fr": "Empêche l’ennemi de s’enfuir.",
            "it": "Impedisce la fuga al nemico.",
            "de": "Hindert Gegner im Kampf an der Flucht.",
            "es": "Evita que el rival huya.",
            "ko": "배틀에서 상대를 도망칠 수 없게 한다."
          }
        },
        {
          "symbol": "sturdy",
          "textId": 5,
          "names": {
            "en": "Sturdy",
            "fr": "Fermeté",
            "it": "Vigore",
            "de": "Robustheit",
            "es": "Robustez",
            "ko": "옹골참"
          },
          "descriptions": {
            "en": "It cannot be knocked out with one hit. One-hit KO moves cannot knock it out, either.",
            "fr": "Le Pokémon encaisse toujours au moins une attaque s’il a tous ses PV. Il est également immunisé contre les capacités pouvant mettre K.O. en un coup.",
            "it": "Evita che il Pokémon vada KO in un sol colpo se ha tutti i PS, e lo rende immune alle mosse che causano KO immediato.",
            "de": "Bietet Schutz gegen K.O.-Attacken. Bei vollen KP übersteht das Pokémon auch K.O.-Treffer.",
            "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
            "ko": "상대 기술을 받아도 일격으로 쓰러지지 않는다. 일격필살 기술도 효과 없다."
          }
        },
        {
          "symbol": "sand_veil",
          "textId": 8,
          "names": {
            "en": "Sand Veil",
            "fr": "Voile Sable",
            "it": "Sabbiavelo",
            "de": "Sandschleier",
            "es": "Velo Arena",
            "ko": "모래숨기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s evasiveness in a sandstorm.",
            "fr": "Augmente l’Esquive du Pokémon lors des tempêtes de sable.",
            "it": "L’elusione aumenta durante le tempeste di sabbia.",
            "de": "Erhöht in Sandstürmen den Ausweichwert.",
            "es": "Aumenta su Evasión durante las tormentas de arena.",
            "ko": "모래바람일 때 회피율이 올라간다."
          }
        }
      ],
