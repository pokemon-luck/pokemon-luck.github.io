      "names": {
        "en": "Cryptipula",
        "fr": "Diablène",
        "it": "Snorlax",
        "de": "Relaxo",
        "es": "Snorlax",
        "ko": "잠만보"
      },
      "descriptions": {
        "en": "The vibrations caused by its buzzing are the reason for the malfunction of most electronic devices.",
        "fr": "Les vibrations provoquées par son bourdonnement sont la cause du disfonctionnement de la plupart des appareils électroniques.",
        "it": "Non fa altro che mangiare e dormire, ma quando decide di fare sul serio tira fuori una potenza eccezionale.",
        "de": "Wenn es nicht gerade frisst, dann schläft es. Macht es aber einmal Ernst, ist Schluss mit lustig.",
        "es": "Poco hace aparte de comer y dormir, pero puede desatar una fuerza arrolladora si le da un arrebato.",
        "ko": "먹거나 자는 것밖에 안 하지만 일단 진심을 다하게 되면 굉장한 파워를 발휘하는 듯하다."
      },
      "abilities_data": [
        {
          "symbol": "compound_eyes",
          "textId": 14,
          "names": {
            "en": "Compound Eyes",
            "fr": "Œil Composé",
            "it": "Insettocchi",
            "de": "Facettenauge",
            "es": "Ojo Compuesto",
            "ko": "복안"
          },
          "descriptions": {
            "en": "The Pokémon’s compound eyes boost its accuracy.",
            "fr": "Les yeux à facettes du Pokémon augmentent sa Précision.",
            "it": "La precisione del Pokémon aumenta grazie ai suoi occhi composti.",
            "de": "Erhöht die Genauigkeit von Attacken.",
            "es": "Aumenta la precisión de sus movimientos.",
            "ko": "복안을 가지고 있어 기술의 명중률이 올라간다."
          }
        },
        {
          "symbol": "swarm",
          "textId": 68,
          "names": {
            "en": "Swarm",
            "fr": "Essaim",
            "it": "Aiutinsetto",
            "de": "Hexaplaga",
            "es": "Enjambre",
            "ko": "벌레의알림"
          },
          "descriptions": {
            "en": "Powers up Bug-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Insecte du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Coleottero aumenta.",
            "de": "Erhöht die Stärke von Käfer-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Bicho cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 벌레타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "speed_boost",
          "textId": 3,
          "names": {
            "en": "Speed Boost",
            "fr": "Turbo",
            "it": "Acceleratore",
            "de": "Temposchub",
            "es": "Impulso",
            "ko": "가속"
          },
          "descriptions": {
            "en": "Its Speed stat is boosted every turn.",
            "fr": "La Vitesse du Pokémon augmente à chaque tour.",
            "it": "La Velocità aumenta a ogni turno.",
            "de": "Erhöht in jeder Runde die Initiative.",
            "es": "Aumenta su Velocidad en cada turno.",
            "ko": "매 턴 스피드가 올라간다."
          }
        }
      ],
