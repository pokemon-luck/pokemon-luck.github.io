      "names": {
        "en": "Giltalon",
        "fr": "Kintsugriffe",
        "it": "Combusken",
        "de": "Jungglut",
        "es": "Combusken",
        "ko": "영치코"
      },
      "descriptions": {
        "en": "When Giltalon feeds on rocks, its body synthesizes the metals to repair and heal its bony shell.",
        "fr": "Lorsque Kintsugriffe se nourrit de roches, son corps synthétise les métaux pour réparer et soigner sa carapace osseuse.",
        "it": "Combusken combatte sputando fiamme roventi dal becco e sferrando calci dall’enorme potenza distruttiva. Il verso di questo Pokémon è lacerante e distrae gli avversari.",
        "de": "Jungglut stößt im Kampf glühend heiße Flammen aus seinem Schnabel aus und setzt extrem vernichtende Tritte ein. Das Geschrei dieses Pokémon ist sehr laut und verwirrend.",
        "es": "Combusken lucha haciendo uso de las abrasadoras llamas que expulsa por el pico y de unas patadas fulminantes. Este Pokémon emite un sonido muy fuerte y molesto.",
        "ko": "부리에서 토해 내는 작열하는 불꽃과 뛰어난 파괴력의 킥으로 싸운다. 울음소리가 커서 무척 시끄럽다."
      },
      "abilities_data": [
        {
          "symbol": "strong_jaw",
          "textId": 173,
          "names": {
            "en": "Strong Jaw",
            "fr": "Prognathe",
            "it": "Ferromascella",
            "de": "Titankiefer",
            "es": "Mandíbula Fuerte",
            "ko": "옹골찬턱"
          },
          "descriptions": {
            "en": "The Pokémon’s strong jaw boosts the power of its biting moves.",
            "fr": "Le Pokémon a une mâchoire robuste qui augmente la puissance de ses capacités à base de morsures.",
            "it": "La robusta mascella del Pokémon permette morsi molto potenti.",
            "de": "Der kräftige Kiefer des Pokémon erhöht die Stärke von Biss-Attacken.",
            "es": "Su robusta mandíbula le confiere una mordedura potente.",
            "ko": "턱이 튼튼하여 무는 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "dry_skin",
          "textId": 87,
          "names": {
            "en": "Dry Skin",
            "fr": "Peau Sèche",
            "it": "Pellearsa",
            "de": "Trockenheit",
            "es": "Piel Seca",
            "ko": "건조피부"
          },
          "descriptions": {
            "en": "Restores HP in rain or when hit by Water-type moves. Reduces HP in harsh sunlight, and increases the damage received from Fire-type moves.",
            "fr": "Le Pokémon perd des PV quand le soleil brille, mais il en regagne lorsqu’il pleut ou s’il est touché par une capacité Eau. Il subit aussi plus de dégâts de Feu.",
            "it": "Il Pokémon recupera PS se piove o se subisce mosse di tipo Acqua, ma perde PS con la luce solare intensa. Subisce più danni da mosse di tipo Fuoco.",
            "de": "Bei Sonnenschein verliert das Pokémon KP und der Schaden durch Feuer-Attacken steigt. Bei Regen und Treffern durch Wasser-Attacken regeneriert es KP.",
            "es": "Pierde PS si hace sol y los recupera si llueve o recibe un movimiento de tipo Agua. Los movimientos de tipo Fuego, por su parte, le hacen más daño de lo normal.",
            "ko": "비가 오는 날씨나 물타입의 기술로 HP가 회복되고 맑을 때나 불꽃타입의 기술로는 줄어든다."
          }
        },
        {
          "symbol": "crackle",
          "textId": 312,
          "names": {
            "en": "Crackle",
            "fr": "Craquelure",
            "it": "Craquelure",
            "de": "Craquelure",
            "es": "Craquelure",
            "ko": "Craquelure"
          },
          "descriptions": {
            "en": "When hit by a physical move, the Pokémon's Attack and Speed rise by one stage, and its Defense falls by one stage.",
            "fr": "Quand le Pokémon subit une capacité physique, son Attaque et sa Vitesse augmentent d'un niveau, et sa Défense baisse d'un niveau.",
            "it": "",
            "de": "",
            "es": "",
            "ko": ""
          }
        }
      ],
