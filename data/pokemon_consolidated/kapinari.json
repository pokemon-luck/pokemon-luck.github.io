      "names": {
        "en": "Kapinari",
        "fr": "Kapinari",
        "it": "Umbreon",
        "de": "Nachtara",
        "es": "Umbreon",
        "ko": "블래키"
      },
      "descriptions": {
        "en": "A lovely pond is all it takes for the happiness of Kapinari. Masters of idleness, they are the ideal Pokémon for trainers in need of a vacation!",
        "fr": "Une jolie mare suffit au bonheur des Kapinari. Professionels de l'oisiveté, ce sont les pokémons idéaux pour les dresseurs qui ont besoin de vacances !",
        "it": "È un Pokémon notturno. Le sue grandi pupille gli permettono di vedere chiaramente le prede anche nell’oscurità più profonda.",
        "de": "Die Pupillen dieses nachtaktiven Pokémon sind groß genug, um auch in der schwärzesten Nacht noch seine Beute deutlich erkennen zu können.",
        "es": "Un Pokémon de hábitos nocturnos. Sus grandes pupilas le permiten distinguir con total claridad a sus presas en la más densa oscuridad.",
        "ko": "야행성 포켓몬. 큰 눈동자는 칠흑 같은 어둠에서도 먹이의 모습을 정확하게 찾아낸다."
      },
      "abilities_data": [
