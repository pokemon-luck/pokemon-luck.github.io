      "names": {
        "en": "Folkenstein",
        "fr": "Frankentroll",
        "it": "Corsola",
        "de": "Corasonn",
        "es": "Corsola",
        "ko": "코산호"
      },
      "descriptions": {
        "en": "Seeing eternal life as a burden, Folkenstein always carries its last resting place on its back.",
        "fr": "Voyant la vie éternelle comme un fardeau, Frankentroll traine toujours sa dernière demeure sur son dos.",
        "it": "I Corsola che vivono ad Alola sono di un colore rosa intenso e brillante grazie alle acque marine ricche di elementi nutritivi.",
        "de": "Aufgrund des nährstoffreichen Meeres ist das Pink der in Alola lebenden Corasonn besonders strahlend und kräftig.",
        "es": "La coloración rosa de los ejemplares de Alola es extraordinariamente viva e intensa debido a la abundancia de nutrientes de sus aguas.",
        "ko": "알로라에 사는 코산호는 핑크가 매우 선명하고 짙다. 영양이 풍부한 바다 덕분이다."
      },
      "abilities_data": [
        {
          "symbol": "thick_fat",
          "textId": 47,
          "names": {
            "en": "Thick Fat",
            "fr": "Isograisse",
            "it": "Grassospesso",
            "de": "Speckschicht",
            "es": "Sebo",
            "ko": "두꺼운지방"
          },
          "descriptions": {
            "en": "The Pokémon is protected by a layer of thick fat, which halves the damage taken from Fire- and Ice-type moves.",
            "fr": "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu’il subit des capacités de types Feu et Glace.",
            "it": "Il Pokémon è protetto da uno spesso strato di grasso che dimezza il danno causato da mosse di tipo Fuoco e Ghiaccio.",
            "de": "Das Pokémon wird von einer dicken Fettschicht geschützt, was den durch Feuer- und Eis-Attacken erlittenen Schaden halbiert.",
            "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
            "ko": "두꺼운 지방으로 보호되고 있어 불꽃타입과 얼음타입의 기술의 데미지를 반감시킨다."
          }
        },
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        },
        {
          "symbol": "regenerator",
          "textId": 144,
          "names": {
            "en": "Regenerator",
            "fr": "Régé-Force",
            "it": "Rigenergia",
            "de": "Belebekraft",
            "es": "Regeneración",
            "ko": "재생력"
          },
          "descriptions": {
            "en": "Restores a little HP when withdrawn from battle.",
            "fr": "Restaure un peu de PV si le Pokémon est retiré du combat.",
            "it": "Il Pokémon recupera un po’ di PS quando lascia il campo.",
            "de": "Wird das Pokémon ausgewechselt, regeneriert es eine kleine Menge an KP.",
            "es": "Recupera unos pocos PS al ser cambiado por otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 HP를 조금 회복한다."
          }
        }
      ],
