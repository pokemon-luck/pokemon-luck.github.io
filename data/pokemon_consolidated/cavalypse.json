      "names": {
        "en": "Cavalypse",
        "fr": "Cavalypse",
        "it": "Gloom",
        "de": "Duflor",
        "es": "Gloom",
        "ko": "냄새꼬"
      },
      "descriptions": {
        "en": "Cavalypse exists only on the border between life and death.",
        "fr": "Cavalypse n'existe que sur la frontière entre la vie et la mort.",
        "it": "Dalla bocca di Gloom fuoriesce una resina maleodorante e disgustosa. Evidentemente adora questo fetido olezzo, poiché lo annusa avidamente producendo poi altra resina.",
        "de": "Aus Duflors Mund tropft übelst riechender Honig. Diesen Gestank scheint es zu lieben, denn es schnieft die giftigen Dämpfe ein und sabbert danach noch mehr Honig.",
        "es": "Gloom babea un néctar que tiene un olor realmente horrible, aunque parece ser que a él le gusta. De hecho, aspira los gases nocivos y libera más néctar aún.",
        "ko": "아무래도 냄새꼬는 입에서 나는 맹렬한 악취를 매우 좋아하는 것 같다. 냄새를 맡으면 더욱 꿀이 넘쳐난다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "aftermath",
          "textId": 106,
          "names": {
            "en": "Aftermath",
            "fr": "Boom Final",
            "it": "Scoppio",
            "de": "Finalschlag",
            "es": "Detonación",
            "ko": "유폭"
          },
          "descriptions": {
            "en": "Damages the attacker if it contacts the Pokémon with a finishing hit.",
            "fr": "Si le Pokémon est mis K.O. par une attaque directe, il inflige des dégâts à l’attaquant avant de s’évanouir.",
            "it": "Chi manda KO questo Pokémon con un attacco diretto subisce dei danni.",
            "de": "Wird das Pokémon durch eine direkte Attacke besiegt, fügt es dem Angreifer Schaden zu.",
            "es": "Daña al agresor que le ha dado el golpe de gracia con un movimiento de contacto.",
            "ko": "기절했을 때 접촉한 상대에게 데미지를 준다."
          }
        }
      ],
