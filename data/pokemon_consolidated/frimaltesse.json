      "names": {
        "en": "Fearenheit",
        "fr": "Frimaltesse",
        "it": "Hypno",
        "de": "Hypno",
        "es": "Hypno",
        "ko": "슬리퍼"
      },
      "descriptions": {
        "en": "It is not impossible to see the silhouette of a Fearenheit through thick hail or snowstorms.",
        "fr": "Il n'est pas impossible d'observer la silhouette d'un Frimaltesse à travers les épaisses tempêtes de grêle ou de neige.",
        "it": "Ad Alola, gli Hypno prendono di mira soprattutto i Komala e raramente disturbano gli esseri umani.",
        "de": "In Alola hat es Hypno hauptsächlich auf Koalelu abgesehen. Menschen schadet es kaum.",
        "es": "En Alola, los altercados con humanos son escasos, ya que el objetivo predilecto de los Hypno son los Komala.",
        "ko": "알로라에서 사는 슬리퍼의 타깃은 주로 자말라다. 사람은 그다지 피해를 입지 않는다."
      },
      "abilities_data": [
        {
          "symbol": "queenly_majesty",
          "textId": 214,
          "names": {
            "en": "Queenly Majesty",
            "fr": "Prestance Royale",
            "it": "Regalità",
            "de": "Majestät",
            "es": "Regia Presencia",
            "ko": "여왕의위엄"
          },
          "descriptions": {
            "en": "Its majesty pressures the opposing Pokémon, making it unable to attack using priority moves.",
            "fr": "L’adversaire est impressionné par la majesté du Pokémon et ne peut pas le viser avec une attaque prioritaire.",
            "it": "L’aura di regalità del Pokémon impedisce al nemico di attaccarlo con mosse che hanno priorità alta.",
            "de": "Schüchtert Gegner ein und hindert sie so daran, Erstschlag-Attacken gegen es einzusetzen.",
            "es": "Intimida al objetivo y le impide usar movimientos con prioridad.",
            "ko": "상대에게 위압감을 줘서 이쪽을 향한 선제 기술을 사용할 수 없게 한다."
          }
        },
        {
          "symbol": "serene_grace",
          "textId": 32,
          "names": {
            "en": "Serene Grace",
            "fr": "Sérénité",
            "it": "Leggiadro",
            "de": "Edelmut",
            "es": "Dicha",
            "ko": "하늘의은총"
          },
          "descriptions": {
            "en": "Boosts the likelihood of additional effects occurring when attacking.",
            "fr": "Augmente les chances d’infliger des effets additionnels.",
            "it": "Rende più probabili gli effetti aggiuntivi delle mosse.",
            "de": "Erhöht die Wahrscheinlichkeit, dass Zusatzeffekte von Attacken auftreten.",
            "es": "Aumenta la probabilidad de que los movimientos causen efectos secundarios.",
            "ko": "하늘의 은총 덕분에 기술의 추가 효과가 나오기 쉽다."
          }
        },
        {
          "symbol": "snow_cloak",
          "textId": 81,
          "names": {
            "en": "Snow Cloak",
            "fr": "Rideau Neige",
            "it": "Mantelneve",
            "de": "Schneemantel",
            "es": "Manto Níveo",
            "ko": "눈숨기"
          },
          "descriptions": {
            "en": "Boosts evasiveness in a hailstorm.",
            "fr": "Augmente l’Esquive du Pokémon durant les tempêtes de grêle.",
            "it": "Se grandina, l’elusione aumenta.",
            "de": "Erhöht bei Hagel den Ausweichwert.",
            "es": "Sube la Evasión cuando graniza.",
            "ko": "날씨가 싸라기눈일 때 회피율이 올라간다."
          }
        }
      ],
