      "names": {
        "en": "Slumbeast",
        "fr": "Caucheman",
        "it": "Seaking",
        "de": "Golking",
        "es": "Seaking",
        "ko": "왕콘치"
      },
      "descriptions": {
        "en": "Some people suffering from insomnia will have the misfortune of catching a glimpse of a Slumbeast lurking in the corner of the room.",
        "fr": "Certaines personnes souffrant d'insomnies auront la malchance d'apercevoir un Caucheman les épiant dans le coin de la pièce.",
        "it": "Facendo girare il corno come la punta di un trapano perfora anche la roccia. I maschi hanno colori più sgargianti.",
        "de": "Sein Horn rotiert wie ein Bohrer und höhlt selbst die härtesten Felsen aus. Männliche Golking erstrahlen in besonders prächtigen Farben.",
        "es": "Es capaz de pulverizar las rocas más duras haciendo girar su cuerno a modo de taladro. Los machos presentan una coloración más viva.",
        "ko": "뿔이 드릴처럼 회전하기 때문에 단단한 바위도 쉽게 뚫는다. 수컷이 선명한 색을 띤다."
      },
      "abilities_data": [
        {
          "symbol": "shadow_tag",
          "textId": 23,
          "names": {
            "en": "Shadow Tag",
            "fr": "Marque Ombre",
            "it": "Pedinombra",
            "de": "Wegsperre",
            "es": "Sombra Trampa",
            "ko": "그림자밟기"
          },
          "descriptions": {
            "en": "This Pokémon steps on the opposing Pokémon’s shadow to prevent it from escaping.",
            "fr": "Empêche les Pokémon ennemis de quitter le combat.",
            "it": "Il Pokémon calpesta l’ombra del nemico impedendogli la fuga o la sostituzione.",
            "de": "Hindert Gegner an der Flucht beziehungsweise am Auswechseln, indem es ihnen den Weg versperrt.",
            "es": "Impide que el enemigo huya o sea cambiado por otro.",
            "ko": "상대의 그림자를 밟아 도망치거나 교체할 수 없게 한다."
          }
        },
        {
          "symbol": "insomnia",
          "textId": 15,
          "names": {
            "en": "Insomnia",
            "fr": "Insomnia",
            "it": "Insonnia",
            "de": "Insomnia",
            "es": "Insomnio",
            "ko": "불면"
          },
          "descriptions": {
            "en": "The Pokémon is suffering from insomnia and cannot fall asleep.",
            "fr": "Le Pokémon est incapable de dormir.",
            "it": "Il Pokémon soffre d’insonnia e non può addormentarsi.",
            "de": "Verhindert Einschlafen.",
            "es": "Su resistencia al sueño le impide quedarse dormido.",
            "ko": "잠들지 못하는 체질이라 잠듦 상태가 되지 않는다."
          }
        },
        {
          "symbol": "bad_dreams",
          "textId": 123,
          "names": {
            "en": "Bad Dreams",
            "fr": "Mauvais Rêve",
            "it": "Sogniamari",
            "de": "Alptraum",
            "es": "Mal Sueño",
            "ko": "나이트메어"
          },
          "descriptions": {
            "en": "Reduces the HP of sleeping opposing Pokémon.",
            "fr": "Inflige des dégâts aux ennemis endormis.",
            "it": "Infligge danni ai nemici addormentati.",
            "de": "Fügt schlafenden Gegnern Schaden zu.",
            "es": "Inflige daño a cualquier rival que esté dormido.",
            "ko": "잠듦 상태의 상대에게 데미지를 준다."
          }
        }
      ],
