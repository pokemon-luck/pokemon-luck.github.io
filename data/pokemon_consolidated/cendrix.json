      "names": {
        "en": "Partrinder",
        "fr": "Cendrix",
        "it": "Machop",
        "de": "Machollo",
        "es": "Machop",
        "ko": "알통몬"
      },
      "descriptions": {
        "en": "Partrinder's feathers are among the necessary ingredients for the creation of Revives.",
        "fr": "Les plumes de Cendrix font partie des ingrédients nécessaires à la conception des Rappel.",
        "it": "Si allena assieme ai suoi simili per sviluppare i muscoli e acquisire sicurezza. Quando si sente pronto, sfida Makuhita.",
        "de": "Wenn es im Training mit seinen Kameraden genug Selbstvertrauen und Muskeln aufgebaut hat, fordert es Makuhita zu einem Kampf heraus.",
        "es": "Entrena con sus congéneres para potenciar su musculatura y confianza en sí mismo y, llegado el momento, reta en combate a los Makuhita.",
        "ko": "동료들과의 트레이닝으로 자신감과 근육이 생기면 마크탕에게 대결을 신청한다."
      },
      "abilities_data": [
        {
          "symbol": "flame_body",
          "textId": 49,
          "names": {
            "en": "Flame Body",
            "fr": "Corps Ardent",
            "it": "Corpodifuoco",
            "de": "Flammkörper",
            "es": "Cuerpo Llama",
            "ko": "불꽃몸"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may burn the attacker.",
            "fr": "Peut brûler l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può scottare chi manda a segno un attacco diretto.",
            "de": "Fügt dem Angreifer bei Berührung eventuell Verbrennungen zu.",
            "es": "Puede quemar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 화상 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "regenerator",
          "textId": 144,
          "names": {
            "en": "Regenerator",
            "fr": "Régé-Force",
            "it": "Rigenergia",
            "de": "Belebekraft",
            "es": "Regeneración",
            "ko": "재생력"
          },
          "descriptions": {
            "en": "Restores a little HP when withdrawn from battle.",
            "fr": "Restaure un peu de PV si le Pokémon est retiré du combat.",
            "it": "Il Pokémon recupera un po’ di PS quando lascia il campo.",
            "de": "Wird das Pokémon ausgewechselt, regeneriert es eine kleine Menge an KP.",
            "es": "Recupera unos pocos PS al ser cambiado por otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 HP를 조금 회복한다."
          }
        },
        {
          "symbol": "magic_guard",
          "textId": 98,
          "names": {
            "en": "Magic Guard",
            "fr": "Garde Magik",
            "it": "Magicscudo",
            "de": "Magieschild",
            "es": "Muro Mágico",
            "ko": "매직가드"
          },
          "descriptions": {
            "en": "The Pokémon only takes damage from attacks.",
            "fr": "Seules les attaques peuvent blesser le Pokémon.",
            "it": "Il Pokémon subisce danni solo dagli attacchi.",
            "de": "Das Pokémon nimmt nur durch Offensiv-Attacken Schaden.",
            "es": "Solo recibe daño de ataques.",
            "ko": "공격 이외에는 데미지를 입지 않는다."
          }
        }
      ],
