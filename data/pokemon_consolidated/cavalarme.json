      "names": {
        "en": "Kelpony",
        "fr": "Cavalarme",
        "it": "Jigglypuff",
        "de": "Pummeluff",
        "es": "Jigglypuff",
        "ko": "푸린"
      },
      "descriptions": {
        "en": "Kelpony is present to mourn all the victims of shipwrecks.",
        "fr": "Cavalarme est présent pour pleurer toutes les victimes de naufrages.",
        "it": "Ai grandi magazzini nel reparto camera da letto sono in vendita dei CD con la registrazione della misteriosa ninnananna cantata da Jigglypuff.",
        "de": "In der Bettenabteilung von Kaufhäusern erhält man auch CDs mit Pummeluffs wundersam einlullendem Gesang.",
        "es": "En la sección de muebles de dormitorio de los grandes almacenes se pueden encontrar discos recopilatorios de nanas cantadas por Jigglypuff.",
        "ko": "백화점 침구 코너에는 푸린의 신비한 자장가를 수록한 CD를 판매하고 있다."
      },
      "abilities_data": [
        {
          "symbol": "torrent",
          "textId": 67,
          "names": {
            "en": "Torrent",
            "fr": "Torrent",
            "it": "Acquaiuto",
            "de": "Sturzbach",
            "es": "Torrente",
            "ko": "급류"
          },
          "descriptions": {
            "en": "Powers up Water-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Eau du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Acqua aumenta.",
            "de": "Erhöht die Stärke von Wasser-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Agua cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 물타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "propeller_tail",
          "textId": 239,
          "names": {
            "en": "Propeller Tail",
            "fr": "Propulseur",
            "it": "Elicopinna",
            "de": "Schraubflosse",
            "es": "Hélice Caudal",
            "ko": "스크루지느러미"
          },
          "descriptions": {
            "en": "Ignores the effects of opposing Pokémon’s Abilities and moves that draw in moves.",
            "fr": "Ignore les effets des capacités ou des talents attirant les capacités.",
            "it": "Permette di ignorare gli effetti di mosse e abilità che attirano altre mosse.",
            "de": "Ignoriert die Effekte von Fähigkeiten und Attacken anderer Pokémon, die Attacken auf sich lenken.",
            "es": "Impide que el rival pueda atraer ataques hacia sí mismo por efecto de su habilidad o sus movimientos.",
            "ko": "상대의 기술을 끌어모으는 특성이나 기술의 영향을 받지 않는다."
          }
        },
        {
          "symbol": "multiscale",
          "textId": 136,
          "names": {
            "en": "Multiscale",
            "fr": "Multiécaille",
            "it": "Multisquame",
            "de": "Multischuppe",
            "es": "Multiescamas",
            "ko": "멀티스케일"
          },
          "descriptions": {
            "en": "Reduces the amount of damage the Pokémon takes while its HP is full.",
            "fr": "Le Pokémon reçoit moins de dégâts quand ses PV sont au maximum.",
            "it": "Se i PS sono al massimo, riduce il danno subito.",
            "de": "Verringert den erlittenen Schaden bei vollen KP.",
            "es": "Reduce el daño que sufre si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 받는 데미지가 줄어든다."
          }
        }
      ],
