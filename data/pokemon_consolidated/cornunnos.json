      "names": {
        "en": "Fernunnos",
        "fr": "Cornunnos",
        "it": "Ho-Oh",
        "de": "Ho-Oh",
        "es": "Ho-Oh",
        "ko": "칠색조"
      },
      "descriptions": {
        "en": "Ho-Oh’s feathers glow in seven colors depending on the angle at which they are struck by light. These feathers are said to bring happiness to the bearers. This Pokémon is said to live at the foot of a rainbow.",
        "fr": "",
        "it": "Il piumaggio di Ho-Oh brilla in sette colori a seconda dell’angolazione dei raggi luminosi. Si dice che le sue piume portino felicità a chi le possiede. Si narra che viva ai piedi di un arcobaleno.",
        "de": "Ho-Ohs Federn leuchten in sieben Farben, je nachdem aus welchem Winkel das Licht auf sie fällt. Die Federn sollen ihrem Besitzer Glück bringen. Dieses Pokémon lebt am Fuße eines Regenbogens.",
        "es": "El plumaje de Ho-Oh contiene siete colores que pueden apreciarse según el ángulo desde el que les dé la luz. Dicen que sus plumas dan felicidad a quienes las llevan y, también, que este Pokémon vive a los pies del arco iris.",
        "ko": "빛이 닿는 각도에 따라 일곱 빛깔로 반짝이는 깃털은 행복을 가져다준다고 한다. 무지개 끝에 산다고 전해진다."
      },
      "abilities_data": [
        {
          "symbol": "overgrow",
          "textId": 65,
          "names": {
            "en": "Overgrow",
            "fr": "Engrais",
            "it": "Erbaiuto",
            "de": "Notdünger",
            "es": "Espesura",
            "ko": "심록"
          },
          "descriptions": {
            "en": "Powers up Grass-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Plante du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Erba aumenta.",
            "de": "Erhöht die Stärke von Pflanzen-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Planta cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 풀타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "thick_fat",
          "textId": 47,
          "names": {
            "en": "Thick Fat",
            "fr": "Isograisse",
            "it": "Grassospesso",
            "de": "Speckschicht",
            "es": "Sebo",
            "ko": "두꺼운지방"
          },
          "descriptions": {
            "en": "The Pokémon is protected by a layer of thick fat, which halves the damage taken from Fire- and Ice-type moves.",
            "fr": "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu’il subit des capacités de types Feu et Glace.",
            "it": "Il Pokémon è protetto da uno spesso strato di grasso che dimezza il danno causato da mosse di tipo Fuoco e Ghiaccio.",
            "de": "Das Pokémon wird von einer dicken Fettschicht geschützt, was den durch Feuer- und Eis-Attacken erlittenen Schaden halbiert.",
            "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
            "ko": "두꺼운 지방으로 보호되고 있어 불꽃타입과 얼음타입의 기술의 데미지를 반감시킨다."
          }
        },
        {
          "symbol": "ashen_fertilizer",
          "textId": 310,
          "names": {
            "en": "Ashen Fertilizer",
            "fr": "Engrais Cendreux",
            "it": "Engrais Cendreux",
            "de": "Engrais Cendreux",
            "es": "Engrais Cendreux",
            "ko": "Engrais Cendreux"
          },
          "descriptions": {
            "en": "The Pokémon's Sp. Def rises if hit by a Fire-type move, which then deals no damage.",
            "fr": "La Défense Spéciale du Pokémon augmente s'il est touché par une capacité de type Feu, qui n'a alors aucun effet.",
            "it": "",
            "de": "",
            "es": "",
            "ko": ""
          }
        }
      ],
