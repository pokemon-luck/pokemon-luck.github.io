      "names": {
        "en": "Snailke",
        "fr": "Colimarrant",
        "it": "Exeggcute",
        "de": "Owei",
        "es": "Exeggcute",
        "ko": "아라리"
      },
      "descriptions": {
        "en": "To gain speed, Snailke does not hesitate to retract into its hard shell to roll down the slopes.",
        "fr": "Pour gagner de la vitesse, Colimarrant n'hésite pas à se replier dans sa dure coquille pour dévaler les pentes en roulant.",
        "it": "Ciascun Pokémon è formato da sei individui. Anche se dovesse sparirne uno per qualche motivo, la mattina dopo sarebbero di nuovo sei.",
        "de": "Dieses Pokémon besteht aus sechs Individuen. Geht eines verloren, sind es am nächsten Morgen trotzdem auf jeden Fall wieder sechs.",
        "es": "Seis criaturas en una. Si Exeggcute pierde alguno de los huevos que lo componen, este volverá a crecer a la mañana siguiente.",
        "ko": "6마리가 1마리다. 어쩌다 1마리가 줄어도 다음날 아침이 되면 다시 6마리로 돌아와 있다."
      },
      "abilities_data": [
        {
          "symbol": "shell_armor",
          "textId": 75,
          "names": {
            "en": "Shell Armor",
            "fr": "Coque Armure",
            "it": "Guscioscudo",
            "de": "Panzerhaut",
            "es": "Caparazón",
            "ko": "조가비갑옷"
          },
          "descriptions": {
            "en": "A hard shell protects the Pokémon from critical hits.",
            "fr": "Le Pokémon est protégé des coups critiques par sa carapace.",
            "it": "Il Pokémon è protetto da un guscio robusto che gli evita di subire brutti colpi.",
            "de": "Wehrt gegnerische Volltreffer mit einem harten Panzer ab.",
            "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
            "ko": "단단한 껍질의 보호를 받아 상대의 공격이 급소에 맞지 않는다."
          }
        },
        {
          "symbol": "rough_skin",
          "textId": 24,
          "names": {
            "en": "Rough Skin",
            "fr": "Peau Dure",
            "it": "Cartavetro",
            "de": "Rauhaut",
            "es": "Piel Tosca",
            "ko": "까칠한피부"
          },
          "descriptions": {
            "en": "This Pokémon inflicts damage with its rough skin to the attacker on contact.",
            "fr": "Blesse l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon è colpito da un attacco diretto, grazie alla sua pelle ruvida infligge danni a sua volta.",
            "de": "Angreifer werden durch die raue Haut des Pokémon bei direkten Attacken verletzt.",
            "es": "Hiere con su piel áspera al rival que lo ataque con un movimiento de contacto.",
            "ko": "공격을 받았을 때 자신에게 접촉한 상대를 까칠까칠한 피부로 상처를 입힌다."
          }
        },
        {
          "symbol": "bulletproof",
          "textId": 171,
          "names": {
            "en": "Bulletproof",
            "fr": "Pare-Balles",
            "it": "Antiproiettile",
            "de": "Kugelsicher",
            "es": "Antibalas",
            "ko": "방탄"
          },
          "descriptions": {
            "en": "Protects the Pokémon from some ball and bomb moves.",
            "fr": "Protège de certaines capacités lançant des projectiles comme des bombes et des balles.",
            "it": "Protegge da alcune mosse a base di proiettili e bombe.",
            "de": "Kann das Pokémon vor geworfenen kugelförmigen Objekten, wie zum Beispiel Bomben, schützen.",
            "es": "No le afectan las bombas ni algunos proyectiles.",
            "ko": "상대 구슬이나 폭탄 등 기술을 막을 수 있다."
          }
        }
      ],
