      "names": {
        "en": "Lockoon",
        "fr": "Camivol",
        "it": "Jynx",
        "de": "Rossana",
        "es": "Jynx",
        "ko": "루주라"
      },
      "descriptions": {
        "en": "Years of confinement have forced it to adapt and merge with its straitjacket, which it has learned to use as a weapon.",
        "fr": "Des années d'enfermement l'ont obligé à s'adapter et ne plus faire qu'un avec sa camisole qu'il aura appris à utiliser comme une arme.",
        "it": "Cammina ancheggiando a un ritmo tutto suo. I movimenti dei Jynx della regione di Alola sono particolarmente affascinanti.",
        "de": "Es bewegt seine Hüften in einem eigentümlichen Rhythmus. Rossana in Alola beherrschen einen besonders anmutigen Hüftschwung.",
        "es": "Se bambolea con un ritmo peculiar que, en el caso de los ejemplares que viven en Alola, es realmente cautivador.",
        "ko": "독특한 리듬으로 허리를 흔든다. 알로라에 사는 루주라는 그 동작이 실로 훌륭하다."
      },
      "abilities_data": [
        {
          "symbol": "pickpocket",
          "textId": 124,
          "names": {
            "en": "Pickpocket",
            "fr": "Pickpocket",
            "it": "Arraffalesto",
            "de": "Langfinger",
            "es": "Hurto",
            "ko": "나쁜손버릇"
          },
          "descriptions": {
            "en": "Steals an item from an attacker that made direct contact.",
            "fr": "Vole l’objet que tient l’attaquant quand le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, ruba lo strumento di chi lo ha attaccato.",
            "de": "Stiehlt das Item des Angreifers bei Berührung.",
            "es": "Si el rival usa un movimiento de contacto al atacar, le roba el objeto.",
            "ko": "접촉한 상대의 도구를 훔친다."
          }
        },
        {
          "symbol": "technician",
          "textId": 101,
          "names": {
            "en": "Technician",
            "fr": "Technicien",
            "it": "Tecnico",
            "de": "Techniker",
            "es": "Experto",
            "ko": "테크니션"
          },
          "descriptions": {
            "en": "Powers up the Pokémon’s weaker moves.",
            "fr": "Augmente la puissance des capacités les plus faibles.",
            "it": "Potenzia le mosse più deboli del Pokémon.",
            "de": "Erhöht die Stärke von schwächeren Attacken.",
            "es": "Potencia sus movimientos más débiles.",
            "ko": "위력이 약한 기술의 위력을 올려서 공격할 수 있다."
          }
        },
        {
          "symbol": "quick_feet",
          "textId": 95,
          "names": {
            "en": "Quick Feet",
            "fr": "Pied Véloce",
            "it": "Piedisvelti",
            "de": "Rasanz",
            "es": "Pies Rápidos",
            "ko": "속보"
          },
          "descriptions": {
            "en": "Boosts the Speed stat if the Pokémon has a status condition.",
            "fr": "Augmente la Vitesse du Pokémon en cas d’altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, la Velocità aumenta.",
            "de": "Erhöht bei Statusproblemen die Initiative.",
            "es": "Aumenta la Velocidad si sufre problemas de estado.",
            "ko": "상태 이상이 되면 스피드가 올라간다."
          }
        }
      ],
