      "names": {
        "en": "Urserker",
        "fr": "Urserker",
        "it": "Sentret",
        "de": "Wiesor",
        "es": "Sentret",
        "ko": "꼬리선"
      },
      "descriptions": {
        "en": "The hunter becoming the hunted, Urseker loves to chase poachers to give them a good scare.",
        "fr": "Le chasseur devenant le chasser, Urseker adore poursuivre les braconniers pour leur faire une belle peur.",
        "it": "Sentret dorme soltanto se un suo simile rimane vigile. La vedetta allerta gli altri al primo segnale di pericolo. Se viene allontanato dal branco, questo Pokémon non riesce più a dormire dalla paura.",
        "de": "Wenn Wiesor schläft, hält immer jemand Wache. Beim ersten Anflug von Gefahr weckt die Wache die anderen auf. Wenn dieses Pokémon von seinen Artgenossen getrennt wird, kann es vor Angst nicht mehr schlafen.",
        "es": "Sentret no duerme a menos que otro haga guardia. El que hace de centinela lo despertará al mínimo signo de peligro. Cuando este Pokémon se separa de su manada, es incapaz de echarse a dormir, presa del miedo.",
        "ko": "잠잘 때는 교대로 망을 본다. 위험을 탐지하면 동료를 깨운다. 무리에서 떨어지면 무서워서 자지 못한다."
      },
      "abilities_data": [
        {
          "symbol": "battle_armor",
          "textId": 4,
          "names": {
            "en": "Battle Armor",
            "fr": "Armurbaston",
            "it": "Lottascudo",
            "de": "Kampfpanzer",
            "es": "Armadura Batalla",
            "ko": "전투무장"
          },
          "descriptions": {
            "en": "Hard armor protects the Pokémon from critical hits.",
            "fr": "Le Pokémon est protégé des coups critiques par une solide carapace.",
            "it": "Il Pokémon è protetto da una dura corazza che gli evita di subire brutti colpi.",
            "de": "Wehrt gegnerische Volltreffer mit einem harten Panzer ab.",
            "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
            "ko": "단단한 껍질에 보호받아 상대의 공격이 급소에 맞지 않는다."
          }
        },
        {
          "symbol": "heavy_metal",
          "textId": 134,
          "names": {
            "en": "Heavy Metal",
            "fr": "Heavy Metal",
            "it": "Metalpesante",
            "de": "Schwermetall",
            "es": "Metal Pesado",
            "ko": "헤비메탈"
          },
          "descriptions": {
            "en": "Doubles the Pokémon’s weight.",
            "fr": "Double le poids du Pokémon.",
            "it": "Raddoppia il peso del Pokémon.",
            "de": "Verdoppelt das eigene Gewicht.",
            "es": "Duplica su peso.",
            "ko": "자신의 무게가 2배가 된다."
          }
        },
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        }
      ],
