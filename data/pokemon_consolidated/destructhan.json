      "names": {
        "en": "Destructhan",
        "fr": "Destructhan",
        "it": "Electrode",
        "de": "Lektrobal",
        "es": "Electrode",
        "ko": "붐볼"
      },
      "descriptions": {
        "en": "Destructhan traps its prey in a thick block of ice before devouring them.",
        "fr": "Destructhan enferme ses proies dans un épais bloc de glace avant de les dévorer.",
        "it": "Una delle caratteristiche di Electrode è la sua affinità con l’elettricità. Si tratta di un Pokémon problematico che spesso si raduna attorno alle centrali elettriche per trarre nutrimento dall’elettricità appena generata.",
        "de": "Typisch für Lektrobal ist seine große Faszination für Elektrizität. Es ist ein problematisches Pokémon, das sich meistens in Kraftwerken niederlässt, wo es sich von frisch erzeugtem Strom ernähren kann.",
        "es": "Una de las características de Electrode es la atracción que siente hacia la electricidad. Son Pokémon problemáticos que suelen agruparse cerca de centrales eléctricas para nutrirse de la energía recién generada.",
        "ko": "전기에 끌리는 성질을 지녔다. 주로 발전소에 모여서 막 만들어진 전기를 먹어버리는 말썽꾼이다."
      },
      "abilities_data": [
        {
          "symbol": "water_veil",
          "textId": 41,
          "names": {
            "en": "Water Veil",
            "fr": "Ignifu-Voile",
            "it": "Idrovelo",
            "de": "Aquahülle",
            "es": "Velo Agua",
            "ko": "수의베일"
          },
          "descriptions": {
            "en": "The Pokémon is covered with a water veil, which prevents the Pokémon from getting a burn.",
            "fr": "Le voile qui recouvre le Pokémon le protège des brûlures.",
            "it": "Un velo d’acqua riveste il corpo del Pokémon impedendogli di venire scottato.",
            "de": "Verhindert durch eine Hülle aus Wasser Verbrennungen.",
            "es": "Evita las quemaduras gracias a la capa de agua que lo envuelve.",
            "ko": "물의 베일을 몸에 둘러서 화상 상태가 되지 않는다."
          }
        },
        {
          "symbol": "pressure",
          "textId": 46,
          "names": {
            "en": "Pressure",
            "fr": "Pression",
            "it": "Pressione",
            "de": "Erzwinger",
            "es": "Presión",
            "ko": "프레셔"
          },
          "descriptions": {
            "en": "By putting pressure on the opposing Pokémon, it raises their PP usage.",
            "fr": "Met la pression à l’ennemi pour le forcer à dépenser plus de PP.",
            "it": "Il Pokémon mette pressione al nemico, facendogli consumare più PP.",
            "de": "Zwingt Gegner dazu, beim Einsatz von Attacken mehr AP zu verbrauchen.",
            "es": "Presiona al rival para que sus PP se acaben antes.",
            "ko": "프레셔를 줘서 상대가 쓰는 기술의 PP를 많이 줄인다."
          }
        },
        {
          "symbol": "thick_fat",
          "textId": 47,
          "names": {
            "en": "Thick Fat",
            "fr": "Isograisse",
            "it": "Grassospesso",
            "de": "Speckschicht",
            "es": "Sebo",
            "ko": "두꺼운지방"
          },
          "descriptions": {
            "en": "The Pokémon is protected by a layer of thick fat, which halves the damage taken from Fire- and Ice-type moves.",
            "fr": "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu’il subit des capacités de types Feu et Glace.",
            "it": "Il Pokémon è protetto da uno spesso strato di grasso che dimezza il danno causato da mosse di tipo Fuoco e Ghiaccio.",
            "de": "Das Pokémon wird von einer dicken Fettschicht geschützt, was den durch Feuer- und Eis-Attacken erlittenen Schaden halbiert.",
            "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
            "ko": "두꺼운 지방으로 보호되고 있어 불꽃타입과 얼음타입의 기술의 데미지를 반감시킨다."
          }
        }
      ],
