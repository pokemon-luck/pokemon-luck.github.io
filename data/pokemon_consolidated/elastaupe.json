      "names": {
        "en": "Molastic",
        "fr": "Élastaupe",
        "it": "Raikou",
        "de": "Raikou",
        "es": "Raikou",
        "ko": "라이코"
      },
      "descriptions": {
        "en": "Raikou embodies the speed of lightning. The roars of this Pokémon send shock waves shuddering through the air and shake the ground as if lightning bolts had come crashing down.",
        "fr": "",
        "it": "Raikou rappresenta la velocità del fulmine. Il suo ruggito crea terrificanti onde d’urto nell’aria e scuote il suolo come se fosse percosso dalla furia di un fulmine durante il temporale.",
        "de": "Raikou ist so schnell wie der Blitz. Das Gebrüll dieses Pokémon sendet Schockwellen aus, die wie Donnerschläge durch die Luft beben und den Boden erschüttern.",
        "es": "Raikou tiene la velocidad del rayo. Los rugidos de este Pokémon emiten ondas de choque que se esparcen vibrando por el aire y sacuden el suelo como si fueran auténticas descargas de rayo.",
        "ko": "번개의 스피드가 깃들어 있는 포켓몬이다. 그 울음소리는 번개가 내리쳤을 때처럼 공기를 떨리게 하며 대지를 흔든다."
      },
      "abilities_data": [
        {
          "symbol": "long_reach",
          "textId": 203,
          "names": {
            "en": "Long Reach",
            "fr": "Longue Portée",
            "it": "Distacco",
            "de": "Langstrecke",
            "es": "Remoto",
            "ko": "원격"
          },
          "descriptions": {
            "en": "The Pokémon uses its moves without making contact with the target.",
            "fr": "Le Pokémon est capable d’utiliser toutes ses capacités sans entrer en contact direct avec sa cible.",
            "it": "Il Pokémon è in grado di usare tutte le sue mosse senza entrare in contatto diretto con il bersaglio.",
            "de": "Ermöglicht dem Pokémon den Einsatz aller seiner Attacken, ohne das Ziel dabei direkt zu berühren.",
            "es": "Puede usar cualquier movimiento sin entrar en contacto con el rival.",
            "ko": "모든 기술을 상대에게 접촉하지 않고 사용할 수 있다."
          }
        },
        {
