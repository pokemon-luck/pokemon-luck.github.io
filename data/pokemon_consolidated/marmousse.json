      "names": {
        "en": "Ivynocent",
        "fr": "Marmousse",
        "it": "Bulbasaur",
        "de": "Bisasam",
        "es": "Bulbasaur",
        "ko": "이상해씨"
      },
      "descriptions": {
        "en": "It camouflages itself among domestic plants on balconies to steal their chlorophyll.",
        "fr": "Il se mêle aux plantes domestiques des balcons pour en voler la chlorophylle.",
        "it": "È possibile vedere Bulbasaur mentre schiaccia un pisolino sotto il sole. Ha un seme piantato sulla schiena. Grazie ai raggi solari il seme cresce ingrandendosi progressivamente.",
        "de": "Bisasam macht gern einmal ein Nickerchen im Sonnenschein. Auf seinem Rücken trägt es einen Samen. Indem es Sonnenstrahlen aufsaugt, wird er zunehmend größer.",
        "es": "A Bulbasaur es fácil verle echándose una siesta al sol. La semilla que tiene en el lomo va creciendo cada vez más a medida que absorbe los rayos del sol.",
        "ko": "양지에서 낮잠 자는 모습을 볼 수 있다. 태양의 빛을 많이 받으면 등의 씨앗이 크게 자란다."
      },
      "abilities_data": [
        {
          "symbol": "chlorophyll",
          "textId": 34,
          "names": {
            "en": "Chlorophyll",
            "fr": "Chlorophylle",
            "it": "Clorofilla",
            "de": "Chlorophyll",
            "es": "Clorofila",
            "ko": "엽록소"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in harsh sunlight.",
            "fr": "Augmente la Vitesse du Pokémon s’il y a du soleil.",
            "it": "Se la luce del sole è intensa, la Velocità aumenta.",
            "de": "Erhöht bei Sonnenschein die Initiative.",
            "es": "Sube su Velocidad cuando hace sol.",
            "ko": "날씨가 맑을 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "overgrow",
          "textId": 65,
          "names": {
            "en": "Overgrow",
            "fr": "Engrais",
            "it": "Erbaiuto",
            "de": "Notdünger",
            "es": "Espesura",
            "ko": "심록"
          },
          "descriptions": {
            "en": "Powers up Grass-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Plante du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Erba aumenta.",
            "de": "Erhöht die Stärke von Pflanzen-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Planta cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 풀타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "earthen_resilience",
