      "names": {
        "en": "Cryptyphoon",
        "fr": "Diablérien",
        "it": "Moltres",
        "de": "Lavados",
        "es": "Moltres",
        "ko": "파이어"
      },
      "descriptions": {
        "en": "On its magical cloud, Cryptyphoon doesn't hesitate to travel long distances to find its trainer.",
        "fr": "Sur son nuage magique, Diablérien est prêt à voyager sur de très longues distances pour retrouver son dresseur.",
        "it": "Moltres è un Pokémon uccello leggendario, perfettamente in grado di gestire il fuoco. Se rimane ferito, si dice che si immerga nel magma liquido di un vulcano per ardere e tornare in salute.",
        "de": "Lavados ist ein Legendäres Vogel-Pokémon, das Feuer manipulieren kann. Wenn es verletzt wird, taucht es seinen Körper in das Magma eines Vulkans, um sich zu verbrennen und selbst zu heilen.",
        "es": "Moltres es un Pokémon pájaro legendario que tiene la habilidad de controlar el fuego. Dicen que, si resulta herido, se sumerge en el líquido magma de un volcán para arder y curarse.",
        "ko": "불꽃을 조종하는 전설의 새포켓몬이다. 몸이 상처 입으면 분화구의 마그마에 들어가 전신을 불태워 상처를 치료한다고 한다."
      },
      "abilities_data": [
        {
          "symbol": "gale_wings",
          "textId": 177,
          "names": {
            "en": "Gale Wings",
            "fr": "Ailes Bourrasque",
            "it": "Aliraffica",
            "de": "Orkanschwingen",
            "es": "Alas Vendaval",
            "ko": "질풍날개"
          },
          "descriptions": {
            "en": "Gives priority to Flying-type moves when the Pokémon’s HP is full.",
            "fr": "Quand les PV du Pokémon sont au maximum, ses capacités de type Vol sont prioritaires.",
            "it": "Se il Pokémon ha tutti i PS, le sue mosse di tipo Volante acquistano priorità alta.",
            "de": "Kann bei vollen KP einen Erstschlag mit Flug-Attacken ermöglichen.",
            "es": "Da prioridad a los movimientos de tipo Volador si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 비행타입의 기술을 먼저 쓸 수 있다."
          }
        },
        {
          "symbol": "air_lock",
          "textId": 76,
          "names": {
            "en": "Air Lock",
            "fr": "Air Lock",
            "it": "Riparo",
            "de": "Klimaschutz",
            "es": "Bucle Aire",
            "ko": "에어록"
          },
          "descriptions": {
            "en": "Eliminates the effects of weather.",
            "fr": "Annule tous les effets de la météo.",
            "it": "Neutralizza gli effetti di tutte le condizioni atmosferiche.",
            "de": "Hebt alle Wetter-Effekte auf.",
            "es": "Neutraliza todos los efectos del tiempo atmosférico.",
            "ko": "모든 날씨의 영향이 없어진다."
          }
        },
        {
          "symbol": "tinted_lens",
          "textId": 110,
          "names": {
            "en": "Tinted Lens",
            "fr": "Lentiteintée",
            "it": "Lentifumé",
            "de": "Aufwertung",
            "es": "Cromolente",
            "ko": "색안경"
          },
          "descriptions": {
            "en": "The Pokémon can use “not very effective” moves to deal regular damage.",
            "fr": "Permet à une capacité « pas très efficace » d’infliger des dégâts comme si elle était efficace normalement.",
            "it": "Permette alle mosse non molto efficaci di infliggere danni normalmente.",
            "de": "Bewirkt, dass nicht sehr effektive Attacken dem Ziel trotz des Typennachteils normalen Schaden zufügen.",
            "es": "Potencia los movimientos que no son muy eficaces, que infligen ahora un daño normal.",
            "ko": "효과가 별로인 기술을 통상의 위력으로 쓸 수 있다."
          }
        }
      ],
