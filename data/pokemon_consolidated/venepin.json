      "names": {
        "en": "Bunyxious",
        "fr": "Vénépin",
        "it": "Caterpie",
        "de": "Raupy",
        "es": "Caterpie",
        "ko": "캐터피"
      },
      "descriptions": {
        "en": "As false testimonies and hoaxes multiplied, it was long believed that this Pokémon did not exist.",
        "fr": "Les faux témoignages et les canulars se multipliant, on a longtemps pensé que ce pokémon n'existait pas.",
        "it": "Mangia 100 foglie al giorno. La sua voracità potrebbe essere dovuta al desiderio di crescere in fretta.",
        "de": "Das nimmersatte Raupy verschlingt 100 Blätter am Tag. Vermutlich strebt es so ein schnelleres Wachstum an.",
        "es": "Muestra un apetito voraz, debido quizás a sus ganas de acelerar su desarrollo. Puede llegar a devorar un centenar de hojas al día.",
        "ko": "빨리 성장하고 싶어서인지 식욕이 왕성하여 하루에 100장의 잎사귀를 먹는다."
      },
      "abilities_data": [
        {
          "symbol": "poison_point",
          "textId": 38,
          "names": {
            "en": "Poison Point",
            "fr": "Point Poison",
            "it": "Velenopunto",
            "de": "Giftdorn",
            "es": "Punto Tóxico",
            "ko": "독가시"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may poison the attacker.",
            "fr": "Peut empoisonner l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può avvelenare chi manda a segno un attacco diretto.",
            "de": "Vergiftet den Angreifer bei Berührung eventuell.",
            "es": "Puede envenenar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 독 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "pickup",
          "textId": 53,
          "names": {
            "en": "Pickup",
            "fr": "Ramassage",
            "it": "Raccolta",
            "de": "Mitnahme",
            "es": "Recogida",
            "ko": "픽업"
          },
          "descriptions": {
            "en": "The Pokémon may pick up the item an opposing Pokémon used during a battle. It may pick up items outside of battle, too.",
            "fr": "Permet parfois au Pokémon de ramasser les objets que ses ennemis ont utilisés. Il lui arrive aussi d’en trouver hors des combats.",
            "it": "Il Pokémon può raccogliere lo strumento usato da un nemico durante la lotta. A volte potrebbe raccogliere strumenti anche fuori dalla lotta.",
            "de": "Hebt gelegentlich von Gegnern benutzte Items auf. Dies geschieht nicht nur während Kämpfen, sondern auch unterwegs.",
            "es": "Puede recoger objetos que el rival haya usado, o bien otros que encuentre en plena aventura.",
            "ko": "상대가 사용한 도구를 주워올 때가 있다. 모험 중에도 주워온다."
          }
        },
        {
          "symbol": "contrary",
          "textId": 126,
          "names": {
            "en": "Contrary",
            "fr": "Contestation",
            "it": "Inversione",
            "de": "Umkehrung",
            "es": "Respondón",
            "ko": "심술꾸러기"
          },
          "descriptions": {
            "en": "Makes stat changes have an opposite effect.",
            "fr": "Inverse les changements de stats : les augmentations de stats se transforment en baisses, et vice-versa.",
            "it": "Le modifiche alle statistiche hanno effetto inverso: le statistiche aumentano quando dovrebbero diminuire e viceversa.",
            "de": "Statusveränderungen werden umgekehrt: Statuswerte, die eigentlich erhöht werden sollten, sinken und umgekehrt.",
            "es": "Invierte los cambios en las características: bajan cuando les toca subir y suben cuando les toca bajar.",
            "ko": "능력의 변화가 역전해서 올라갈 때 떨어지고 떨어질 때 올라간다."
          }
        }
      ],
