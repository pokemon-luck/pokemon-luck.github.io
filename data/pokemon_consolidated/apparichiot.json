      "names": {
        "en": "Apuppyrance",
        "fr": "Apparichiot",
        "it": "Koffing",
        "de": "Smogon",
        "es": "Koffing",
        "ko": "또가스"
      },
      "descriptions": {
        "en": "Hearing unexplained noises at night can be an indicator of the presence of an Apuppyrance playing tricks.",
        "fr": "Entendre des bruits inexpliqués de nuit peut être l'indicateur de la présence d'un Apparichiot s'amusant à jouer des tours.",
        "it": "Koffing è costituito da sostanze velenose. Mischia tossine con rifiuti putrefatti per scatenare reazioni chimiche che generano un micidiale gas velenoso. Con l’aumento della temperatura, sale la quantità di gas prodotto da Koffing.",
        "de": "Smogons Körper enthält giftige Substanzen. Es vermischt die Toxine mit Müll, um eine chemische Reaktion in Gang zu bringen, die ein unheimlich starkes Giftgas hervorbringt. Je höher die Temperatur, desto mehr Gas produziert es.",
        "es": "Koffing contiene sustancias tóxicas que mezcla con desperdicios para provocar una reacción química que libera un gas tremendamente venenoso. A mayor temperatura, mayor será la cantidad de gas que cree este Pokémon.",
        "ko": "음식물 쓰레기와 몸의 독소를 화학반응시켜 맹독 가스를 만들어 낸다. 기온이 높을수록 가스가 많이 만들어진다."
      },
      "abilities_data": [
        {
          "symbol": "infiltrator",
          "textId": 151,
          "names": {
            "en": "Infiltrator",
            "fr": "Infiltration",
            "it": "Intrapasso",
            "de": "Schwebedurch",
            "es": "Allanamiento",
            "ko": "틈새포착"
          },
          "descriptions": {
            "en": "Passes through the opposing Pokémon’s barrier, substitute, and the like and strikes.",
            "fr": "Traverse les barrières et les clones de l’ennemi pour attaquer directement.",
            "it": "Il Pokémon attacca evitando le barriere e il sostituto del nemico.",
            "de": "Überwindet gegnerische Schilde sowie Delegatoren und greift an.",
            "es": "Ataca sorteando la barrera o el sustituto del rival.",
            "ko": "상대의 벽이나 대타출동을 뚫고 공격할 수 있다."
          }
        },
        {
          "symbol": "intimidate",
          "textId": 22,
          "names": {
            "en": "Intimidate",
            "fr": "Intimidation",
            "it": "Prepotenza",
            "de": "Bedroher",
            "es": "Intimidación",
            "ko": "위협"
          },
          "descriptions": {
            "en": "The Pokémon intimidates opposing Pokémon upon entering battle, lowering their Attack stat.",
            "fr": "Le Pokémon rugit lorsqu’il arrive au combat, ce qui intimide l’ennemi et baisse son Attaque.",
            "it": "Quando il Pokémon entra in campo, la sua prepotenza intimidisce i nemici, riducendone l’Attacco.",
            "de": "Senkt den Angriff der Gegner, indem es sie gleich zu Kampfantritt bedroht und einschüchtert.",
            "es": "Al entrar en combate amilana al rival de tal manera que su Ataque disminuye.",
            "ko": "등장했을 때 위협해서 상대를 위축시켜 상대의 공격을 떨어뜨린다."
          }
        },
        {
          "symbol": "stakeout",
          "textId": 198,
          "names": {
            "en": "Stakeout",
            "fr": "Filature",
            "it": "Sorveglianza",
            "de": "Beschattung",
            "es": "Vigilante",
            "ko": "잠복"
          },
          "descriptions": {
            "en": "Doubles the damage dealt to the target’s replacement if the target switches out.",
            "fr": "Lorsque le Pokémon attaque une cible qui vient d’entrer sur le terrain en remplacement d’un autre Pokémon, les dégâts infligés sont doublés.",
            "it": "Raddoppia i danni inflitti a un bersaglio che è appena entrato in campo per sostituire un altro Pokémon.",
            "de": "Bewirkt bei Angriffen auf neu eingewechselte Ziele doppelten Schaden.",
            "es": "Si el objetivo de su ataque es sustituido por otro, duplica el daño que infligirá.",
            "ko": "교체로 나온 상대에게 2배 데미지로 공격할 수 있다."
          }
        }
      ],
