      "names": {
        "en": "Squideep",
        "fr": "Poulpoti",
        "it": "Cubone",
        "de": "Tragosso",
        "es": "Cubone",
        "ko": "탕구리"
      },
      "descriptions": {
        "en": "The ink of Squideep is used both as food coloring and for textiles.",
        "fr": "L'encre de Poulpoti est utilisée aussi bien en colorant alimentaire que textile.",
        "it": "Di notte piange disperatamente pensando alla madre morta. I suoi lamenti attirano i Mandibuzz, suoi predatori naturali.",
        "de": "Nachts weint es laut, weil es seine verstorbene Mutter vermisst. Dadurch wird jedoch sein natürlicher Feind Grypheldis auf es aufmerksam.",
        "es": "Al caer la noche, rompe a llorar pensando en su difunta madre, lo que delata su presencia ante los Mandibuzz, sus enemigos naturales.",
        "ko": "밤이 되면 죽은 엄마를 생각하며 울부짖는데, 그 탓에 천적인 버랜지나에게 발각된다."
      },
      "abilities_data": [
        {
          "symbol": "suction_cups",
          "textId": 21,
          "names": {
            "en": "Suction Cups",
            "fr": "Ventouse",
            "it": "Ventose",
            "de": "Saugnapf",
            "es": "Ventosas",
            "ko": "흡반"
          },
          "descriptions": {
            "en": "This Pokémon uses suction cups to stay in one spot to negate all moves and items that force switching out.",
            "fr": "Le Pokémon est solidement fixé au sol, ce qui le protège des capacités ou objets qui font changer de Pokémon.",
            "it": "Il Pokémon resiste a strumenti e mosse che causano la sostituzione appiccicandosi al terreno con le ventose.",
            "de": "Blockt Attacken und Items, die Pokémon austauschen, indem es sich mit einem Saugnapf am Boden verankert.",
            "es": "Sus ventosas se aferran al suelo, con lo cual anula movimientos y objetos que fuerzan el relevo.",
            "ko": "흡반으로 지면에 달라붙어 포켓몬을 교체시키는 기술이나 도구의 효과를 발휘하지 못하게 한다."
          }
        },
        {
          "symbol": "torrent",
          "textId": 67,
          "names": {
            "en": "Torrent",
            "fr": "Torrent",
            "it": "Acquaiuto",
            "de": "Sturzbach",
            "es": "Torrente",
            "ko": "급류"
          },
          "descriptions": {
            "en": "Powers up Water-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Eau du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Acqua aumenta.",
            "de": "Erhöht die Stärke von Wasser-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Agua cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 물타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "clear_body",
          "textId": 29,
          "names": {
            "en": "Clear Body",
            "fr": "Corps Sain",
            "it": "Corpochiaro",
            "de": "Neutraltorso",
            "es": "Cuerpo Puro",
            "ko": "클리어바디"
          },
          "descriptions": {
            "en": "Prevents other Pokémon’s moves or Abilities from lowering the Pokémon’s stats.",
            "fr": "Empêche les stats du Pokémon de baisser à cause d’une capacité ou d’un talent.",
            "it": "Impedisce la diminuzione delle statistiche causata da abilità o mosse di altri Pokémon.",
            "de": "Verhindert das Senken der Statuswerte durch Attacken und Fähigkeiten von Angreifern.",
            "es": "Evita que bajen sus características a causa de movimientos o habilidades de otros Pokémon.",
            "ko": "상대 기술이나 특성으로 능력을 떨어뜨릴 수 없다."
          }
        }
      ],
