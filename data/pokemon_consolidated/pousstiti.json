      "names": {
        "en": "Stemian",
        "fr": "Pousstiti",
        "it": "Ariados",
        "de": "Ariados",
        "es": "Ariados",
        "ko": "아리아도스"
      },
      "descriptions": {
        "en": "Stemian can hang onto branches for long periods before dropping down on insect Pokémon to catch them.",
        "fr": "Pousstiti peut rester de longs moments accroché aux branches avant de se laisser tomber sur les pokémon insectes pour les attraper.",
        "it": "Vaga di notte in cerca di prede. Quando ne trova una, usa il suo filo per immobilizzarla e poi la divora con le sue zanne.",
        "de": "Nachts wandert es auf der Suche nach Futter umher. Wird es fündig, fesselt es seine Beute mit einem Seidenfaden und beißt zu.",
        "es": "Ronda por la noche en busca de presas a las que inmoviliza con su hilo para luego clavarles los colmillos.",
        "ko": "밤마다 먹이를 찾아 떠돈다. 발견한 먹이에 실을 내뿜어 움직이지 못하게 하고 이빨로 갉아먹는다."
      },
      "abilities_data": [
        {
          "symbol": "early_bird",
          "textId": 48,
          "names": {
            "en": "Early Bird",
            "fr": "Matinal",
            "it": "Sveglialampo",
            "de": "Frühwecker",
            "es": "Madrugar",
            "ko": "일찍기상"
          },
          "descriptions": {
            "en": "The Pokémon awakens from sleep twice as fast as other Pokémon.",
            "fr": "Le Pokémon se réveille deux fois plus rapidement que les autres.",
            "it": "Il Pokémon impiega metà del tempo per risvegliarsi dal sonno rispetto agli altri.",
            "de": "Wenn es eingeschlafen ist, kann es doppelt so schnell wieder aufwachen wie andere Pokémon.",
            "es": "Si se duerme, tardará la mitad de tiempo en despertarse.",
            "ko": "잠듦 상태가 되어도 2배 스피드로 깨어날 수 있다."
          }
        },
        {
          "symbol": "gale_wings",
          "textId": 177,
          "names": {
            "en": "Gale Wings",
            "fr": "Ailes Bourrasque",
            "it": "Aliraffica",
            "de": "Orkanschwingen",
            "es": "Alas Vendaval",
            "ko": "질풍날개"
          },
          "descriptions": {
            "en": "Gives priority to Flying-type moves when the Pokémon’s HP is full.",
            "fr": "Quand les PV du Pokémon sont au maximum, ses capacités de type Vol sont prioritaires.",
            "it": "Se il Pokémon ha tutti i PS, le sue mosse di tipo Volante acquistano priorità alta.",
            "de": "Kann bei vollen KP einen Erstschlag mit Flug-Attacken ermöglichen.",
            "es": "Da prioridad a los movimientos de tipo Volador si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 비행타입의 기술을 먼저 쓸 수 있다."
          }
        },
        {
          "symbol": "chlorophyll",
          "textId": 34,
          "names": {
            "en": "Chlorophyll",
            "fr": "Chlorophylle",
            "it": "Clorofilla",
            "de": "Chlorophyll",
            "es": "Clorofila",
            "ko": "엽록소"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in harsh sunlight.",
            "fr": "Augmente la Vitesse du Pokémon s’il y a du soleil.",
            "it": "Se la luce del sole è intensa, la Velocità aumenta.",
            "de": "Erhöht bei Sonnenschein die Initiative.",
            "es": "Sube su Velocidad cuando hace sol.",
            "ko": "날씨가 맑을 때 스피드가 올라간다."
          }
        }
      ],
