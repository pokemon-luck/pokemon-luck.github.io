      "names": {
        "en": "Cichorda",
        "fr": "Musigale",
        "it": "Nidoran♂",
        "de": "Nidoran♂",
        "es": "Nidoran♂",
        "ko": "니드런♂"
      },
      "descriptions": {
        "en": "Due to their great talent, Cichordas are often included in the most prestigious orchestras.",
        "fr": "De par leur grand talent, on intègre souvent les Musigale dans les orchestres les plus prestigieux.",
        "it": "Nidoran♂ ha sviluppato dei muscoli per muovere liberamente le orecchie in qualsiasi direzione. Così, questo Pokémon è in grado di percepire anche il più flebile fruscio.",
        "de": "Nidoran♂ hat Muskeln entwickelt, um seine Ohren bewegen zu können. Dadurch kann es sie in jede beliebige Richtung wenden. Diesem Pokémon entgeht nicht das leiseste Geräusch.",
        "es": "Nidoran♂ ha desarrollado músculos para mover las orejas y orientarlas en cualquier dirección. De este modo, es capaz de captar hasta el sonido más leve.",
        "ko": "귀를 움직이는 근육이 발달되어 있어서 어떤 방향으로든 자유로이 귀를 움직일 수 있다. 희미한 소리도 빠트리지 않고 듣는 포켓몬이다."
      },
      "abilities_data": [
        {
          "symbol": "soundproof",
          "textId": 43,
          "names": {
            "en": "Soundproof",
            "fr": "Anti-Bruit",
            "it": "Antisuono",
            "de": "Lärmschutz",
            "es": "Insonorizar",
            "ko": "방음"
          },
          "descriptions": {
            "en": "Soundproofing gives the Pokémon full immunity to all sound-based moves.",
            "fr": "Protège le Pokémon de toutes les capacités sonores.",
            "it": "Il Pokémon è dotato di una sorta di isolamento acustico che lo rende immune alle mosse basate sul suono.",
            "de": "Bietet durch Schalldämmung volle Immunität gegen alle Lärm-Attacken.",
            "es": "Su aislamiento acústico lo protege de movimientos que usan sonido.",
            "ko": "소리를 차단하는 것으로 소리 공격을 받지 않는다."
          }
        },
        {
          "symbol": "own_tempo",
          "textId": 20,
          "names": {
            "en": "Own Tempo",
            "fr": "Tempo Perso",
            "it": "Mente Locale",
            "de": "Tempomacher",
            "es": "Ritmo Propio",
            "ko": "마이페이스"
          },
          "descriptions": {
            "en": "This Pokémon has its own tempo, and that prevents it from becoming confused.",
            "fr": "Le Pokémon vit sa vie à son propre rythme, ce qui l’immunise contre la confusion.",
            "it": "Il Pokémon affronta la vita al proprio ritmo e per questo non può essere confuso.",
            "de": "Das Pokémon lässt sich nicht aus der Ruhe bringen und verhindert so Verwirrung.",
            "es": "Como le gusta hacer las cosas a su manera, los rivales no logran confundirlo.",
            "ko": "마이페이스라서 혼란 상태가 되지 않는다."
          }
        },
        {
          "symbol": "synchronize",
          "textId": 28,
          "names": {
            "en": "Synchronize",
            "fr": "Synchro",
            "it": "Sincronismo",
            "de": "Synchro",
            "es": "Sincronía",
            "ko": "싱크로"
          },
          "descriptions": {
            "en": "The attacker will receive the same status condition if it inflicts a burn, poison, or paralysis to the Pokémon.",
            "fr": "Quand le Pokémon est brûlé, paralysé ou empoisonné par un autre Pokémon, il partage ce statut avec celui-ci.",
            "it": "Se un nemico avvelena, paralizza o scotta un Pokémon con questa abilità, viene colpito dallo stesso problema di stato.",
            "de": "Erleidet das Pokémon Verbrennungen, Vergiftungen oder Paralyse, ereilt das jeweilige Statusproblem auch den Verursacher.",
            "es": "Contagia el envenenamiento, las quemaduras o la parálisis al Pokémon que le cause ese estado.",
            "ko": "자신이 걸린 독이나 마비, 화상을 상대에게 옮긴다."
          }
        }
      ],
