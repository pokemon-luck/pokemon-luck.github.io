      "names": {
        "en": "Incantenna",
        "fr": "Magiciole",
        "it": "Nidorina",
        "de": "Nidorina",
        "es": "Nidorina",
        "ko": "니드리나"
      },
      "descriptions": {
        "en": "Casterfly's light is comparable to that of shooting stars. Both are said to have the power to grant wishes.",
        "fr": "La lumière de Magiciole est comparable à celle des étoiles filantes. Les deux auraient le pouvoir de réaliser les vœux.",
        "it": "Quando questi Pokémon si riuniscono con gli amici e la famiglia, tengono i loro aculei a debita distanza per evitare di ferirsi a vicenda. Se allontanati dal branco, diventano nervosi e irascibili.",
        "de": "Wenn Nidorina mit seinen Freunden oder seiner Familie zusammen ist, zieht es seine Widerhaken ein, damit es niemanden verletzt. Dieses Pokémon wird nervös, wenn man es von seinen Artgenossen trennt.",
        "es": "Cuando están en familia o con sus amigos, esconden las púas para evitar accidentes. Según parece, se alteran bastante si se separan del grupo.",
        "ko": "동료나 가족과 함께일 때는 서로 상처 입히지 않도록 가시를 세우지 않는다. 동료와 떨어지면 불안해하는 것 같다."
      },
      "abilities_data": [
        {
          "symbol": "vital_spirit",
          "textId": 72,
          "names": {
            "en": "Vital Spirit",
            "fr": "Esprit Vital",
            "it": "Spiritovivo",
            "de": "Munterkeit",
            "es": "Espíritu Vital",
            "ko": "의기양양"
          },
          "descriptions": {
            "en": "The Pokémon is full of vitality, and that prevents it from falling asleep.",
            "fr": "Empêche le Pokémon de s’endormir.",
            "it": "Il Pokémon è talmente vivace che non può addormentarsi.",
            "de": "Das Pokémon ist so munter, dass es nicht einschlafen kann.",
            "es": "Su determinación le impide quedarse dormido.",
            "ko": "의기양양해져서 잠듦 상태가 되지 않는다."
          }
        },
        {
          "symbol": "adaptability",
          "textId": 91,
          "names": {
            "en": "Adaptability",
            "fr": "Adaptabilité",
            "it": "Adattabilità",
            "de": "Anpassung",
            "es": "Adaptable",
            "ko": "적응력"
          },
          "descriptions": {
            "en": "Powers up moves of the same type as the Pokémon.",
            "fr": "Quand le Pokémon utilise une capacité du même type que lui, le bonus de puissance qu’elle reçoit est encore plus important que normalement.",
            "it": "Potenzia di molto le mosse dello stesso tipo del Pokémon.",
            "de": "Erhöht die Stärke von Attacken, die dem Typ des Pokémon entsprechen.",
            "es": "Potencia aún más los movimientos cuyo tipo coincida con el suyo.",
            "ko": "자신과 같은 타입의 기술 위력이 올라간다."
          }
        },
        {
          "symbol": "wonder_skin",
          "textId": 147,
          "names": {
            "en": "Wonder Skin",
            "fr": "Peau Miracle",
            "it": "Splendicute",
            "de": "Wunderhaut",
            "es": "Piel Milagro",
            "ko": "미라클스킨"
          },
          "descriptions": {
            "en": "Makes status moves more likely to miss.",
            "fr": "Le Pokémon résiste mieux aux capacités de statut.",
            "it": "Il Pokémon resiste più facilmente alle mosse di stato.",
            "de": "Wehrt mit robustem Körper viele Status-Attacken ab.",
            "es": "Presenta una mayor resistencia ante los movimientos de estado.",
            "ko": "변화 기술을 받기 어려운 몸으로 되어 있다."
          }
        }
      ],
