      "names": {
        "en": "Pumpkid",
        "fr": "Potitrouille",
        "it": "Grimer",
        "de": "Sleima",
        "es": "Grimer",
        "ko": "질퍽이"
      },
      "descriptions": {
        "en": "It is believed that the pumpkin is just a protective shell for Pumpkid, and that the true Pokémon is hiding inside.",
        "fr": "On pense que la citrouille n'est qu'une coquille de protection pour Potitrouille, et que le véritable pokémon se cache à l'intérieur.",
        "it": "Proviene dal fango dei fondali marini. Non può sopravvivere in ambienti puliti perché i batteri nel suo corpo non riescono a moltiplicarsi.",
        "de": "Sleima ist aus dem Schlamm am Meeresgrund entstanden. An sterilen Orten kann es seine Bakterien nicht kultivieren und stirbt.",
        "es": "Surgió del limo oceánico. En hábitats impolutos, los gérmenes de su cuerpo no pueden medrar y termina falleciendo.",
        "ko": "바다 밑의 진흙에서 태어났다. 청결한 장소에서는 체내의 세균이 증식되지 않아 죽어 버린다."
      },
      "abilities_data": [
        {
          "symbol": "chlorophyll",
          "textId": 34,
          "names": {
            "en": "Chlorophyll",
            "fr": "Chlorophylle",
            "it": "Clorofilla",
            "de": "Chlorophyll",
            "es": "Clorofila",
            "ko": "엽록소"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in harsh sunlight.",
            "fr": "Augmente la Vitesse du Pokémon s’il y a du soleil.",
            "it": "Se la luce del sole è intensa, la Velocità aumenta.",
            "de": "Erhöht bei Sonnenschein die Initiative.",
            "es": "Sube su Velocidad cuando hace sol.",
            "ko": "날씨가 맑을 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "flash_fire",
          "textId": 18,
          "names": {
            "en": "Flash Fire",
            "fr": "Torche",
            "it": "Fuocardore",
            "de": "Feuerfänger",
            "es": "Absorbe Fuego",
            "ko": "타오르는불꽃"
          },
          "descriptions": {
            "en": "Powers up the Pokémon’s Fire-type moves if it’s hit by one.",
            "fr": "Lorsque le Pokémon est touché par une capacité de type Feu, il absorbe la chaleur pour renforcer ses propres capacités Feu.",
            "it": "Se il Pokémon subisce una mossa di tipo Fuoco, ne sfrutta il calore per potenziare le proprie mosse dello stesso tipo.",
            "de": "Verstärkt Feuer-Attacken, wenn es von Feuer-Attacken getroffen wird.",
            "es": "Si le alcanza algún movimiento de tipo Fuego, potencia sus propios movimientos de dicho tipo.",
            "ko": "불꽃타입의 기술을 받으면 불꽃을 받아서 자신이 사용하는 불꽃타입의 기술이 강해진다."
          }
        },
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        }
      ],
