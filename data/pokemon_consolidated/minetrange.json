      "names": {
        "en": "Meoweird",
        "fr": "Minetrange",
        "it": "Psyduck",
        "de": "Enton",
        "es": "Psyduck",
        "ko": "고라파덕"
      },
      "descriptions": {
        "en": "In the past, trainers of Meoweird were considered witches. Nowadays, this Pokémon is appreciated for its true value and is often welcomed as a pet.",
        "fr": "Dans le passé, les détentrices de Minetrange étaient considérées comme des sorcières. De nos jours, ce pokémon est apprécié à sa juste valeur et souvent accueilli comme animal de compagnie.",
        "it": "Usare i suoi poteri psicocinetici gli causa dei gran mal di testa, perciò passa il tempo cercando di fare e pensare il meno possibile.",
        "de": "Wenn es seine Psycho-Kräfte einsetzt, bekommt es Kopfschmerzen. Deshalb steht es lieber untätig und geistesabwesend herum.",
        "es": "El uso de sus poderes psíquicos le provoca un gran dolor de cabeza, por lo que prefiere tener la mente en blanco y no hacer nada en absoluto.",
        "ko": "염동력을 사용하면 두통이 생겨서 평소에는 아무것도 하지 않고 가능한 멍하니 지낸다."
      },
      "abilities_data": [
        {
          "symbol": "serene_grace",
          "textId": 32,
          "names": {
            "en": "Serene Grace",
            "fr": "Sérénité",
            "it": "Leggiadro",
            "de": "Edelmut",
            "es": "Dicha",
            "ko": "하늘의은총"
          },
          "descriptions": {
            "en": "Boosts the likelihood of additional effects occurring when attacking.",
            "fr": "Augmente les chances d’infliger des effets additionnels.",
            "it": "Rende più probabili gli effetti aggiuntivi delle mosse.",
            "de": "Erhöht die Wahrscheinlichkeit, dass Zusatzeffekte von Attacken auftreten.",
            "es": "Aumenta la probabilidad de que los movimientos causen efectos secundarios.",
            "ko": "하늘의 은총 덕분에 기술의 추가 효과가 나오기 쉽다."
          }
        },
        {
          "symbol": "magic_guard",
          "textId": 98,
          "names": {
            "en": "Magic Guard",
            "fr": "Garde Magik",
            "it": "Magicscudo",
            "de": "Magieschild",
            "es": "Muro Mágico",
            "ko": "매직가드"
          },
          "descriptions": {
            "en": "The Pokémon only takes damage from attacks.",
            "fr": "Seules les attaques peuvent blesser le Pokémon.",
            "it": "Il Pokémon subisce danni solo dagli attacchi.",
            "de": "Das Pokémon nimmt nur durch Offensiv-Attacken Schaden.",
            "es": "Solo recibe daño de ataques.",
            "ko": "공격 이외에는 데미지를 입지 않는다."
          }
        },
        {
          "symbol": "magic_bounce",
          "textId": 156,
          "names": {
            "en": "Magic Bounce",
            "fr": "Miroir Magik",
            "it": "Magispecchio",
            "de": "Magiespiegel",
            "es": "Espejo Mágico",
            "ko": "매직미러"
          },
          "descriptions": {
            "en": "Reflects status moves instead of getting hit by them.",
            "fr": "Annule les effets des capacités de statut subies par le Pokémon et les retourne à l’envoyeur.",
            "it": "Il Pokémon respinge al mittente le mosse di stato senza subirne gli effetti.",
            "de": "Lenkt Status-Attacken auf den Angreifer um, ohne selbst von ihnen getroffen zu werden.",
            "es": "Puede devolver los movimientos de estado lanzados por el rival, sin verse afectado por ellos.",
            "ko": "상대가 쓴 변화 기술을 받지 않고 그대로 되받아칠 수 있다."
          }
        }
      ],
