      "names": {
        "en": "Cobrat",
        "fr": "Reptelle",
        "it": "Cyndaquil",
        "de": "Feurigel",
        "es": "Cyndaquil",
        "ko": "브케인"
      },
      "descriptions": {
        "en": "They are often found serving in cabarets.",
        "fr": "On les retrouve souvent à faire le service dans les cabarets",
        "it": "Cyndaquil si protegge grazie alle fiamme che gli ardono sul dorso. Le fiamme divampano impetuose se il Pokémon è adirato. Tuttavia, quando è stanco diventano fiammelle innocue dalla combustione incompleta.",
        "de": "Feurigel lässt Flammen aus seinem Rücken lodern, wenn es sich schützen muss. Die Flammen sind sehr stark, wenn dieses Pokémon wütend ist. Ist es aber müde, flackern die Flammen nur unregelmäßig und schwach.",
        "es": "Cyndaquil se protege soltando llamas por el lomo. Cuando está enfadado, las llamas son fieras, pero, si está cansado, solo consigue echar algunas chispas que no llegan a cuajar en una completa combustión.",
        "ko": "등에서 불꽃을 내뿜어 몸을 지킨다. 화났을 때의 불꽃은 기운차지만 지쳤을 때는 불완전연소한다."
      },
      "abilities_data": [
        {
          "symbol": "static",
          "textId": 9,
          "names": {
            "en": "Static",
            "fr": "Statik",
            "it": "Statico",
            "de": "Statik",
            "es": "Elec. Estática",
            "ko": "정전기"
          },
          "descriptions": {
            "en": "The Pokémon is charged with static electricity, so contact with it may cause paralysis.",
            "fr": "Le Pokémon charge son corps en électricité statique, et tout contact avec lui peut paralyser.",
            "it": "Il contatto fisico con il corpo percorso dall’elettricità statica del Pokémon può causare paralisi.",
            "de": "Kann bei Berührung durch statisch aufgeladenen Körper paralysieren.",
            "es": "La electricidad estática que lo envuelve puede paralizar al mínimo contacto.",
            "ko": "정전기를 몸에 둘러 접촉한 상대를 마비시킬 때가 있다."
          }
        },
        {
          "symbol": "cute_charm",
          "textId": 56,
          "names": {
            "en": "Cute Charm",
            "fr": "Joli Sourire",
            "it": "Incantevole",
            "de": "Charmebolzen",
            "es": "Gran Encanto",
            "ko": "헤롱헤롱바디"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may cause infatuation.",
            "fr": "Peut séduire l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può causare infatuazione a chi manda a segno un attacco diretto.",
            "de": "Wird dieses Pokémon durch eine direkte Attacke angegriffen, verliebt sich der Gegner eventuell in es.",
            "es": "Puede causar enamoramiento al rival que lo toque.",
            "ko": "자신과 접촉한 상대를 헤롱헤롱 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "serene_grace",
          "textId": 32,
          "names": {
            "en": "Serene Grace",
            "fr": "Sérénité",
            "it": "Leggiadro",
            "de": "Edelmut",
            "es": "Dicha",
            "ko": "하늘의은총"
          },
          "descriptions": {
            "en": "Boosts the likelihood of additional effects occurring when attacking.",
            "fr": "Augmente les chances d’infliger des effets additionnels.",
            "it": "Rende più probabili gli effetti aggiuntivi delle mosse.",
            "de": "Erhöht die Wahrscheinlichkeit, dass Zusatzeffekte von Attacken auftreten.",
            "es": "Aumenta la probabilidad de que los movimientos causen efectos secundarios.",
            "ko": "하늘의 은총 덕분에 기술의 추가 효과가 나오기 쉽다."
          }
        }
      ],
