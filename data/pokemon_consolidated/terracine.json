      "names": {
        "en": "Feveroot",
        "fr": "Terracine",
        "it": "Ledian",
        "de": "Ledian",
        "es": "Ledian",
        "ko": "레디안"
      },
      "descriptions": {
        "en": "It is said that Feveroot can harness the life energy of the earth to enhance its psychic powers.",
        "fr": "Il est dit que Terracine serait capable de tirer parti de l'énergie vitale de la terre pour renforcer ses pouvoirs psychiques.",
        "it": "Si dice che il motivo sul suo dorso abbia una qualche relazione con le stelle, ma non si sa ancora niente di preciso.",
        "de": "Es heißt, das Muster auf seinem Rücken stehe in Zusammenhang mit den Sternen am Firmament. Genaueres ist bisher aber noch nicht bekannt.",
        "es": "Se dice que los motivos que luce en el dorso guardan relación con las estrellas, aunque esta teoría sigue siendo todo un misterio.",
        "ko": "등의 모양은 밤하늘의 별과 연관이 있다고 전해지지만 자세한 것은 아직 알려지지 않았다."
      },
      "abilities_data": [
        {
          "symbol": "regenerator",
          "textId": 144,
          "names": {
            "en": "Regenerator",
            "fr": "Régé-Force",
            "it": "Rigenergia",
            "de": "Belebekraft",
            "es": "Regeneración",
            "ko": "재생력"
          },
          "descriptions": {
            "en": "Restores a little HP when withdrawn from battle.",
            "fr": "Restaure un peu de PV si le Pokémon est retiré du combat.",
            "it": "Il Pokémon recupera un po’ di PS quando lascia il campo.",
            "de": "Wird das Pokémon ausgewechselt, regeneriert es eine kleine Menge an KP.",
            "es": "Recupera unos pocos PS al ser cambiado por otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 HP를 조금 회복한다."
          }
        },
        {
          "symbol": "natural_cure",
          "textId": 30,
          "names": {
            "en": "Natural Cure",
            "fr": "Médic Nature",
            "it": "Alternacura",
            "de": "Innere Kraft",
            "es": "Cura Natural",
            "ko": "자연회복"
          },
          "descriptions": {
            "en": "All status conditions heal when the Pokémon switches out.",
            "fr": "Le Pokémon soigne ses altérations de statut en quittant le combat.",
            "it": "Quando il Pokémon viene sostituito, guarisce dai problemi di stato.",
            "de": "Wird das Pokémon ausgewechselt, werden seine Statusprobleme geheilt.",
            "es": "Cura sus problemas de estado al cambiarse con otro Pokémon.",
            "ko": "지닌 포켓몬으로 돌아오면 상태 이상이 회복된다."
          }
        },
        {
          "symbol": "magic_guard",
          "textId": 98,
          "names": {
            "en": "Magic Guard",
            "fr": "Garde Magik",
            "it": "Magicscudo",
            "de": "Magieschild",
            "es": "Muro Mágico",
            "ko": "매직가드"
          },
          "descriptions": {
            "en": "The Pokémon only takes damage from attacks.",
            "fr": "Seules les attaques peuvent blesser le Pokémon.",
            "it": "Il Pokémon subisce danni solo dagli attacchi.",
            "de": "Das Pokémon nimmt nur durch Offensiv-Attacken Schaden.",
            "es": "Solo recibe daño de ataques.",
            "ko": "공격 이외에는 데미지를 입지 않는다."
          }
        }
      ],
