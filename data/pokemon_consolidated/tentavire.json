      "names": {
        "en": "Wreckalmar",
        "fr": "Tentavire",
        "it": "Marowak",
        "de": "Knogga",
        "es": "Marowak",
        "ko": "텅구리"
      },
      "descriptions": {
        "en": "Wreckalmar collects pieces of wreckage that it finds at the bottom of the ocean.",
        "fr": "Tentavire collectionne des morceaux d'épaves qu'il trouve au fond de l'océan.",
        "it": "Scaglia il suo osso per abbattere i Mandibuzz. Si dice che in questo modo voglia vendicare la morte di sua madre.",
        "de": "Es wirft seinen Knochen nach Grypheldis, um es vom Himmel zu holen. Man nimmt an, dass es sich für seine Mutter an ihm rächen will.",
        "es": "Lanza su hueso para abatir a los Mandibuzz. Según cuentan, es su forma de vengar a su madre.",
        "ko": "뼈를 던져 버랜지나를 떨어뜨린다. 부모의 원한을 갚기 위한 것으로 추측된다."
      },
      "abilities_data": [
        {
          "symbol": "sturdy",
          "textId": 5,
          "names": {
            "en": "Sturdy",
            "fr": "Fermeté",
            "it": "Vigore",
            "de": "Robustheit",
            "es": "Robustez",
            "ko": "옹골참"
          },
          "descriptions": {
            "en": "It cannot be knocked out with one hit. One-hit KO moves cannot knock it out, either.",
            "fr": "Le Pokémon encaisse toujours au moins une attaque s’il a tous ses PV. Il est également immunisé contre les capacités pouvant mettre K.O. en un coup.",
            "it": "Evita che il Pokémon vada KO in un sol colpo se ha tutti i PS, e lo rende immune alle mosse che causano KO immediato.",
            "de": "Bietet Schutz gegen K.O.-Attacken. Bei vollen KP übersteht das Pokémon auch K.O.-Treffer.",
            "es": "Evita que el rival pueda debilitarlo de un solo golpe cuando tiene los PS al máximo. También evita los movimientos fulminantes.",
            "ko": "상대 기술을 받아도 일격으로 쓰러지지 않는다. 일격필살 기술도 효과 없다."
          }
        },
        {
          "symbol": "iron_barbs",
          "textId": 160,
          "names": {
            "en": "Iron Barbs",
            "fr": "Épine de Fer",
            "it": "Spineferrate",
            "de": "Eisenstachel",
            "es": "Punta Acero",
            "ko": "철가시"
          },
          "descriptions": {
            "en": "Inflicts damage on the attacker upon contact with iron barbs.",
            "fr": "Inflige des dégâts à l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, infligge danni a sua volta con le sue spine di ferro.",
            "de": "Fügt dem Angreifer bei Berührung mit eisernen Stacheln Schaden zu.",
            "es": "Inflige daño al rival si este le golpea con un movimiento de contacto.",
            "ko": "자신과 접촉한 상대에게 철가시로 데미지를 준다."
          }
        },
        {
          "symbol": "steelworker",
          "textId": 200,
          "names": {
            "en": "Steelworker",
            "fr": "Expert Acier",
            "it": "Tempracciaio",
            "de": "Stahlprofi",
            "es": "Acero Templado",
            "ko": "강철술사"
          },
          "descriptions": {
            "en": "Powers up Steel-type moves.",
            "fr": "Augmente la puissance des attaques de type Acier.",
            "it": "Aumenta la potenza delle mosse di tipo Acciaio.",
            "de": "Erhöht die Stärke von Stahl-Attacken.",
            "es": "Potencia los movimientos de tipo Acero.",
            "ko": "강철타입 기술의 위력이 올라간다."
          }
        }
      ],
