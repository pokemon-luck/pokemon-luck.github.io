      "names": {
        "en": "Hadescorch",
        "fr": "Flambémon",
        "it": "Tentacruel",
        "de": "Tentoxa",
        "es": "Tentacruel",
        "ko": "독파리"
      },
      "descriptions": {
        "en": "Hadescorch has a difficult temperament, making it prone to extreme fits of rage. Only seasoned trainers should add one to their team.",
        "fr": "Flambémon possède un caractère difficile, le rendant enclin à des accès de rage d'une extrême violence. Seuls les dresseurs aguerris devraient ajouter un Flambémon à leur équipe.",
        "it": "Indebolisce la preda emettendo ultrasuoni dalle sfere rosse per poi avvolgerla con i suoi 80 tentacoli.",
        "de": "Mit Ultraschallwellen aus seinen roten Kugeln schwächt es zunächst seine Beute, um sie dann mit seinen 80 Tentakeln fest zu umwickeln.",
        "es": "Emite ondas ultrasónicas por sus esferas rojas que inmovilizan a su presa para luego proceder a rodearla con sus 80 tentáculos.",
        "ko": "붉은 구슬로 초음파를 발생시켜 먹이가 약해지면 80개의 촉수로 휘감는다."
      },
      "abilities_data": [
        {
          "symbol": "flame_body",
          "textId": 49,
          "names": {
            "en": "Flame Body",
            "fr": "Corps Ardent",
            "it": "Corpodifuoco",
            "de": "Flammkörper",
            "es": "Cuerpo Llama",
            "ko": "불꽃몸"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may burn the attacker.",
            "fr": "Peut brûler l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può scottare chi manda a segno un attacco diretto.",
            "de": "Fügt dem Angreifer bei Berührung eventuell Verbrennungen zu.",
            "es": "Puede quemar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 화상 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "drought",
          "textId": 70,
          "names": {
            "en": "Drought",
            "fr": "Sécheresse",
            "it": "Siccità",
            "de": "Dürre",
            "es": "Sequía",
            "ko": "가뭄"
          },
          "descriptions": {
            "en": "Turns the sunlight harsh when the Pokémon enters a battle.",
            "fr": "Le soleil se met à briller quand le Pokémon entre au combat.",
            "it": "Quando il Pokémon entra in campo, la luce solare diventa intensa.",
            "de": "Erzeugt bei Kampfantritt gleißendes Sonnenlicht.",
            "es": "Cuando entra en combate, el tiempo pasa a ser soleado.",
            "ko": "등장했을 때 날씨를 맑음으로 만든다."
          }
        },
        {
          "symbol": "sheer_force",
          "textId": 125,
          "names": {
            "en": "Sheer Force",
            "fr": "Sans Limite",
            "it": "Forzabruta",
            "de": "Rohe Gewalt",
            "es": "Potencia Bruta",
            "ko": "우격다짐"
          },
          "descriptions": {
            "en": "Removes additional effects to increase the power of moves when attacking.",
            "fr": "Les capacités ayant un effet additionnel le perdent, mais leur puissance augmente.",
            "it": "Aumenta la potenza delle mosse, ma ne annulla gli effetti aggiuntivi.",
            "de": "Erhöht die Stärke von Attacken, aber hebt dafür ihre Zusatzeffekte auf.",
            "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
            "ko": "기술의 추가 효과가 없어지지만 그만큼 높은 위력으로 기술을 사용할 수 있다."
          }
        }
      ],
