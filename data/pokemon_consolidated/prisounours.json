      "names": {
        "en": "Ursnare",
        "fr": "Prisounours",
        "it": "Feraligatr",
        "de": "Impergator",
        "es": "Feraligatr",
        "ko": "장크로다일"
      },
      "descriptions": {
        "en": "Don't be fooled by appearances, Ursnare hides enough strength to escape poachers, carrying their trap on its head.",
        "fr": "Ne vous fiez pas aux apparences, prisounours cache une force suffisante pour échapper aux braconniers, emportant leur piège sur sa tête.",
        "it": "Feraligatr spaventa il nemico spalancando la sua bocca enorme. Nella lotta pesta pesantemente il terreno con le sue possenti zampe posteriori per scagliarsi contro il nemico a un’incredibile velocità.",
        "de": "Impergator schüchtert seine Feinde dadurch ein, dass es sein riesiges Maul aufreißt. Im Kampf erschüttert es den Boden mit seinen kräftigen Hinterbeinen, wenn es mit unglaublicher Geschwindigkeit auf seinen Gegner losrennt.",
        "es": "Feraligatr intimida a sus oponentes abriendo las grandes fauces que tiene. En combate, golpea el suelo bruscamente con las gruesas y fuertes patas traseras que tiene para cargar contra su rival a una velocidad de vértigo.",
        "ko": "큰 입을 열고 상대를 위협한다. 강인한 뒷다리로 땅을 차고 굉장한 스피드로 돌진해온다."
      },
      "abilities_data": [
        {
          "symbol": "battle_armor",
          "textId": 4,
          "names": {
            "en": "Battle Armor",
            "fr": "Armurbaston",
            "it": "Lottascudo",
            "de": "Kampfpanzer",
            "es": "Armadura Batalla",
            "ko": "전투무장"
          },
          "descriptions": {
            "en": "Hard armor protects the Pokémon from critical hits.",
            "fr": "Le Pokémon est protégé des coups critiques par une solide carapace.",
            "it": "Il Pokémon è protetto da una dura corazza che gli evita di subire brutti colpi.",
            "de": "Wehrt gegnerische Volltreffer mit einem harten Panzer ab.",
            "es": "La robusta coraza que lo protege bloquea los golpes críticos.",
            "ko": "단단한 껍질에 보호받아 상대의 공격이 급소에 맞지 않는다."
          }
        },
        {
          "symbol": "heavy_metal",
          "textId": 134,
          "names": {
            "en": "Heavy Metal",
            "fr": "Heavy Metal",
            "it": "Metalpesante",
            "de": "Schwermetall",
            "es": "Metal Pesado",
            "ko": "헤비메탈"
          },
          "descriptions": {
            "en": "Doubles the Pokémon’s weight.",
            "fr": "Double le poids du Pokémon.",
            "it": "Raddoppia il peso del Pokémon.",
            "de": "Verdoppelt das eigene Gewicht.",
            "es": "Duplica su peso.",
            "ko": "자신의 무게가 2배가 된다."
          }
        },
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        }
      ],
