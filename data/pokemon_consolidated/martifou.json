      "names": {
        "en": "Whiptiz",
        "fr": "Martifou",
        "it": "Jumpluff",
        "de": "Papungha",
        "es": "Jumpluff",
        "ko": "솜솜코"
      },
      "descriptions": {
        "en": "Only true trainers will be able to tame this cheeky Pokémon.",
        "fr": "Seuls les vrais dresseurs sauront soumettre ce pokémon effronté.",
        "it": "Jumpluff si affida alle correnti d’aria calda per attraversare il mare e volare verso terre lontane. Questo Pokémon ridiscende a terra quando incontra una corrente fredda mentre fluttua.",
        "de": "Papungha nutzt den Südwind, um das Meer zu überqueren und in ferne Länder zu fliegen. Dieses Pokémon sinkt zu Boden, wenn es während seines Fluges auf kalte Luftschichten stößt.",
        "es": "Jumpluff se vale de los cálidos vientos del sur para volar a tierras lejanas. Si llega a zonas de aire frío en pleno vuelo, descenderá y tomará tierra.",
        "ko": "따뜻한 남풍을 타고 바다를 건너 외국까지 날아가는 포켓몬이다. 차가운 공기에 닿으면 땅에 내려온다."
      },
      "abilities_data": [
        {
          "symbol": "contrary",
          "textId": 126,
          "names": {
            "en": "Contrary",
            "fr": "Contestation",
            "it": "Inversione",
            "de": "Umkehrung",
            "es": "Respondón",
            "ko": "심술꾸러기"
          },
          "descriptions": {
            "en": "Makes stat changes have an opposite effect.",
            "fr": "Inverse les changements de stats : les augmentations de stats se transforment en baisses, et vice-versa.",
            "it": "Le modifiche alle statistiche hanno effetto inverso: le statistiche aumentano quando dovrebbero diminuire e viceversa.",
            "de": "Statusveränderungen werden umgekehrt: Statuswerte, die eigentlich erhöht werden sollten, sinken und umgekehrt.",
            "es": "Invierte los cambios en las características: bajan cuando les toca subir y suben cuando les toca bajar.",
            "ko": "능력의 변화가 역전해서 올라갈 때 떨어지고 떨어질 때 올라간다."
          }
        },
        {
          "symbol": "stamina",
          "textId": 192,
          "names": {
            "en": "Stamina",
            "fr": "Endurance",
