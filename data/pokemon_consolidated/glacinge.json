      "names": {
        "en": "Abomineral",
        "fr": "Glacinge",
        "it": "Growlithe",
        "de": "Fukano",
        "es": "Growlithe",
        "ko": "가디"
      },
      "descriptions": {
        "en": "Many hikers who have survived the occasional avalanches in the mountains of Laemu claim to have been saved by an imposing Pokémon. It is likely to be Abomineral, coming to the aid of those in need before blending into the thick snow.",
        "fr": "De nombreux randonneurs ayant survécu aux occasionnelles avalanches des montagnes de Laemu affirment avoir été sauvés par un imposant Pokémon. Il est probable qu'il s'agisse de Glacinge, portant secours à ceux dans le besoin avant de se camoufler dans les neiges épaisses.",
        "it": "È molto docile con gli esseri umani a cui si affeziona, ma in natura lotta furiosamente con i Rockruff per il controllo del territorio.",
        "de": "Hat es sich erst einmal an Menschen gewöhnt, wird es sehr zutraulich. In der Wildnis liefert es sich jedoch heftige Revierkämpfe mit Wuffels.",
        "es": "Es muy afable con las personas una vez que ha cogido confianza, pero, en estado salvaje, libra violentas disputas territoriales con los Rockruff.",
        "ko": "익숙해지면 사람을 잘 따르지만, 야생에서는 암멍이와 영역을 두고 격렬히 다툰다."
      },
      "abilities_data": [
        {
          "symbol": "snow_warning",
          "textId": 117,
          "names": {
            "en": "Snow Warning",
            "fr": "Alerte Neige",
            "it": "Scendineve",
            "de": "Hagelalarm",
            "es": "Nevada",
            "ko": "눈퍼뜨리기"
          },
          "descriptions": {
            "en": "The Pokémon summons a hailstorm when it enters a battle.",
            "fr": "Déclenche une tempête de grêle quand le Pokémon entre au combat.",
            "it": "Quando il Pokémon entra in campo, provoca una grandinata.",
            "de": "Löst bei Kampfantritt Hagel aus.",
            "es": "Invoca una tormenta de granizo al entrar en combate.",
            "ko": "등장했을 때 날씨를 싸라기눈으로 만든다."
          }
        },
        {
          "symbol": "fur_coat",
          "textId": 169,
          "names": {
            "en": "Fur Coat",
            "fr": "Toison Épaisse",
            "it": "Foltopelo",
            "de": "Fellkleid",
            "es": "Pelaje Recio",
            "ko": "퍼코트"
          },
          "descriptions": {
            "en": "Halves the damage from physical moves.",
            "fr": "Divise par deux les dégâts des capacités physiques subies par le Pokémon.",
            "it": "Dimezza il danno subito dalle mosse fisiche.",
            "de": "Halbiert den Schaden, den das Pokémon durch physische Attacken erleidet.",
            "es": "Reduce a la mitad el daño que recibe de ataques físicos del rival.",
            "ko": "상대로부터 받는 물리 기술의 데미지가 절반이 된다."
          }
        },
        {
          "symbol": "thick_fat",
          "textId": 47,
          "names": {
            "en": "Thick Fat",
            "fr": "Isograisse",
            "it": "Grassospesso",
            "de": "Speckschicht",
            "es": "Sebo",
            "ko": "두꺼운지방"
          },
          "descriptions": {
            "en": "The Pokémon is protected by a layer of thick fat, which halves the damage taken from Fire- and Ice-type moves.",
            "fr": "Le Pokémon est protégé par une épaisse couche de graisse qui diminue de moitié les dégâts qu’il subit des capacités de types Feu et Glace.",
            "it": "Il Pokémon è protetto da uno spesso strato di grasso che dimezza il danno causato da mosse di tipo Fuoco e Ghiaccio.",
            "de": "Das Pokémon wird von einer dicken Fettschicht geschützt, was den durch Feuer- und Eis-Attacken erlittenen Schaden halbiert.",
            "es": "Gracias a la gruesa capa de grasa que lo protege, reduce a la mitad el daño que recibe de ataques de tipo Fuego o Hielo.",
            "ko": "두꺼운 지방으로 보호되고 있어 불꽃타입과 얼음타입의 기술의 데미지를 반감시킨다."
          }
        }
      ],
