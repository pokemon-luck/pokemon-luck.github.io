      "names": {
        "en": "Taraskewa",
        "fr": "Tarapasque",
        "it": "Lanturn",
        "de": "Lanturn",
        "es": "Lanturn",
        "ko": "랜턴"
      },
      "descriptions": {
        "en": "The scales of Taraskewa are constantly coated with a poisonous secretion, making it extremely dangerous to approach.",
        "fr": "Les écailles de Tarapasque sont constamment recouvertes d'une sécrétion empoisonnée, le rendant extrêmement dangereux à approcher.",
        "it": "Quando i batteri nelle antenne di Lanturn assimilano i suoi fluidi corporei, scatenano una reazione che sprigiona una forte luce.",
        "de": "In Lanturns Antennen leben Bakterien, die seine Körperflüssigkeiten aufnehmen und so ein eindrucksvolles Lichtspektakel auslösen.",
        "es": "Cuando las bacterias que viven en sus antenas absorben sus fluidos corporales, sufren una reacción que libera una luz intensa.",
        "ko": "촉수에 사는 박테리아가 랜턴의 체액을 빨아들일 때 강한 발광 현상이 일어난다."
      },
      "abilities_data": [
        {
          "symbol": "poison_point",
          "textId": 38,
          "names": {
            "en": "Poison Point",
            "fr": "Point Poison",
            "it": "Velenopunto",
            "de": "Giftdorn",
            "es": "Punto Tóxico",
            "ko": "독가시"
          },
          "descriptions": {
            "en": "Contact with the Pokémon may poison the attacker.",
            "fr": "Peut empoisonner l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Può avvelenare chi manda a segno un attacco diretto.",
            "de": "Vergiftet den Angreifer bei Berührung eventuell.",
            "es": "Puede envenenar al mínimo contacto.",
            "ko": "자신과 접촉한 상대를 독 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "rough_skin",
          "textId": 24,
          "names": {
            "en": "Rough Skin",
            "fr": "Peau Dure",
            "it": "Cartavetro",
            "de": "Rauhaut",
            "es": "Piel Tosca",
            "ko": "까칠한피부"
          },
          "descriptions": {
            "en": "This Pokémon inflicts damage with its rough skin to the attacker on contact.",
            "fr": "Blesse l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon è colpito da un attacco diretto, grazie alla sua pelle ruvida infligge danni a sua volta.",
            "de": "Angreifer werden durch die raue Haut des Pokémon bei direkten Attacken verletzt.",
            "es": "Hiere con su piel áspera al rival que lo ataque con un movimiento de contacto.",
            "ko": "공격을 받았을 때 자신에게 접촉한 상대를 까칠까칠한 피부로 상처를 입힌다."
          }
        },
        {
          "symbol": "stamina",
          "textId": 192,
          "names": {
            "en": "Stamina",
            "fr": "Endurance",
            "it": "Sopportazione",
            "de": "Zähigkeit",
            "es": "Firmeza",
            "ko": "지구력"
          },
          "descriptions": {
            "en": "Boosts the Defense stat when hit by an attack.",
            "fr": "Augmente la Défense du Pokémon lorsqu’il subit une attaque.",
            "it": "Se il Pokémon subisce un attacco, la sua Difesa aumenta.",
            "de": "Wird es von einer Attacke getroffen, steigt seine Verteidigung.",
            "es": "Aumenta su Defensa al recibir un ataque.",
            "ko": "공격을 받으면 방어가 올라간다."
          }
        }
      ],
