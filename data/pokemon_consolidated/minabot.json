      "names": {
        "en": "Miniatyr",
        "fr": "Miniatyre",
        "it": "Pinsir",
        "de": "Pinsir",
        "es": "Pinsir",
        "ko": "쁘사이저"
      },
      "descriptions": {
        "en": "Miniatyr's speed is nothing exceptional, but it enjoys challenging other Pokémon to races.",
        "fr": "La vitesse de Miniatyre n'a rien d'exceptionnel, mais il aime défier d'autres pokémon à la course.",
        "it": "Si contende il territorio con i Vikavolt. Per qualche motivo, ad Alola i Pinsir sembrano andare d’accordo con gli Heracross.",
        "de": "Es liefert sich Revierkämpfe mit Donarion. Aus noch unbekannten Gründen versteht es sich in Alola ausgesprochen gut mit Skaraborn.",
        "es": "Son famosas sus disputas territoriales con los Vikavolt. En Alola parece llevarse muy bien con los Heracross por motivos que se desconocen.",
        "ko": "투구뿌논과 영역 다툼을 한다. 알로라에서는 어째서인지 헤라크로스와 사이가 좋은 듯하다."
      },
      "abilities_data": [
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        },
        {
          "symbol": "rivalry",
          "textId": 79,
          "names": {
            "en": "Rivalry",
            "fr": "Rivalité",
            "it": "Antagonismo",
            "de": "Rivalität",
            "es": "Rivalidad",
            "ko": "투쟁심"
          },
          "descriptions": {
            "en": "Becomes competitive and deals more damage to Pokémon of the same gender, but deals less to Pokémon of the opposite gender.",
            "fr": "Le Pokémon déteste la concurrence et inflige plus de dégâts si l’ennemi est du même sexe. Par contre, il en inflige moins si l’ennemi est du sexe opposé.",
            "it": "Rende più forti contro nemici dello stesso sesso, ma più deboli contro nemici di sesso opposto.",
            "de": "Greift es einen Rivalen desselben Geschlechts an, wird es stärker. Greift es ein Ziel des anderen Geschlechts an, wird es schwächer.",
            "es": "Si el objetivo es del mismo sexo, su competitividad le lleva a infligir más daño. Si es del sexo contrario, en cambio, el daño será menor.",
            "ko": "성별이 같으면 투쟁심을 불태워 강해진다. 성별이 다르면 약해진다."
          }
        },
        {
          "symbol": "stamina",
          "textId": 192,
          "names": {
            "en": "Stamina",
            "fr": "Endurance",
            "it": "Sopportazione",
            "de": "Zähigkeit",
            "es": "Firmeza",
            "ko": "지구력"
          },
          "descriptions": {
            "en": "Boosts the Defense stat when hit by an attack.",
            "fr": "Augmente la Défense du Pokémon lorsqu’il subit une attaque.",
            "it": "Se il Pokémon subisce un attacco, la sua Difesa aumenta.",
            "de": "Wird es von einer Attacke getroffen, steigt seine Verteidigung.",
            "es": "Aumenta su Defensa al recibir un ataque.",
            "ko": "공격을 받으면 방어가 올라간다."
          }
        }
      ],
