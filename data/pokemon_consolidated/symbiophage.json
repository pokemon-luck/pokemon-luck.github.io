      "names": {
        "en": "Symbiodious",
        "fr": "Symbiophage",
        "it": "Slugma",
        "de": "Schneckmag",
        "es": "Slugma",
        "ko": "마그마그"
      },
      "descriptions": {
        "en": "This terrible parasite has become one with the Pokémon whose birth it prevented.",
        "fr": "Ce terrible parasite ne fait plus qu'un avec le pokémon dont il a empêché la naissance.",
        "it": "Nel corpo di Slugma non scorre nemmeno una goccia di sangue, bensì magma rovente, che garantisce l’apporto di ossigeno e sostanze nutritive fondamentali per i suoi organi.",
        "de": "Schneckmag hat kein Blut in seinem Körper. Stattdessen fließt glühend heißes Magma in diesem Pokémon, das seine Organe mit lebenswichtigen Nährstoffen und Sauerstoff versorgt.",
        "es": "Slugma no tiene sangre en su organismo, sino ardiente magma que hace circular por todo el cuerpo los nutrientes y el oxígeno que necesitan sus órganos.",
        "ko": "몸 안에는 혈액 대신 필요한 영양과 산소를 운반하기 위해 작열하는 마그마가 순환되고 있다."
      },
      "abilities_data": [
        {
          "symbol": "infiltrator",
          "textId": 151,
          "names": {
            "en": "Infiltrator",
            "fr": "Infiltration",
            "it": "Intrapasso",
            "de": "Schwebedurch",
            "es": "Allanamiento",
            "ko": "틈새포착"
          },
          "descriptions": {
            "en": "Passes through the opposing Pokémon’s barrier, substitute, and the like and strikes.",
            "fr": "Traverse les barrières et les clones de l’ennemi pour attaquer directement.",
            "it": "Il Pokémon attacca evitando le barriere e il sostituto del nemico.",
            "de": "Überwindet gegnerische Schilde sowie Delegatoren und greift an.",
            "es": "Ataca sorteando la barrera o el sustituto del rival.",
            "ko": "상대의 벽이나 대타출동을 뚫고 공격할 수 있다."
          }
        },
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "friend_guard",
          "textId": 132,
          "names": {
            "en": "Friend Guard",
            "fr": "Garde-Ami",
            "it": "Amicoscudo",
            "de": "Freundeshut",
            "es": "Compiescolta",
            "ko": "프렌드가드"
          },
          "descriptions": {
            "en": "Reduces damage done to allies.",
            "fr": "Diminue les dégâts subis par les alliés.",
            "it": "I danni inflitti agli alleati del Pokémon vengono ridotti.",
            "de": "Kann den Schaden, den Mitstreiter erleiden, verringern.",
            "es": "Reduce el daño que sufren los aliados.",
            "ko": "같은 편의 데미지를 줄일 수 있다."
          }
        }
      ],
