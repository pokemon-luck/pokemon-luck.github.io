      "names": {
        "en": "Stupeel",
        "fr": "Angouille",
        "it": "Snubbull",
        "de": "Snubbull",
        "es": "Snubbull",
        "ko": "블루"
      },
      "descriptions": {
        "en": "Considered too weak, this Pokémon is rarely tamed by trainers, who prefer to cook it.",
        "fr": "Étant considéré trop faible, ce Pokémon est rarement entrainé par les dresseurs, ceux-ci préférant le cuisiner.",
        "it": "Si affeziona facilmente ed è sempre in cerca di attenzioni, nonostante la sua espressione. I giovani lo adorano proprio per questo.",
        "de": "Es wird schnell zahm und wird gerne verwöhnt. Viele lieben den Kontrast zwischen seiner mürrischen Miene und dem putzigen Charakter.",
        "es": "Le gusta que le hagan mimos y coge confianza con facilidad. A la gente le fascina el contraste entre su aspecto fiero y carácter dulce.",
        "ko": "금방 따르고 금방 응석을 부린다. 하는 행동과 생김새의 격차 때문에 젊은 여성은 헤롱헤롱하는 듯하다."
      },
      "abilities_data": [
        {
          "symbol": "swift_swim",
          "textId": 33,
          "names": {
            "en": "Swift Swim",
            "fr": "Glissade",
            "it": "Nuotovelox",
            "de": "Wassertempo",
            "es": "Nado Rápido",
            "ko": "쓱쓱"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Speed stat in rain.",
            "fr": "Augmente la Vitesse du Pokémon s’il pleut.",
            "it": "Se piove, la Velocità aumenta.",
            "de": "Erhöht bei Regen die Initiative.",
            "es": "Sube su Velocidad cuando llueve.",
            "ko": "비가 오는 날씨일 때 스피드가 올라간다."
          }
        },
        {
          "symbol": "anticipation",
          "textId": 107,
          "names": {
            "en": "Anticipation",
            "fr": "Anticipation",
            "it": "Presagio",
            "de": "Vorahnung",
            "es": "Anticipación",
            "ko": "위험예지"
          },
          "descriptions": {
            "en": "The Pokémon can sense an opposing Pokémon’s dangerous moves.",
            "fr": "Le Pokémon devine si l’adversaire connaît une capacité dangereuse pour lui.",
            "it": "Rivela se il nemico ha mosse pericolose.",
            "de": "Kann gefährliche gegnerische Attacken erahnen.",
            "es": "Prevé los movimientos peligrosos del rival.",
            "ko": "상대가 지닌 위험한 기술을 감지할 수 있다."
          }
        },
        {
          "symbol": "gooey",
          "textId": 183,
          "names": {
            "en": "Gooey",
            "fr": "Poisseux",
            "it": "Viscosità",
            "de": "Viskosität",
            "es": "Baba",
            "ko": "미끈미끈"
          },
          "descriptions": {
            "en": "Contact with the Pokémon lowers the attacker’s Speed stat.",
            "fr": "Baisse la Vitesse de l’attaquant lorsque le Pokémon subit une attaque directe.",
            "it": "Se il Pokémon viene colpito da un attacco diretto, la Velocità di chi l’ha colpito diminuisce.",
            "de": "Senkt bei Berührung im Zuge eines Angriffs die Initiative des Angreifers.",
            "es": "Baja la Velocidad del rival cuando este le ataca con un movimiento de contacto.",
            "ko": "공격으로 자신과 접촉한 상대의 스피드를 떨어뜨린다."
          }
        }
      ],
