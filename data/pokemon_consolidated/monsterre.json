      "names": {
        "en": "Monstearth",
        "fr": "Monsterre",
        "it": "Cleffa",
        "de": "Pii",
        "es": "Cleffa",
        "ko": "삐"
      },
      "descriptions": {
        "en": "When it sleeps, Monstearth buries itself in the mud at the bottom of lakes. The fins it leaves protruding are often mistaken for algae.",
        "fr": "Lorsqu'il dort, Monsterre s'enfouit sous la vase au fond des lacs. Les nageoires qu'il laisse dépasser sont souvent confondues avec des algues.",
        "it": "Nelle notti con molte stelle cadenti, i Cleffa si riuniscono per danzare in cerchio. Si dice che assistere alla loro danza sia di buon augurio.",
        "de": "In Nächten mit vielen Sternschnuppen bilden Pii einen Kreis und tanzen. Der Anblick dieses Spektakels soll Glück bringen.",
        "es": "Las noches de lluvia de estrellas, se congregan y bailan en círculo. Se cree que presenciar este espectáculo trae buena suerte.",
        "ko": "별똥별이 많은 밤에 둥글게 무리 지어 춤을 춘다. 그 모습을 보면 조금 좋은 일이 생긴다."
      },
      "abilities_data": [
        {
          "symbol": "mud_dweller",
          "textId": 272,
          "names": {
            "en": "Mud Dweller",
