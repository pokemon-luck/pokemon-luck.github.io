      "names": {
        "en": "Restrap",
        "fr": "Visipeur",
        "it": "Goldeen",
        "de": "Goldini",
        "es": "Goldeen",
        "ko": "콘치"
      },
      "descriptions": {
        "en": "Restrap sometimes climbs on the chest of sleeping individuals before feeding on their dreams.",
        "fr": "Visipeur s'installe parfois sur le torse de personnes endormies, avant de se nourrir de leurs rêves.",
        "it": "È famoso per le sue splendide pinne caudali. Sembra che competa con i suoi simili per stabilire chi ha il corno più spesso e affilato.",
        "de": "Es ist für seine schöne Schwanzflosse bekannt. Miteinander wetteifern sie aber darum, wer das dickste und spitzeste Horn auf dem Kopf hat.",
        "es": "La hermosa aleta caudal es su rasgo distintivo, pero por lo que compiten los propios Goldeen es por lucir el cuerno más grueso y afilado.",
        "ko": "아름다운 꼬리지느러미가 특징이지만 콘치끼리는 뿔의 굵기와 날카로움을 겨루는 듯 하다."
      },
      "abilities_data": [
        {
          "symbol": "shadow_tag",
          "textId": 23,
          "names": {
            "en": "Shadow Tag",
            "fr": "Marque Ombre",
            "it": "Pedinombra",
            "de": "Wegsperre",
            "es": "Sombra Trampa",
            "ko": "그림자밟기"
          },
          "descriptions": {
            "en": "This Pokémon steps on the opposing Pokémon’s shadow to prevent it from escaping.",
            "fr": "Empêche les Pokémon ennemis de quitter le combat.",
            "it": "Il Pokémon calpesta l’ombra del nemico impedendogli la fuga o la sostituzione.",
            "de": "Hindert Gegner an der Flucht beziehungsweise am Auswechseln, indem es ihnen den Weg versperrt.",
            "es": "Impide que el enemigo huya o sea cambiado por otro.",
            "ko": "상대의 그림자를 밟아 도망치거나 교체할 수 없게 한다."
          }
        },
        {
          "symbol": "insomnia",
          "textId": 15,
          "names": {
            "en": "Insomnia",
            "fr": "Insomnia",
            "it": "Insonnia",
            "de": "Insomnia",
            "es": "Insomnio",
            "ko": "불면"
          },
          "descriptions": {
            "en": "The Pokémon is suffering from insomnia and cannot fall asleep.",
            "fr": "Le Pokémon est incapable de dormir.",
            "it": "Il Pokémon soffre d’insonnia e non può addormentarsi.",
            "de": "Verhindert Einschlafen.",
            "es": "Su resistencia al sueño le impide quedarse dormido.",
            "ko": "잠들지 못하는 체질이라 잠듦 상태가 되지 않는다."
          }
        },
        {
          "symbol": "bad_dreams",
          "textId": 123,
          "names": {
            "en": "Bad Dreams",
            "fr": "Mauvais Rêve",
            "it": "Sogniamari",
            "de": "Alptraum",
            "es": "Mal Sueño",
            "ko": "나이트메어"
          },
          "descriptions": {
            "en": "Reduces the HP of sleeping opposing Pokémon.",
            "fr": "Inflige des dégâts aux ennemis endormis.",
            "it": "Infligge danni ai nemici addormentati.",
            "de": "Fügt schlafenden Gegnern Schaden zu.",
            "es": "Inflige daño a cualquier rival que esté dormido.",
            "ko": "잠듦 상태의 상대에게 데미지를 준다."
          }
        }
      ],
