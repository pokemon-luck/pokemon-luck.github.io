      "names": {
        "en": "Drakalibur",
        "fr": "Drakalibur",
        "it": "Horsea",
        "de": "Seeper",
        "es": "Horsea",
        "ko": "쏘드라"
      },
      "descriptions": {
        "en": "This Pokémon pays special attention to the sharpness of the blades on its wings and uses rocks to sharpen them.",
        "fr": "Ce pokémon porte une attention particulière au tranchant des lames de ses ailes, et utilise des rochers pour les aiguiser.",
        "it": "Avvertendo il pericolo, Horsea spruzza istintivamente una nube d’inchiostro nero dalla bocca, tentando poi la fuga. Questo Pokémon nuota agitando abilmente la pinna sulla schiena.",
        "de": "Wenn Seeper Gefahr wittert, versprüht es reflexartig eine tiefschwarze Tinte aus seinem Mund und ergreift die Flucht. Dieses Pokémon kann schwimmen, indem es geschickt mit der Flosse auf seinem Rücken schlägt.",
        "es": "Si Horsea siente peligro, echará por la boca una densa tinta negra inconscientemente e intentará huir. Este Pokémon nada muy bien batiendo la aleta que tiene en el lomo.",
        "ko": "위험을 감지하면 반사적으로 입에서 새까만 먹물을 뿜어내고 도망간다. 등지느러미를 능숙히 움직여 헤엄친다."
      },
      "abilities_data": [
        {
          "symbol": "stalwart",
          "textId": 242,
          "names": {
            "en": "Stalwart",
            "fr": "Nerfs d'Acier",
            "it": "Volontà di Ferro",
            "de": "Stahlrückgrat",
            "es": "Acérrimo",
            "ko": "굳건한신념"
          },
          "descriptions": {
            "en": "Ignores the effects of opposing Pokémon’s Abilities and moves that draw in moves.",
            "fr": "Ignore les effets des capacités ou des talents attirant les capacités.",
            "it": "Permette di ignorare gli effetti di mosse e abilità che attirano altre mosse.",
            "de": "Ignoriert die Effekte von Fähigkeiten und Attacken anderer Pokémon, die Attacken auf sich lenken.",
            "es": "Impide que el rival pueda atraer ataques hacia sí mismo por efecto de su habilidad o sus movimientos.",
            "ko": "상대의 기술을 끌어모으는 특성이나 기술의 영향을 받지 않는다."
          }
        },
        {
          "symbol": "justified",
          "textId": 154,
          "names": {
            "en": "Justified",
            "fr": "Cœur Noble",
            "it": "Giustizia",
            "de": "Redlichkeit",
            "es": "Justiciero",
            "ko": "정의의마음"
          },
          "descriptions": {
            "en": "Being hit by a Dark-type move boosts the Attack stat of the Pokémon, for justice.",
            "fr": "Réveille la noblesse du Pokémon lorsqu’il subit une capacité de type Ténèbres, ce qui augmente son Attaque.",
            "it": "Quando il Pokémon viene colpito da una mossa di tipo Buio, il suo forte senso di giustizia fa sì che l’Attacco aumenti.",
            "de": "Wird es von einer Unlicht-Attacke getroffen, meldet sich sein Sinn für Gerechtigkeit zu Wort und sein Angriff steigt.",
            "es": "Si le alcanza un movimiento de tipo Siniestro, aumenta el Ataque debido a su integridad.",
            "ko": "악타입 공격을 받으면 정의감으로 공격이 올라간다."
          }
        },
        {
          "symbol": "heatproof",
          "textId": 85,
          "names": {
            "en": "Heatproof",
            "fr": "Ignifugé",
            "it": "Antifuoco",
            "de": "Hitzeschutz",
            "es": "Ignífugo",
            "ko": "내열"
          },
          "descriptions": {
            "en": "The heatproof body of the Pokémon halves the damage from Fire-type moves that hit it.",
            "fr": "Diminue de moitié les dégâts infligés au Pokémon par les capacités de type Feu.",
            "it": "Il corpo termoresistente del Pokémon dimezza i danni che subisce dalle mosse di tipo Fuoco.",
            "de": "Sein Hitze abweisender Körper halbiert den durch Feuer-Attacken erlittenen Schaden.",
            "es": "Su cuerpo, resistente al calor, reduce a la mitad el daño recibido por movimientos de tipo Fuego.",
            "ko": "내열인 몸으로 인해 불꽃타입 공격의 데미지를 반감한다."
          }
        }
      ],
