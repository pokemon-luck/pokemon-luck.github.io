      "names": {
        "en": "Blooperl",
        "fr": "Blouperle",
        "it": "Dunsparce",
        "de": "Dummisel",
        "es": "Dunsparce",
        "ko": "노고치"
      },
      "descriptions": {
        "en": "Blooper is easily attracted to shiny artefacts. Its favourite pastime consists in digging up lost treasures dropped on the sea floor.",
        "fr": "Blouperle est facilement attiré par les objets brillants. Son passe-temps favori est de déterrer les trésors tombés au fond de l'océan.",
        "it": "Si sposta scavando nel terreno. I Dunsparce e i Diglett condividono di buon grado i tunnel che scavano.",
        "de": "Sie bewegen sich fort, indem sie sich durch den Boden graben. Da Dummisel sich mit Digda gut verstehen, teilen sie ihre Tunnel miteinander.",
        "es": "Se desplaza excavando túneles subterráneos. Se lleva bien con los Diglett, con quienes suele compartir túneles.",
        "ko": "지면을 파고 다니며 이동한다. 디그다와 서로의 터널을 사이좋게 같이 사용하고 있다."
      },
      "abilities_data": [
        {
          "symbol": "storm_drain",
          "textId": 114,
          "names": {
            "en": "Storm Drain",
            "fr": "Lavabo",
            "it": "Acquascolo",
            "de": "Sturmsog",
            "es": "Colector",
            "ko": "마중물"
          },
          "descriptions": {
            "en": "Draws in all Water-type moves. Instead of being hit by Water-type moves, it boosts its Sp. Atk.",
            "fr": "Le Pokémon détourne sur lui les capacités de type Eau et les neutralise, tout en montant son Attaque Spéciale.",
            "it": "Il Pokémon attira e neutralizza le mosse di tipo Acqua e fa aumentare il proprio Attacco Speciale.",
            "de": "Zieht Wasser-Attacken an. Statt durch diese Schaden zu nehmen, erhöht es den eigenen Spezial-Angriff.",
            "es": "Atrae y neutraliza los movimientos de tipo Agua, que además le suben el Ataque Especial.",
            "ko": "물타입의 기술을 자신에게 끌어모아 데미지는 받지 않고 특수공격이 올라간다."
          }
        },
        {
          "symbol": "hydration",
          "textId": 93,
          "names": {
            "en": "Hydration",
            "fr": "Hydratation",
            "it": "Idratazione",
            "de": "Hydration",
            "es": "Hidratación",
            "ko": "촉촉바디"
          },
          "descriptions": {
            "en": "Heals status conditions if it’s raining.",
            "fr": "Soigne les altérations de statut du Pokémon quand il pleut.",
            "it": "Se piove, il Pokémon guarisce dai problemi di stato.",
            "de": "Heilt bei Regen Statusprobleme.",
            "es": "Cura los problemas de estado si está lloviendo.",
            "ko": "비가 오는 날씨일 때 상태 이상이 회복된다."
          }
        },
        {
          "symbol": "magic_bounce",
          "textId": 156,
          "names": {
            "en": "Magic Bounce",
            "fr": "Miroir Magik",
            "it": "Magispecchio",
            "de": "Magiespiegel",
            "es": "Espejo Mágico",
            "ko": "매직미러"
          },
          "descriptions": {
            "en": "Reflects status moves instead of getting hit by them.",
            "fr": "Annule les effets des capacités de statut subies par le Pokémon et les retourne à l’envoyeur.",
            "it": "Il Pokémon respinge al mittente le mosse di stato senza subirne gli effetti.",
            "de": "Lenkt Status-Attacken auf den Angreifer um, ohne selbst von ihnen getroffen zu werden.",
            "es": "Puede devolver los movimientos de estado lanzados por el rival, sin verse afectado por ellos.",
            "ko": "상대가 쓴 변화 기술을 받지 않고 그대로 되받아칠 수 있다."
          }
        }
      ],
