      "names": {
        "en": "Doggorible",
        "fr": "Clebzombi",
        "it": "Hoppip",
        "de": "Hoppspross",
        "es": "Hoppip",
        "ko": "통통코"
      },
      "descriptions": {
        "en": "Doggorible's bones regularly fall, forcing it to put them back in place.",
        "fr": "Les os des clebzombi tombent régulièrement, les obligeant à les remettre en place.",
        "it": "Hoppip fluttua nell’aria trasportato dal vento. Se percepisce l’avvicinarsi di una forte corrente, Hoppip unisce le foglie con quelle dei suoi simili per non essere spazzato via.",
        "de": "Hoppspross lässt sich vom Wind treiben. Wenn es bemerkt, dass ein Sturm aufkommt, verbindet es seine Blätter mit anderen Hoppspross, damit es nicht davongeweht wird.",
        "es": "Este Pokémon flota en el aire y se deja llevar. Cuando percibe que el viento va a cambiar a fuerte, Hoppip entrelaza sus hojas con otros Hoppip para hacer resistencia y evitar salir volando por la fuerza de la corriente.",
        "ko": "바람을 타고 둥둥 떠다니는 포켓몬이다. 강풍의 기척을 느끼면 동료끼리 잎사귀를 휘감아 날아가지 않도록 준비한다."
      },
      "abilities_data": [
        {
          "symbol": "stakeout",
          "textId": 198,
          "names": {
            "en": "Stakeout",
            "fr": "Filature",
            "it": "Sorveglianza",
            "de": "Beschattung",
            "es": "Vigilante",
            "ko": "잠복"
          },
          "descriptions": {
            "en": "Doubles the damage dealt to the target’s replacement if the target switches out.",
            "fr": "Lorsque le Pokémon attaque une cible qui vient d’entrer sur le terrain en remplacement d’un autre Pokémon, les dégâts infligés sont doublés.",
            "it": "Raddoppia i danni inflitti a un bersaglio che è appena entrato in campo per sostituire un altro Pokémon.",
            "de": "Bewirkt bei Angriffen auf neu eingewechselte Ziele doppelten Schaden.",
            "es": "Si el objetivo de su ataque es sustituido por otro, duplica el daño que infligirá.",
            "ko": "교체로 나온 상대에게 2배 데미지로 공격할 수 있다."
          }
        },
        {
          "symbol": "corrosion",
          "textId": 212,
          "names": {
            "en": "Corrosion",
            "fr": "Corrosion",
            "it": "Corrosione",
            "de": "Korrosion",
            "es": "Corrosión",
            "ko": "부식"
          },
          "descriptions": {
            "en": "The Pokémon can poison the target even if it’s a Steel or Poison type.",
            "fr": "Permet d’empoisonner les Pokémon de type Acier ou Poison.",
            "it": "Il Pokémon è in grado di avvelenare il bersaglio anche se questo è di tipo Acciaio o Veleno.",
            "de": "Kann selbst Pokémon vom Typ Stahl oder Gift vergiften.",
            "es": "Puede envenenar incluso a rivales de tipo Acero o Veneno.",
            "ko": "강철타입이나 독타입도 독 상태로 만들 수 있다."
          }
        },
        {
          "symbol": "venomous_aura",
          "textId": 279,
          "names": {
            "en": "Venomous Aura",
            "fr": "Aura Venimeuse",
            "it": "Aura Venimeuse",
            "de": "Aura Venimeuse",
            "es": "Aura Venimeuse",
            "ko": "Aura Venimeuse"
          },
          "descriptions": {
            "en": "All contact moves have a 25% chance to badly poison the target.",
