      "names": {
        "en": "Hermesoar",
        "fr": "Hermésange",
        "it": "Phanpy",
        "de": "Phanpy",
        "es": "Phanpy",
        "ko": "코코리"
      },
      "descriptions": {
        "en": "Known for their speed and sociability, Hermesoar are often raised to deliver messages or packages.",
        "fr": "Reconnus pour leur grande vitesse et leur sociabilité, les Hermésange sont souvent élevés à transmettre des messages ou livrer des colis.",
        "it": "Phanpy usa la proboscide per farsi la doccia. Questi Pokémon sono soliti raggrupparsi per spruzzarsi d’acqua a vicenda. Poi, è frequente vederli mentre si asciugano il corpo fradicio a riva.",
        "de": "Phanpy kann sich mit seiner Nase selbst duschen. Wenn andere dabei sind, begießen sie sich gegenseitig mit Wasser. Danach trocknet es seinen durchnässten Körper am Ufer.",
        "es": "Phanpy se vale de la trompa para ducharse. Cuando varios se agrupan, se dedican a echarse agua unos a otros. Es muy fácil ver a estos Pokémon secándose cerca del agua.",
        "ko": "긴 코를 써서 물을 끼얹는다. 동료가 모여들면 서로 물을 끼얹는다. 흠뻑 젖은 몸을 물가에서 말린다."
      },
      "abilities_data": [
        {
          "symbol": "gale_wings",
          "textId": 177,
          "names": {
            "en": "Gale Wings",
            "fr": "Ailes Bourrasque",
            "it": "Aliraffica",
            "de": "Orkanschwingen",
            "es": "Alas Vendaval",
            "ko": "질풍날개"
          },
          "descriptions": {
            "en": "Gives priority to Flying-type moves when the Pokémon’s HP is full.",
            "fr": "Quand les PV du Pokémon sont au maximum, ses capacités de type Vol sont prioritaires.",
            "it": "Se il Pokémon ha tutti i PS, le sue mosse di tipo Volante acquistano priorità alta.",
            "de": "Kann bei vollen KP einen Erstschlag mit Flug-Attacken ermöglichen.",
            "es": "Da prioridad a los movimientos de tipo Volador si sus PS están al máximo.",
            "ko": "HP가 꽉 찼을 때 비행타입의 기술을 먼저 쓸 수 있다."
          }
        },
        {
          "symbol": "serene_grace",
