      "names": {
        "en": "Incendevil",
        "fr": "Incendevil",
        "it": "Tyranitar",
        "de": "Despotar",
        "es": "Tyranitar",
        "ko": "마기라스"
      },
      "descriptions": {
        "en": "It wanders through the mountains seeking opponents to fight. If it finds an opponent that’s not worthy, Tyranitar ignores it and wanders on.",
        "fr": "",
        "it": "Vaga tra i monti alla ricerca di avversari con cui lottare. Se però non li ritiene alla sua altezza, li ignora e se ne va.",
        "de": "Es durchstreift die Berge auf der Suche nach Gegnern. Begegnet es einem, der ihm nicht ebenbürtig ist, ignoriert es ihn und zieht weiter.",
        "es": "Recorre las montañas en busca de rivales para combatir. Si juzga que no están a su altura, los ignora y pasa de largo.",
        "ko": "싸울 상대를 찾아 산을 떠돈다. 만나도 격이 떨어지는 상대라고 무시하고 떠나간다."
      },
      "abilities_data": [
        {
          "symbol": "blaze",
          "textId": 66,
          "names": {
            "en": "Blaze",
            "fr": "Brasier",
            "it": "Aiutofuoco",
            "de": "Großbrand",
            "es": "Mar Llamas",
            "ko": "맹화"
          },
          "descriptions": {
            "en": "Powers up Fire-type moves when the Pokémon’s HP is low.",
            "fr": "Augmente la puissance des capacités de type Feu du Pokémon quand il a perdu une certaine quantité de PV.",
            "it": "Quando il Pokémon ha pochi PS, la potenza delle sue mosse di tipo Fuoco aumenta.",
            "de": "Erhöht die Stärke von Feuer-Attacken, wenn die KP auf einen gewissen Wert fallen.",
            "es": "Potencia sus movimientos de tipo Fuego cuando le quedan pocos PS.",
            "ko": "HP가 줄었을 때 불꽃타입 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "reckless",
          "textId": 120,
          "names": {
            "en": "Reckless",
            "fr": "Téméraire",
            "it": "Temerarietà",
            "de": "Achtlos",
            "es": "Audaz",
            "ko": "이판사판"
          },
          "descriptions": {
            "en": "Powers up moves that have recoil damage.",
            "fr": "Augmente la puissance des capacités occasionnant un contrecoup.",
            "it": "Potenzia le mosse che causano contraccolpo.",
            "de": "Erhöht die Stärke von Attacken mit Rückstoßschaden.",
            "es": "Potencia los movimientos que también dañan al usuario.",
            "ko": "반동 데미지를 받는 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "steam_powered",
          "textId": 309,
          "names": {
            "en": "Steam Powered",
            "fr": "Puissance Vapeur",
            "it": "Puissance Vapeur",
            "de": "Puissance Vapeur",
            "es": "Puissance Vapeur",
            "ko": "Puissance Vapeur"
          },
          "descriptions": {
            "en": "The Pokémon's Attack rises if hit by a Water-type move, which then deals no damage.",
            "fr": "L'Attaque du Pokémon augmente s'il est touché par une capacité de type Eau, qui n'a alors aucun effet.",
            "it": "",
            "de": "",
            "es": "",
            "ko": ""
          }
        }
