      "names": {
        "en": "Cryplague",
        "fr": "Diablafard",
        "it": "Dragonite",
        "de": "Dragoran",
        "es": "Dragonite",
        "ko": "망나뇽"
      },
      "descriptions": {
        "en": "Cryplague carries numerous diseases. Other Pokémon should pay attention not to injure it, for its blood is poisoned.",
        "fr": "Diablafard est porteur de nombreuses maladies. Gare au pokémon qui le blesserait, car son sang est empoisonné.",
        "it": "Sorvola come se niente fosse anche i mari più agitati. Un capitano, vedendolo all’opera, l’ha soprannominato “l’incarnazione del mare”.",
        "de": "Es fliegt ohne Bedenken selbst über tosende Meere. Ein Schiffskapitän nannte es nach diesem Anblick die „Inkarnation des Meeres“.",
        "es": "Sobrevuela los mares desafiando las más fieras tempestades, lo que le valió que cierto capitán de un buque lo llamara el Avatar de la Mar.",
        "ko": "성난 바다도 아랑곳하지 않고 날아간다. 그 모습을 본 선장은 바다의 화신이라고 불렀다."
      },
      "abilities_data": [
        {
          "symbol": "poison_touch",
          "textId": 143,
          "names": {
            "en": "Poison Touch",
            "fr": "Toxitouche",
            "it": "Velentocco",
            "de": "Giftgriff",
            "es": "Toque Tóxico",
            "ko": "독수"
          },
          "descriptions": {
            "en": "May poison a target when the Pokémon makes contact.",
            "fr": "Peut empoisonner l’ennemi par simple contact.",
            "it": "Il Pokémon può avvelenare il nemico al solo contatto.",
            "de": "Kann das Ziel durch bloßes Berühren vergiften.",
            "es": "Puede envenenar al objetivo con solo tocarlo.",
            "ko": "접촉하기만 해도 상대를 독 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "corrosion",
          "textId": 212,
          "names": {
            "en": "Corrosion",
            "fr": "Corrosion",
            "it": "Corrosione",
            "de": "Korrosion",
            "es": "Corrosión",
            "ko": "부식"
          },
          "descriptions": {
            "en": "The Pokémon can poison the target even if it’s a Steel or Poison type.",
            "fr": "Permet d’empoisonner les Pokémon de type Acier ou Poison.",
            "it": "Il Pokémon è in grado di avvelenare il bersaglio anche se questo è di tipo Acciaio o Veleno.",
            "de": "Kann selbst Pokémon vom Typ Stahl oder Gift vergiften.",
            "es": "Puede envenenar incluso a rivales de tipo Acero o Veneno.",
            "ko": "강철타입이나 독타입도 독 상태로 만들 수 있다."
          }
        },
        {
          "symbol": "merciless",
          "textId": 196,
          "names": {
            "en": "Merciless",
            "fr": "Cruauté",
            "it": "Spietatezza",
            "de": "Quälerei",
            "es": "Ensañamiento",
            "ko": "무도한행동"
          },
          "descriptions": {
            "en": "The Pokémon’s attacks become critical hits if the target is poisoned.",
            "fr": "Lorsque le Pokémon attaque un adversaire empoisonné, le coup sera forcément critique.",
            "it": "Gli attacchi sferrati su un bersaglio avvelenato producono sempre brutti colpi.",
            "de": "Sorgt bei Angriffen auf vergiftete Ziele für Volltreffergarantie.",
            "es": "Hace que sus movimientos asesten siempre un golpe crítico si el rival está envenenado.",
            "ko": "독 상태의 상대를 공격하면 반드시 급소에 맞는다."
          }
        }
      ],
