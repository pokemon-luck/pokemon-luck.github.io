      "names": {
        "en": "Pestallion",
        "fr": "Galadie",
        "it": "Venonat",
        "de": "Bluzuk",
        "es": "Venonat",
        "ko": "콘팡"
      },
      "descriptions": {
        "en": "Pestallion, suffering from all the diseases in the world, requires special precautions when approached.",
        "fr": "Galadie souffrant de toutes les maladies du monde, l'approcher nécessite des précautions particulières.",
        "it": "Si dice che per proteggersi Venonat abbia sviluppato una pelliccia sottile e irsuta che ricopre il suo corpo. Nemmeno la preda più piccola può sfuggire ai suoi occhi enormi.",
        "de": "Bluzuk hat einen Pelz aus dünnen Borsten entwickelt, der dem Schutz seines Körpers dient. Es hat große Augen, denen auch winzig kleine Beute nicht entgeht.",
        "es": "Dicen que durante su evolución Venonat desarrolló una fina capa de espeso pelo alrededor de todo el cuerpo para protegerse. Tiene unos ojos tan grandes que no hay presa que le pase desapercibida.",
        "ko": "몸을 지키기 위해 가늘고 딱딱한 털이 전신을 둘러싸게 됐다고 전해진다. 작은 먹잇감도 놓치지 않는 눈을 가졌다."
      },
      "abilities_data": [
        {
          "symbol": "stench",
          "textId": 1,
          "names": {
            "en": "Stench",
            "fr": "Puanteur",
            "it": "Tanfo",
            "de": "Duftnote",
            "es": "Hedor",
            "ko": "악취"
          },
          "descriptions": {
            "en": "By releasing stench when attacking, this Pokémon may cause the target to flinch.",
            "fr": "Le Pokémon émet une odeur si nauséabonde qu’il peut effrayer sa cible.",
            "it": "A volte il cattivo odore emesso dal Pokémon fa tentennare i nemici quando attacca.",
            "de": "Lässt das Ziel beim Angriff eventuell durch Gestank zurückschrecken.",
            "es": "Puede amedrentar al rival al atacarlo debido al mal olor que emana.",
            "ko": "악취를 풍겨서 공격했을 때 상대가 풀죽을 때가 있다."
          }
        },
        {
          "symbol": "liquid_ooze",
          "textId": 64,
          "names": {
            "en": "Liquid Ooze",
            "fr": "Suintement",
            "it": "Melma",
            "de": "Kloakensoße",
            "es": "Lodo Líquido",
            "ko": "해감액"
          },
          "descriptions": {
            "en": "The oozed liquid has a strong stench, which damages attackers using any draining move.",
            "fr": "Le Pokémon suinte un liquide toxique nauséabond qui blesse tous ceux qui tentent de voler ses PV.",
            "it": "Il Pokémon secerne delle sostanze tossiche. Se un nemico manda a segno una mossa che assorbe i PS, subisce dei danni.",
            "de": "Angreifer, die durch Saug-Attacken Kloakensoße in sich aufgenommen haben, nehmen durch deren widerwärtigen Gestank Schaden.",
            "es": "Exuda una sustancia tóxica de intenso hedor que hiere a quienes intentan drenarle PS.",
            "ko": "해감액을 흡수한 상대는 강렬한 악취로 데미지를 받아 HP가 줄어든다."
          }
        },
        {
          "symbol": "merciless",
          "textId": 196,
          "names": {
            "en": "Merciless",
            "fr": "Cruauté",
            "it": "Spietatezza",
            "de": "Quälerei",
            "es": "Ensañamiento",
            "ko": "무도한행동"
          },
          "descriptions": {
            "en": "The Pokémon’s attacks become critical hits if the target is poisoned.",
            "fr": "Lorsque le Pokémon attaque un adversaire empoisonné, le coup sera forcément critique.",
            "it": "Gli attacchi sferrati su un bersaglio avvelenato producono sempre brutti colpi.",
            "de": "Sorgt bei Angriffen auf vergiftete Ziele für Volltreffergarantie.",
            "es": "Hace que sus movimientos asesten siempre un golpe crítico si el rival está envenenado.",
            "ko": "독 상태의 상대를 공격하면 반드시 급소에 맞는다."
          }
        }
      ],
