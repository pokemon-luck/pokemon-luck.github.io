      "names": {
        "en": "Tilaqua",
        "fr": "Tilasson",
        "it": "Quagsire",
        "de": "Morlord",
        "es": "Quagsire",
        "ko": "누오"
      },
      "descriptions": {
        "en": "It keeps its baby in its mouth to protect it from predators. The baby's tail can serve as a tongue for Tilasson.",
        "fr": "Il garde son bébé dans sa bouche pour le protéger des prédateurs. La queue de ce dernier peut servir de langue à Tilasson.",
        "it": "In acqua Quagsire attende la preda tenendo sempre la bocca spalancata per catturare qualche ignaro malcapitato. Poiché questo Pokémon non fa molto moto, non è mai troppo affamato.",
        "de": "Morlord jagt seine Nahrung, indem es im Wasser sein Maul weit aufmacht und auf unvorsichtige Beute wartet. Da sich dieses Pokémon nicht bewegt, wird es auch nicht besonders hungrig.",
        "es": "Quagsire caza dejando las fauces abiertas en el agua y esperando a que su presa entre sin darse cuenta. Como se queda quieto, el Pokémon no pasa mucha hambre.",
        "ko": "물속에서 입을 열고 우연히 먹이가 뛰어들기를 그저 기다리고 있다. 움직이지 않기에 별로 배가 안 고프다."
      },
      "abilities_data": [
        {
          "symbol": "levitate",
          "textId": 26,
          "names": {
            "en": "Levitate",
            "fr": "Lévitation",
            "it": "Levitazione",
            "de": "Schwebe",
            "es": "Levitación",
            "ko": "부유"
          },
          "descriptions": {
            "en": "By floating in the air, the Pokémon receives full immunity to all Ground-type moves.",
            "fr": "Le Pokémon flotte, ce qui l’immunise contre les capacités de type Sol.",
            "it": "La capacità di levitare conferisce al Pokémon immunità agli attacchi di tipo Terra.",
            "de": "Verleiht volle Immunität gegen alle Boden-Attacken durch Schwebezustand.",
            "es": "Su capacidad de flotar sobre el suelo le proporciona inmunidad frente a los movimientos de tipo Tierra.",
            "ko": "땅에서 뜨는 것으로 땅타입의 기술을 받지 않는다."
          }
        },
        {
          "symbol": "hydration",
