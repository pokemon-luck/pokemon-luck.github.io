      "names": {
        "en": "Cryptackle",
        "fr": "Diablinja",
        "it": "Zapdos",
        "de": "Zapdos",
        "es": "Zapdos",
        "ko": "썬더"
      },
      "descriptions": {
        "en": "Proud of its strength, Cryptackle does not hesitate to attack higher-level Pokémon even when outnumbered.",
        "fr": "Fier de sa force, Diablinja n'hésite pas à s'attaquer à des pokémon de plus haut niveau ou en surnombre.",
        "it": "Zapdos è un Pokémon uccello leggendario, perfettamente in grado di gestire l’elettricità. Acquista forza ed energia se colpito da qualche fulmine.",
        "de": "Zapdos ist ein Legendäres Vogel-Pokémon, das die Fähigkeit besitzt, Elektrizität zu manipulieren. Es lebt in Gewitterwolken. Dieses Pokémon nimmt Energie auf, wenn es vom Blitz getroffen wird.",
        "es": "Zapdos es un Pokémon pájaro legendario que tiene la habilidad de controlar la electricidad. Suele vivir en nubarrones. Este Pokémon gana mucha fuerza si le alcanzan los rayos.",
        "ko": "전기를 조종하는 전설의 새포켓몬이다. 평상시는 번개 구름 속에서 지낸다. 번개를 맞으면 힘이 솟아난다."
      },
      "abilities_data": [
        {
          "symbol": "iron_fist",
          "textId": 89,
          "names": {
            "en": "Iron Fist",
            "fr": "Poing de Fer",
            "it": "Ferropugno",
            "de": "Eisenfaust",
            "es": "Puño Férreo",
            "ko": "철주먹"
          },
          "descriptions": {
            "en": "Powers up punching moves.",
            "fr": "Augmente la puissance des capacités coups de poing.",
            "it": "Potenzia le mosse che utilizzano pugni.",
            "de": "Erhöht die Stärke von Hieb-, Punch-, Faust- und Schlag-Attacken.",
            "es": "Aumenta la potencia de los puñetazos.",
            "ko": "펀치를 사용하는 기술의 위력이 올라간다."
          }
        },
        {
          "symbol": "sheer_force",
          "textId": 125,
          "names": {
            "en": "Sheer Force",
            "fr": "Sans Limite",
            "it": "Forzabruta",
            "de": "Rohe Gewalt",
            "es": "Potencia Bruta",
            "ko": "우격다짐"
          },
          "descriptions": {
            "en": "Removes additional effects to increase the power of moves when attacking.",
            "fr": "Les capacités ayant un effet additionnel le perdent, mais leur puissance augmente.",
            "it": "Aumenta la potenza delle mosse, ma ne annulla gli effetti aggiuntivi.",
            "de": "Erhöht die Stärke von Attacken, aber hebt dafür ihre Zusatzeffekte auf.",
            "es": "Sube la potencia de sus movimientos en detrimento de los efectos secundarios, que se ven anulados.",
            "ko": "기술의 추가 효과가 없어지지만 그만큼 높은 위력으로 기술을 사용할 수 있다."
          }
        },
        {
          "symbol": "defiant",
          "textId": 128,
          "names": {
            "en": "Defiant",
            "fr": "Acharné",
            "it": "Agonismo",
            "de": "Siegeswille",
            "es": "Competitivo",
            "ko": "오기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Attack stat sharply when its stats are lowered.",
            "fr": "Augmente beaucoup l’Attaque du Pokémon quand ses stats baissent.",
            "it": "L’Attacco aumenta di molto quando le statistiche diminuiscono a causa di un nemico.",
            "de": "Erhöht den Angriff stark, wenn ein Statuswert gesenkt wurde.",
            "es": "Sube mucho su Ataque cuando el rival le baja las características.",
            "ko": "능력이 떨어지면 공격이 크게 올라간다."
          }
        }
      ],
