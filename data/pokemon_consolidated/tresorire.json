      "names": {
        "en": "Chestrap",
        "fr": "Trésorire",
        "it": "Dewgong",
        "de": "Jugong",
        "es": "Dewgong",
        "ko": "쥬레곤"
      },
      "descriptions": {
        "en": "In the past, Chestrap fed on reckless adventurers who mistook it for a treasure chest. Nowadays, however, this strategy no longer seems to bear fruit, forcing this Pokémon to consume berries and garbage to survive.",
        "fr": "Dans le temps, Trésorire se nourrissait d'aventuriers imprudents le confondant avec un coffre. De nos jours, cependant, cette stratégie ne semble plus porter ses fruits, forçant ce pokémon à consommer des baies et des ordures pour survivre.",
        "it": "Nuota nel mare alla velocità di 8 nodi alla ricerca dei Pokémon di cui si nutre. È particolarmente ghiotto di Wishiwashi.",
        "de": "Es schwimmt mit bis zu acht Knoten im Meer und sucht nach Beute. Für Lusardin hat es eine besondere Vorliebe.",
        "es": "Surca los mares a velocidades de 8 nudos en busca de Pokémon que le sirvan de sustento. Siente predilección especial por los Wishiwashi.",
        "ko": "8노트의 속도로 바다를 헤엄쳐 먹이가 되는 포켓몬을 찾는다. 특히 약어리를 매우 좋아한다."
      },
      "abilities_data": [
        {
          "symbol": "cursed_body",
          "textId": 130,
          "names": {
            "en": "Cursed Body",
            "fr": "Corps Maudit",
            "it": "Corpofunesto",
            "de": "Tastfluch",
            "es": "Cuerpo Maldito",
            "ko": "저주받은바디"
          },
          "descriptions": {
            "en": "May disable a move used on the Pokémon.",
            "fr": "Quand le Pokémon est touché par une capacité, il inflige parfois Entrave sur celle-ci.",
            "it": "Può bloccare la mossa subita dal Pokémon.",
            "de": "Blockiert eventuell die Attacke, mit welcher der Angreifer es getroffen hat.",
            "es": "Puede anular el movimiento usado en su contra.",
            "ko": "공격을 받으면 상대의 기술을 사슬묶기 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "bulletproof",
          "textId": 171,
          "names": {
            "en": "Bulletproof",
            "fr": "Pare-Balles",
            "it": "Antiproiettile",
            "de": "Kugelsicher",
            "es": "Antibalas",
            "ko": "방탄"
          },
          "descriptions": {
            "en": "Protects the Pokémon from some ball and bomb moves.",
            "fr": "Protège de certaines capacités lançant des projectiles comme des bombes et des balles.",
            "it": "Protegge da alcune mosse a base di proiettili e bombe.",
            "de": "Kann das Pokémon vor geworfenen kugelförmigen Objekten, wie zum Beispiel Bomben, schützen.",
            "es": "No le afectan las bombas ni algunos proyectiles.",
            "ko": "상대 구슬이나 폭탄 등 기술을 막을 수 있다."
          }
        },
        {
          "symbol": "weak_armor",
          "textId": 133,
          "names": {
            "en": "Weak Armor",
            "fr": "Armurouillée",
            "it": "Sottilguscio",
            "de": "Bruchrüstung",
            "es": "Armadura Frágil",
            "ko": "깨어진갑옷"
          },
          "descriptions": {
            "en": "Physical attacks to the Pokémon lower its Defense stat but sharply raise its Speed stat.",
            "fr": "Quand le Pokémon est touché par une capacité physique, sa Défense baisse mais sa Vitesse augmente beaucoup.",
            "it": "Se il Pokémon subisce danni da mosse fisiche, la Difesa diminuisce e la Velocità aumenta di molto.",
            "de": "Senkt bei erlittenem Treffer durch eine physische Attacke die Verteidigung des Pokémon, aber erhöht dafür seine Initiative stark.",
            "es": "Al recibir daño de un ataque físico, le baja la Defensa, pero le sube mucho la Velocidad.",
            "ko": "물리 기술로 데미지를 받으면 방어가 떨어지고 스피드가 크게 올라간다."
          }
        }
      ],
