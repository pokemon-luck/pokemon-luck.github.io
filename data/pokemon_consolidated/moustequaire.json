      "names": {
        "en": "Mosquiteer",
        "fr": "Moustequaire",
        "it": "Sandshrew",
        "de": "Sandan",
        "es": "Sandshrew",
        "ko": "모래두지"
      },
      "descriptions": {
        "en": "Anyone who harms Mosquiteer's favorite fruit trees will have to face his wrath.",
        "fr": "Quiconque s'en prend aux arbres fruitiers préférés de Moustequaire devra faire face à sa rage. ",
        "it": "Vive in zone con scarse precipitazioni. Quando è minacciato da un pericolo, si raggomitola per proteggere il ventre molle.",
        "de": "Es lebt in trockenen Gebieten mit wenig Regen. Bei Gefahr rollt es sich zu einem Ball zusammen und schützt so seine weiche Bauchgegend.",
        "es": "Prefiere hábitats secos. Cuando intuye peligro, se enrolla hasta hacerse una bola para proteger las partes blandas de su cuerpo.",
        "ko": "비가 적은 토지에 살고 있다. 위험한 상황이 되면 몸을 웅크려 부드러운 배를 지킨다."
      },
      "abilities_data": [
        {
          "symbol": "hustle",
          "textId": 55,
          "names": {
            "en": "Hustle",
            "fr": "Agitation",
            "it": "Tuttafretta",
            "de": "Übereifer",
            "es": "Entusiasmo",
            "ko": "의욕"
          },
          "descriptions": {
            "en": "Boosts the Attack stat, but lowers accuracy.",
            "fr": "Améliore l’Attaque du Pokémon, mais diminue la Précision.",
            "it": "L’Attacco aumenta, ma la precisione diminuisce.",
            "de": "Erhöht den Angriffs-Wert, aber senkt die Genauigkeit.",
            "es": "Aumenta su Ataque, pero reduce su Precisión.",
            "ko": "자신의 공격이 높아지지만 명중률이 떨어진다."
          }
        },
        {
          "symbol": "guts",
          "textId": 62,
          "names": {
            "en": "Guts",
            "fr": "Cran",
            "it": "Dentistretti",
            "de": "Adrenalin",
            "es": "Agallas",
            "ko": "근성"
          },
          "descriptions": {
            "en": "It’s so gutsy that having a status condition boosts the Pokémon’s Attack stat.",
            "fr": "Augmente l’Attaque du Pokémon s’il est affecté par une altération de statut.",
            "it": "Se il Pokémon è affetto da un problema di stato, tira fuori la grinta e aumenta il proprio Attacco.",
            "de": "Bei Statusproblemen setzt es Adrenalin frei und erhöht so seinen Angriffs-Wert.",
            "es": "Si sufre un problema de estado, se viene arriba y aumenta su Ataque.",
            "ko": "상태 이상이 되면 근성을 보여서 공격이 올라간다."
          }
        },
        {
          "symbol": "defiant",
          "textId": 128,
          "names": {
            "en": "Defiant",
            "fr": "Acharné",
            "it": "Agonismo",
            "de": "Siegeswille",
            "es": "Competitivo",
            "ko": "오기"
          },
          "descriptions": {
            "en": "Boosts the Pokémon’s Attack stat sharply when its stats are lowered.",
            "fr": "Augmente beaucoup l’Attaque du Pokémon quand ses stats baissent.",
            "it": "L’Attacco aumenta di molto quando le statistiche diminuiscono a causa di un nemico.",
            "de": "Erhöht den Angriff stark, wenn ein Statuswert gesenkt wurde.",
            "es": "Sube mucho su Ataque cuando el rival le baja las características.",
            "ko": "능력이 떨어지면 공격이 크게 올라간다."
          }
        }
      ],
