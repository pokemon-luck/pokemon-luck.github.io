      "names": {
        "en": "Doxin",
        "fr": "Doxine",
        "it": "Haunter",
        "de": "Alpollo",
        "es": "Haunter",
        "ko": "고우스트"
      },
      "descriptions": {
        "en": "Doxin's sense of smell allows it to detect even the smallest trace of poison in the food presented to it.",
        "fr": "L'odorat de Doxine lui permet de déceler la présence, même minime, de poison dans la nourriture qui lui est présentée.",
        "it": "Nelle notti senza luna è meglio rimanere in casa: Haunter vaga in cerca di vittime su cui scagliare maledizioni!",
        "de": "In mondlosen Nächten sucht es nach Opfern, die es mit einem Fluch belegen kann. Zu Hause ist man daher am sichersten aufgehoben.",
        "es": "Se aconseja no salir a pasear en las noches de luna nueva, cuando los Haunter acechan en busca de su próxima víctima.",
        "ko": "달이 뜨지 않은 밤. 고우스트는 저주할 상대를 찾기 때문에 나다니지 않는 것이 좋다."
      },
      "abilities_data": [
        {
          "symbol": "poison_touch",
          "textId": 143,
          "names": {
            "en": "Poison Touch",
            "fr": "Toxitouche",
            "it": "Velentocco",
            "de": "Giftgriff",
            "es": "Toque Tóxico",
            "ko": "독수"
          },
          "descriptions": {
            "en": "May poison a target when the Pokémon makes contact.",
            "fr": "Peut empoisonner l’ennemi par simple contact.",
            "it": "Il Pokémon può avvelenare il nemico al solo contatto.",
            "de": "Kann das Ziel durch bloßes Berühren vergiften.",
            "es": "Puede envenenar al objetivo con solo tocarlo.",
            "ko": "접촉하기만 해도 상대를 독 상태로 만들 때가 있다."
          }
        },
        {
          "symbol": "triage",
          "textId": 205,
          "names": {
            "en": "Triage",
            "fr": "Prioguérison",
            "it": "Primacura",
            "de": "Heilwandel",
            "es": "Primer Auxilio",
            "ko": "힐링시프트"
          },
          "descriptions": {
            "en": "Gives priority to a healing move.",
            "fr": "Toutes les capacités qui soignent le Pokémon directement deviennent prioritaires.",
            "it": "Le mosse che ripristinano direttamente i PS del Pokémon acquistano priorità alta.",
            "de": "Ermöglicht einen Erstschlag mit Attacken, welche die KP des Anwenders direkt regenerieren.",
            "es": "Da prioridad a los movimientos que restauran PS.",
            "ko": "회복 기술을 먼저 사용할 수 있다."
          }
        },
        {
          "symbol": "corrosion",
          "textId": 212,
          "names": {
            "en": "Corrosion",
            "fr": "Corrosion",
            "it": "Corrosione",
            "de": "Korrosion",
            "es": "Corrosión",
            "ko": "부식"
          },
          "descriptions": {
            "en": "The Pokémon can poison the target even if it’s a Steel or Poison type.",
            "fr": "Permet d’empoisonner les Pokémon de type Acier ou Poison.",
            "it": "Il Pokémon è in grado di avvelenare il bersaglio anche se questo è di tipo Acciaio o Veleno.",
            "de": "Kann selbst Pokémon vom Typ Stahl oder Gift vergiften.",
            "es": "Puede envenenar incluso a rivales de tipo Acero o Veneno.",
            "ko": "강철타입이나 독타입도 독 상태로 만들 수 있다."
          }
        }
      ],
